{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GSoMhJ3dvcgJhXfYe9m61v","type":"tool_result","content":"1\t<?php\n2\t# MantisBT - A PHP based bugtracking system\n3\t\n4\t# MantisBT is free software: you can redistribute it and/or modify\n5\t# it under the terms of the GNU General Public License as published by\n6\t# the Free Software Foundation, either version 2 of the License, or\n7\t# (at your option) any later version.\n8\t#\n9\t# MantisBT is distributed in the hope that it will be useful,\n10\t# but WITHOUT ANY WARRANTY; without even the implied warranty of\n11\t# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n12\t# GNU General Public License for more details.\n13\t#\n14\t# You should have received a copy of the GNU General Public License\n15\t# along with MantisBT.  If not, see <http://www.gnu.org/licenses/>.\n16\t\n17\t/**\n18\t * Configuration Parser class.\n19\t * @copyright Copyright 2016 MantisBT Team - mantisbt-dev@lists.sourceforge.net\n20\t * @link http://www.mantisbt.org\n21\t * @package MantisBT\n22\t * @subpackage classes\n23\t */\n24\t\n25\t\n26\t/**\n27\t * Configuration Parser class\n28\t *\n29\t * Simple PHP code parser for scalar and array types\n30\t *\n31\t * @package MantisBT\n32\t * @subpackage classes\n33\t *\n34\t * @uses Tokenizer\n35\t */\n36\tclass ConfigParser\n37\t{\n38\t\t/**\n39\t\t * Define how extra tokens should be handled by parse() method\n40\t\t */\n41\t\tconst EXTRA_TOKENS_IGNORE = 0;\n42\t\tconst EXTRA_TOKENS_ERROR = 1;\n43\t\n44\t\t/**\n45\t\t * @var Tokenizer $tokens\n46\t\t */\n47\t\tprotected $tokens;\n48\t\n49\t\t/**\n50\t\t * Parser constructor.\n51\t\t * @param string $p_code PHP code to parse\n52\t\t */\n53\t\tpublic function __construct( $p_code ) {\n54\t\t\t$this->tokens = new Tokenizer( $p_code );\n55\t\t}\n56\t\n57\t\t/**\n58\t\t * Parse the code for a variable assignment.\n59\t\t * Handles scalar types, and various array types (simple, associative,\n60\t\t * multi-dimensional)\n61\t\t * @param integer $p_extra_tokens Define how extra tokens should be handled\n62\t\t *                             - EXTRA_TOKENS_IGNORE silently ignore any\n63\t\t *                               extra code given after the first token\n64\t\t *                             - EXTRA_TOKENS_ERROR (default) throws an\n65\t\t *                               exception if extra code is found\n66\t\t * @return mixed variable\n67\t\t * @throws Exception when there are unexpected or extra tokens\n68\t\t */\n69\t\tpublic function parse( $p_extra_tokens = self::EXTRA_TOKENS_ERROR ) {\n70\t\t\tswitch( $this->tokens->type() ) {\n71\t\t\t\tcase T_ARRAY:\n72\t\t\t\t\t$t_result = $this->process_array();\n73\t\t\t\t\tbreak;\n74\t\n75\t\t\t\tcase T_CONSTANT_ENCAPSED_STRING:\n76\t\t\t\tcase T_STRING:\n77\t\t\t\tcase T_LNUMBER:\n78\t\t\t\tcase T_DNUMBER:\n79\t\t\t\tcase '-':\n80\t\t\t\tcase '+':\n81\t\t\t\t\t$t_result = $this->process_value();\n82\t\t\t\t\tbreak;\n83\t\n84\t\t\t\tdefault:\n85\t\t\t\t\tthrow new Exception( 'Unexpected token \"' . $this->tokens->value() . '\"' );\n86\t\t\t}\n87\t\n88\t\t\t# Make sure we have processed all tokens\n89\t\t\tif( $p_extra_tokens == self::EXTRA_TOKENS_ERROR && !$this->tokens->is_empty() ) {\n90\t\t\t\tthrow new Exception( 'Extra tokens found \"' . $this->tokens->get_string() .'\":' );\n91\t\t\t}\n92\t\n93\t\t\treturn $t_result;\n94\t\t}\n95\t\n96\t\t/**\n97\t\t * Check if the passed string is a constant and returns its value if yes,\n98\t\t * or the string itself if not\n99\t\t * @param string $p_name String to check.\n100\t\t * @return mixed|string value of constant $p_name, or $p_name itself\n101\t\t */\n102\t\tpublic static function constant_replace( $p_name ) {\n103\t\t\t$t_name = trim( $p_name );\n104\t\t\tif( is_string( $t_name ) && defined( $t_name ) ) {\n105\t\t\t\t# we have a constant\n106\t\t\t\treturn constant( $t_name );\n107\t\t\t}\n108\t\t\treturn $t_name;\n109\t\t}\n110\t\n111\t\t/**\n112\t\t * Recursively process array declarations.\n113\t\t * @return array\n114\t\t * @throws Exception when there's an invalid token\n115\t\t */\n116\t\tprotected function process_array() {\n117\t\t\t$t_array = array();\n118\t\t\t$t_count = 0;\n119\t\n120\t\t\t$this->tokens->ensure_matches( T_ARRAY );\n121\t\t\t$this->tokens->ensure_matches( '(' );\n122\t\n123\t\t\t# Loop until we reach the end of the array\n124\t\t\twhile( !$this->tokens->matches( ')' ) ) {\n125\t\t\t\t# A comma is required before each element except the first one\n126\t\t\t\tif ($t_count > 0) {\n127\t\t\t\t\t$this->tokens->ensure_matches(',');\n128\t\t\t\t}\n129\t\n130\t\t\t\tswitch( $this->tokens->type() ) {\n131\t\t\t\t\t# Nested array\n132\t\t\t\t\tcase T_ARRAY:\n133\t\t\t\t\t\t$t_array[] = $this->process_array();\n134\t\t\t\t\t\tbreak;\n135\t\n136\t\t\t\t\t# Value\n137\t\t\t\t\tcase T_CONSTANT_ENCAPSED_STRING:\n138\t\t\t\t\tcase T_STRING:\n139\t\t\t\t\tcase T_LNUMBER:\n140\t\t\t\t\tcase T_DNUMBER:\n141\t\t\t\t\tcase '-':\n142\t\t\t\t\tcase '+':\n143\t\t\t\t\t\t$t_str = $this->process_value();\n144\t\n145\t\t\t\t\t\tif( $this->tokens->matches( T_DOUBLE_ARROW ) ) {\n146\t\t\t\t\t\t\t# key => value\n147\t\t\t\t\t\t\t$this->tokens->pop();\n148\t\t\t\t\t\t\tif( $this->tokens->matches( T_ARRAY ) ) {\n149\t\t\t\t\t\t\t\t$t_array[$t_str] = $this->process_array();\n150\t\t\t\t\t\t\t} else {\n151\t\t\t\t\t\t\t\t$t_array[$t_str] = $this->process_value();\n152\t\t\t\t\t\t\t}\n153\t\t\t\t\t\t} else {\n154\t\t\t\t\t\t\t# Simple value\n155\t\t\t\t\t\t\t$t_array[] = $t_str;\n156\t\t\t\t\t\t}\n157\t\t\t\t\t\tbreak;\n158\t\n159\t\t\t\t\tcase ')':\n160\t\t\t\t\t\t# Cover the trailing ',' case\n161\t\t\t\t\t\tbreak;\n162\t\n163\t\t\t\t\tdefault:\n164\t\t\t\t\t\tthrow new Exception(\"Invalid token '\" . $this->tokens->value() . \"'\");\n165\t\t\t\t}\n166\t\n167\t\t\t\t$t_count++;\n168\t\t\t}\n169\t\t\t$this->tokens->ensure_matches( ')' );\n170\t\n171\t\t\treturn $t_array;\n172\t\t}\n173\t\n174\t\t/**\n175\t\t * Process a scalar value.\n176\t\t * Handles string literals including defined constants\n177\t\t * @return mixed\n178\t\t * @throws Exception when there's an unexpected value\n179\t\t */\n180\t\tprotected function process_value() {\n181\t\t\t# String literals\n182\t\t\tif( $this->tokens->matches( T_STRING ) ) {\n183\t\t\t\t$t_token = $this->tokens->pop();\n184\t\t\t\t$t_value = $t_token[1];\n185\t\n186\t\t\t\t# PHP Standard string literals\n187\t\t\t\tswitch (strtolower($t_value)) {\n188\t\t\t\t\tcase 'null':\n189\t\t\t\t\t\treturn null;\n190\t\t\t\t\tcase 'true':\n191\t\t\t\t\t\treturn true;\n192\t\t\t\t\tcase 'false':\n193\t\t\t\t\t\treturn false;\n194\t\t\t\t}\n195\t\n196\t\t\t\t# Defined constants\n197\t\t\t\t$t_value = $this->constant_replace( $t_value );\n198\t\t\t\tif( $t_value !== $t_token[1] ) {\n199\t\t\t\t\treturn $t_value;\n200\t\t\t\t}\n201\t\n202\t\t\t\tthrow new Exception(\"Unknown string literal '$t_value'\");\n203\t\t\t}\n204\t\n205\t\t\t# Strings\n206\t\t\tif( $this->tokens->matches( T_CONSTANT_ENCAPSED_STRING ) ) {\n207\t\t\t\t$t_value = $this->tokens->pop();\n208\t\t\t\treturn (string)stripslashes( substr( $t_value[1], 1, -1 ) );\n209\t\t\t}\n210\t\n211\t\t\t# Numbers\n212\t\t\t$t_negate = 1;\n213\t\t\tif( $this->tokens->matches( '-' ) ) {\n214\t\t\t\t$this->tokens->pop();\n215\t\t\t\t$t_negate = -1;\n216\t\t\t}\n217\t\t\tif( $this->tokens->matches( '+' ) ) {\n218\t\t\t\t$this->tokens->pop();\n219\t\t\t}\n220\t\n221\t\t\t# Integers\n222\t\t\tif( $this->tokens->matches( T_LNUMBER ) ) {\n223\t\t\t\t$t_value = $this->tokens->pop();\n224\t\t\t\treturn $t_negate * (int)$t_value[1];\n225\t\t\t}\n226\t\n227\t\t\t# Floating point\n228\t\t\tif( $this->tokens->matches( T_DNUMBER ) ) {\n229\t\t\t\t$t_value = $this->tokens->pop();\n230\t\t\t\treturn $t_negate * (float)$t_value[1];\n231\t\t\t}\n232\t\n233\t\t\t# Anything else\n234\t\t\tthrow new Exception( \"Unexpected value\" . $this->tokens->value() );\n235\t\t}\n236\t}\n237\t"}]},"parent_tool_use_id":null,"session_id":"59ad28b3-b8e4-4069-
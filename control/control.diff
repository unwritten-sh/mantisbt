+/**
+ * Unit tests for ConfigParser that do not need core.php or a database.
+ *
+ * @package    Tests
+ * @subpackage UnitTests
+ * @copyright Copyright 2026  MantisBT Team - mantisbt-dev@lists.sourceforge.net
+ * @link http://www.mantisbt.org
+ */
+
+namespace Mantis\tests\Unit;
+
+use ConfigParser;
+use Exception;
+use PHPUnit\Framework\TestCase;
+
+require_once __DIR__ . '/../../core/constant_inc.php';
+require_once __DIR__ . '/../../core/classes/Tokenizer.class.php';
+require_once __DIR__ . '/../../core/classes/ConfigParser.class.php';
+
+/**
+ * Test cases for short array syntax support in ConfigParser
+ *
+ * @package    Tests
+ * @subpackage ConfigParser
+ */
+class ConfigParserUnitTest extends TestCase {
+
+	/**
+	 * Short array with constants as key and value
+	 * @throws Exception
+	 */
+	public function testShortArrayConstants() {
+		$t_parser = new ConfigParser( '[ NEW_ => REPORTER ]' );
+		$this->assertSame( array( NEW_ => REPORTER ), $t_parser->parse() );
+	}
+
+	/**
+	 * Nested short arrays
+	 * @throws Exception
+	 */
+	public function testShortArrayNested() {
+		$t_parser = new ConfigParser( "[ 'a' => [ 1, 2 ] ]" );
+		$this->assertSame( array( 'a' => array( 1, 2 ) ), $t_parser->parse() );
+	}
+
+	/**
+	 * Short and long array syntax mixed, with trailing comma and empty arrays
+	 * @throws Exception
+	 */
+	public function testShortArrayMixedWithLongSyntax() {
+		$t_parser = new ConfigParser( "array( [ 1, array( 2, [] ), ], 'k' => [ 'x' => array() ] )" );
+		$this->assertSame(
+			array( array( 1, array( 2, array() ) ), 'k' => array( 'x' => array() ) ),
+			$t_parser->parse()
+		);
+	}
+
+	/**
+	 * Empty short array
+	 * @throws Exception
+	 */
+	public function testShortArrayEmpty() {
+		$t_parser = new ConfigParser( '[]' );
+		$this->assertSame( array(), $t_parser->parse() );
+	}
+
+	/**
+	 * An unclosed '[' must throw an exception
+	 * @throws Exception
+	 */
+	public function testShortArrayUnclosed() {
+		$this->expectException( Exception::class );
+		$t_parser = new ConfigParser( '[ 1, 2' );
+		$t_parser->parse();
+	}
+
+	/**
+	 * Mismatched brackets must throw an exception
+	 * @throws Exception
+	 */
+	public function testShortArrayMismatchedClose() {
+		$this->expectException( Exception::class );
+		$t_parser = new ConfigParser( '[ 1, 2 )' );
+		$t_parser->parse();
+	}
+}

{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgdUMM4BjvpDfXuW3BNpX","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KEpcWAyPNStTL1t5nBVjSB","name":"Write","input":{"file_path":"/Users/victor/Repos/unwritten/uw-harness-cases/mantisbt/bench/trees/mantisbt-1-control/tests/Mantis/FileEnsureUploadedTest.php","content":"<?php\n# MantisBT - A PHP based bugtracking system\n\n# MantisBT is free software: you can redistribute it and/or modify\n# it under the terms of the GNU General Public License as published by\n# the Free Software Foundation, either version 2 of the License, or\n# (at your option) any later version.\n#\n# MantisBT is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU General Public License for more details.\n#\n# You should have received a copy of the GNU General Public License\n# along with MantisBT.  If not, see <http://www.gnu.org/licenses/>.\n\n/**\n * Test cases for the checks of uploaded files (file_ensure_uploaded())\n * and their use by file_add() and the issue / file / note add commands.\n *\n * @package    Tests\n * @subpackage FileApi\n * @copyright  Copyright MantisBT Team - mantisbt-dev@lists.sourceforge.net\n * @link       http://www.mantisbt.org\n *\n * @noinspection PhpIllegalPsrClassPathInspection\n */\n\nnamespace Mantis\\tests\\Mantis;\n\nuse Mantis\\Exceptions\\ClientException;\n\n/**\n * PHPUnit tests for file_ensure_uploaded()\n */\nclass FileEnsureUploadedTest extends MantisCoreBase {\n\n\t/**\n\t * @var string[] Temporary files to delete after each test.\n\t */\n\tprivate $tmpFiles = array();\n\n\t/**\n\t * @var array Config options changed by the test (name => old value).\n\t */\n\tprivate $configs = array();\n\n\t/**\n\t * @var int[] Issues created by the test.\n\t */\n\tprivate $issueIds = array();\n\n\tprotected function setUp(): void {\n\t\tparent::setUp();\n\t\tself::login();\n\t}\n\n\tprotected function tearDown(): void {\n\t\tforeach( $this->issueIds as $t_issue_id ) {\n\t\t\tif( bug_exists( $t_issue_id ) ) {\n\t\t\t\tbug_delete( $t_issue_id );\n\t\t\t}\n\t\t}\n\t\tforeach( array_reverse( $this->configs, true ) as $t_config => $t_value ) {\n\t\t\t$this->restoreConfig( $t_config, $t_value );\n\t\t}\n\t\tforeach( $this->tmpFiles as $t_file ) {\n\t\t\tif( file_exists( $t_file ) ) {\n\t\t\t\tunlink( $t_file );\n\t\t\t}\n\t\t}\n\t\tparent::tearDown();\n\t}\n\n\t/**\n\t * Valid files pass, with and without the `error` key.\n\t */\n\tpublic function testValidFilePasses() {\n\t\t$t_file = $this->makeFile();\n\t\tfile_ensure_uploaded( $t_file );\n\n\t\t# Files added through the API have no `error` key.\n\t\tunset( $t_file['error'] );\n\t\tfile_ensure_uploaded( $t_file );\n\n\t\t$this->addToAssertionCount( 1 );\n\t}\n\n\t/**\n\t * The antispam check is done first.\n\t */\n\tpublic function testAntispamCheckIsFirst() {\n\t\t# Make the administrator subject to the antispam check, with a limit\n\t\t# of one event; creating an issue logs at least one history event.\n\t\tglobal $g_allow_signup, $g_cache_config_eval;\n\t\t$t_old_signup = $g_allow_signup;\n\t\t$g_allow_signup = ON;\n\t\tunset( $g_cache_config_eval['g_allow_signup'] );\n\t\t$this->changeConfig( 'default_new_account_access_level', ADMINISTRATOR );\n\t\t$this->changeConfig( 'antispam_max_event_count', 1 );\n\t\t$this->createIssue();\n\n\t\ttry {\n\t\t\t# An empty name would fail the second check.\n\t\t\t$this->assertClientException(\n\t\t\t\tarray( 'name' => '', 'tmp_name' => '' ),\n\t\t\t\t'Hit rate limit threshold',\n\t\t\t\tERROR_SPAM_SUSPECTED );\n\t\t} finally {\n\t\t\t$g_allow_signup = $t_old_signup;\n\t\t\tunset( $g_cache_config_eval['g_allow_signup'] );\n\t\t}\n\t}\n\n\t/**\n\t * Missing or empty names are rejected before the upload error is checked.\n\t */\n\tpublic function testEmptyName() {\n\t\t$this->assertClientException(\n\t\t\tarray( 'tmp_name' => '' ),\n\t\t\t'File name is empty',\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\n\t\t$this->assertClientException(\n\t\t\tarray( 'name' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_INI_SIZE ),\n\t\t\t'File name is empty',\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * Upload errors reported by PHP.\n\t *\n\t * @dataProvider providerUploadErrors\n\t *\n\t * @param int    $p_error   Upload error code.\n\t * @param string $p_message Expected message.\n\t * @param int    $p_code    Expected error code.\n\t */\n\tpublic function testUploadErrors( $p_error, $p_message, $p_code ) {\n\t\t# A too long name makes sure the upload error is checked before.\n\t\t$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.txt';\n\t\t$t_file = $this->makeFile( $t_name );\n\t\t$t_file['error'] = $p_error;\n\n\t\t$this->assertClientException( $t_file, sprintf( $p_message, $t_name ), $p_code );\n\t}\n\n\t/**\n\t * Data provider for testUploadErrors().\n\t *\n\t * @return array\n\t */\n\tpublic static function providerUploadErrors() {\n\t\treturn array(\n\t\t\t'ini size' => array( UPLOAD_ERR_INI_SIZE, \"File '%s' too big\", ERROR_FILE_TOO_BIG ),\n\t\t\t'form size' => array( UPLOAD_ERR_FORM_SIZE, \"File '%s' too big\", ERROR_FILE_TOO_BIG ),\n\t\t\t'partial' => array( UPLOAD_ERR_PARTIAL, \"File '%s' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE ),\n\t\t\t'no file' => array( UPLOAD_ERR_NO_FILE, \"File '%s' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE ),\n\t\t\t'no tmp dir' => array( UPLOAD_ERR_NO_TMP_DIR, \"File '%s' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE ),\n\t\t\t'cant write' => array( UPLOAD_ERR_CANT_WRITE, \"File '%s' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE ),\n\t\t\t'extension' => array( UPLOAD_ERR_EXTENSION, \"File '%s' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE ),\n\t\t\t'unknown' => array( 99, \"File '%s' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE ),\n\t\t);\n\t}\n\n\t/**\n\t * Names longer than the database field are rejected before the type check.\n\t */\n\tpublic function testNameTooLong() {\n\t\t$this->changeConfig( 'disallowed_files', 'exe' );\n\t\t$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.exe';\n\t\t$t_file = $this->makeFile( $t_name );\n\n\t\ttry {\n\t\t\tfile_ensure_uploaded( $t_file );\n\t\t\t$this->fail( 'ClientException expected' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( sprintf( \"Filename '%s' is too long\", $t_name ), $e->getMessage() );\n\t\t\t$this->assertEquals( ERROR_FILE_NAME_TOO_LONG, $e->getCode() );\n\t\t\t$this->assertEquals( array( $t_name ), $e->getParams() );\n\t\t}\n\n\t\t# Limit itself is allowed\n\t\t$t_file = $this->makeFile( str_repeat( 'b', DB_FIELD_SIZE_FILENAME - 4 ) . '.txt' );\n\t\tfile_ensure_uploaded( $t_file );\n\t}\n\n\t/**\n\t * Disallowed file types are rejected before the temporary file is checked.\n\t */\n\tpublic function testTypeNotAllowed() {\n\t\t$this->changeConfig( 'disallowed_files', 'exe' );\n\n\t\t$this->assertClientException(\n\t\t\tarray( 'name' => 'virus.exe', 'tmp_name' => '' ),\n\t\t\t\"File 'virus.exe' type not allowed\",\n\t\t\tERROR_FILE_NOT_ALLOWED );\n\n\t\t$this->changeConfig( 'disallowed_files', '' );\n\t\t$this->changeConfig( 'allowed_files', 'png' );\n\t\t$this->assertClientException(\n\t\t\t$this->makeFile( 'notes.txt' ),\n\t\t\t\"File 'notes.txt' type not allowed\",\n\t\t\tERROR_FILE_NOT_ALLOWED );\n\t}\n\n\t/**\n\t * Missing or empty temporary file path.\n\t */\n\tpublic function testPathEmpty() {\n\t\t$this->assertClientException(\n\t\t\tarray( 'name' => 'test.txt', 'tmp_name' => '' ),\n\t\t\t\"File 'test.txt' path is empty\",\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\n\t\t$this->assertClientException(\n\t\t\tarray( 'name' => 'test.txt' ),\n\t\t\t\"File 'test.txt' path is empty\",\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * Temporary file not readable.\n\t */\n\tpublic function testNotReadable() {\n\t\t$t_path = sys_get_temp_dir() . '/mantis-missing-' . uniqid();\n\n\t\t$this->assertClientException(\n\t\t\tarray( 'name' => 'test.txt', 'tmp_name' => $t_path, 'error' => UPLOAD_ERR_OK ),\n\t\t\t\"File 'test.txt' is not readable\",\n\t\t\tERROR_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * Empty file.\n\t */\n\tpublic function testEmptyFile() {\n\t\t$this->assertClientException(\n\t\t\t$this->makeFile( 'test.txt', '' ),\n\t\t\t\"File 'test.txt' not uploaded\",\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * File bigger than the maximum file size.\n\t */\n\tpublic function testFileTooBig() {\n\t\t$this->changeConfig( 'max_file_size', 10 );\n\n\t\t$this->assertClientException(\n\t\t\t$this->makeFile( 'test.txt', str_repeat( 'x', 11 ) ),\n\t\t\t\"File 'test.txt' too big\",\n\t\t\tERROR_FILE_TOO_BIG );\n\n\t\t# Maximum size itself is allowed\n\t\tfile_ensure_uploaded( $this->makeFile( 'test.txt', str_repeat( 'x', 10 ) ) );\n\t}\n\n\t/**\n\t * file_add() uses the same checks.\n\t */\n\tpublic function testFileAddChecksFile() {\n\t\t$this->changeConfig( 'disallowed_files', 'exe' );\n\t\t$t_issue_id = $this->createIssue();\n\n\t\ttry {\n\t\t\tfile_add( $t_issue_id, $this->makeFile( 'virus.exe' ) );\n\t\t\t$this->fail( 'ClientException expected' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( ERROR_FILE_NOT_ALLOWED, $e->getCode() );\n\t\t}\n\n\t\t$this->assertCount( 0, bug_get_attachments( $t_issue_id ) );\n\t}\n\n\t/**\n\t * IssueAddCommand checks the files during validation.\n\t */\n\tpublic function testIssueAddCommandChecksFiles() {\n\t\t$t_summary = __METHOD__ . ' ' . rand( 1, 1000000 );\n\t\t$t_command = new \\IssueAddCommand( array(\n\t\t\t'payload' => array( 'issue' => array(\n\t\t\t\t'project' => array( 'id' => 1 ),\n\t\t\t\t'summary' => $t_summary,\n\t\t\t\t'description' => 'Test issue',\n\t\t\t\t'category' => array( 'id' => 1 ),\n\t\t\t\t'files' => array( $this->makeFile( 'empty.txt', '' ) ),\n\t\t\t) ),\n\t\t) );\n\n\t\ttry {\n\t\t\t$t_command->validate();\n\t\t\t$this->fail( 'ClientException expected' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'empty.txt' not uploaded\", $e->getMessage() );\n\t\t\t$this->assertEquals( ERROR_FILE_NO_UPLOAD_FAILURE, $e->getCode() );\n\t\t}\n\t}\n\n\t/**\n\t * IssueAddCommand accepts valid files and ignores empty web form slots.\n\t */\n\tpublic function testIssueAddCommandWithValidFile() {\n\t\t$t_command = new \\IssueAddCommand( array(\n\t\t\t'payload' => array( 'issue' => array(\n\t\t\t\t'project' => array( 'id' => 1 ),\n\t\t\t\t'summary' => __METHOD__ . ' ' . rand( 1, 1000000 ),\n\t\t\t\t'description' => 'Test issue',\n\t\t\t\t'category' => array( 'id' => 1 ),\n\t\t\t\t'files' => array(\n\t\t\t\t\t$this->makeFile( 'valid.txt' ),\n\t\t\t\t\t$this->makeEmptySlot(),\n\t\t\t\t),\n\t\t\t) ),\n\t\t) );\n\t\t$t_result = $t_command->execute();\n\t\t$this->issueIds[] = $t_result['issue_id'];\n\n\t\t$t_attachments = bug_get_attachments( $t_result['issue_id'] );\n\t\t$this->assertCount( 1, $t_attachments );\n\t}\n\n\t/**\n\t * IssueFileAddCommand checks the files during validation.\n\t */\n\tpublic function testIssueFileAddCommandChecksFiles() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_command = new \\IssueFileAddCommand( array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array(\n\t\t\t\t$this->makeFile( 'valid.txt' ),\n\t\t\t\tarray_merge( $this->makeFile( 'partial.txt' ), array( 'error' => UPLOAD_ERR_PARTIAL ) ),\n\t\t\t) ),\n\t\t) );\n\n\t\ttry {\n\t\t\t$t_command->execute();\n\t\t\t$this->fail( 'ClientException expected' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'partial.txt' upload failure\", $e->getMessage() );\n\t\t\t$this->assertEquals( ERROR_FILE_NO_UPLOAD_FAILURE, $e->getCode() );\n\t\t}\n\n\t\t# No file was added, not even the valid one.\n\t\t$this->assertCount( 0, bug_get_attachments( $t_issue_id ) );\n\t}\n\n\t/**\n\t * IssueFileAddCommand accepts files without `error` key (API).\n\t */\n\tpublic function testIssueFileAddCommandWithApiFile() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_file = $this->makeFile( 'api.txt' );\n\t\tunset( $t_file['error'] );\n\t\t$t_file['browser_upload'] = false;\n\n\t\t$t_command = new \\IssueFileAddCommand( array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array( $t_file ) ),\n\t\t) );\n\t\t$t_command->execute();\n\n\t\t$this->assertCount( 1, bug_get_attachments( $t_issue_id ) );\n\t}\n\n\t/**\n\t * IssueNoteAddCommand checks the files during validation.\n\t */\n\tpublic function testIssueNoteAddCommandChecksFiles() {\n\t\t$this->changeConfig( 'disallowed_files', 'exe' );\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_command = new \\IssueNoteAddCommand( array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array(\n\t\t\t\t'text' => 'Note with a disallowed file',\n\t\t\t\t'files' => array( $this->makeFile( 'virus.exe' ) ),\n\t\t\t),\n\t\t) );\n\n\t\ttry {\n\t\t\t$t_command->execute();\n\t\t\t$this->fail( 'ClientException expected' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'virus.exe' type not allowed\", $e->getMessage() );\n\t\t\t$this->assertEquals( ERROR_FILE_NOT_ALLOWED, $e->getCode() );\n\t\t}\n\n\t\t# The note was not created.\n\t\t$this->assertEquals( 0, bug_get_bugnote_count( $t_issue_id ) );\n\t}\n\n\t/**\n\t * IssueNoteAddCommand ignores empty web form slots.\n\t */\n\tpublic function testIssueNoteAddCommandIgnoresEmptySlot() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_command = new \\IssueNoteAddCommand( array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array(\n\t\t\t\t'text' => 'Note without file',\n\t\t\t\t'files' => array( $this->makeEmptySlot() ),\n\t\t\t),\n\t\t) );\n\t\t$t_result = $t_command->execute();\n\n\t\t$this->assertTrue( bugnote_exists( $t_result['id'] ) );\n\t\t$this->assertCount( 0, bug_get_attachments( $t_issue_id ) );\n\t}\n\n\t/**\n\t * Asserts that file_ensure_uploaded() throws the expected exception.\n\t *\n\t * @param array  $p_file    File info.\n\t * @param string $p_message Expected message.\n\t * @param int    $p_code    Expected error code.\n\t */\n\tprivate function assertClientException( array $p_file, $p_message, $p_code ) {\n\t\ttry {\n\t\t\tfile_ensure_uploaded( $p_file );\n\t\t\t$this->fail( \"ClientException '$p_message' expected\" );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( $p_message, $e->getMessage() );\n\t\t\t$this->assertEquals( $p_code, $e->getCode() );\n\t\t}\n\t}\n\n\t/**\n\t * Creates a temporary file and returns its file info array.\n\t *\n\t * @param string $p_name    File name.\n\t * @param string $p_content File content.\n\t *\n\t * @return array\n\t */\n\tprivate function makeFile( $p_name = 'test.txt', $p_content = 'File content' ) {\n\t\t$t_path = tempnam( sys_get_temp_dir(), 'mantis-upload-' );\n\t\tfile_put_contents( $t_path, $p_content );\n\t\t$this->tmpFiles[] = $t_path;\n\n\t\treturn array(\n\t\t\t'name' => $p_name,\n\t\t\t'tmp_name' => $t_path,\n\t\t\t'type' => 'text/plain',\n\t\t\t'error' => UPLOAD_ERR_OK,\n\t\t\t'size' => strlen( $p_content ),\n\t\t);\n\t}\n\n\t/**\n\t * Returns the entry sent by a browser for a file input without file.\n\t *\n\t * @return array\n\t */\n\tprivate function makeEmptySlot() {\n\t\treturn array(\n\t\t\t'name' => '',\n\t\t\t'tmp_name' => '',\n\t\t\t'type' => '',\n\t\t\t'error' => UPLOAD_ERR_NO_FILE,\n\t\t\t'size' => 0,\n\t\t);\n\t}\n\n\t/**\n\t * Sets a config option, it is restored in tearDown().\n\t *\n\t * @param string $p_config Config name.\n\t * @param mixed  $p_value  Value.\n\t */\n\tprivate function changeConfig( $p_config, $p_value ) {\n\t\t$t_old = $this->setConfig( $p_config, $p_value );\n\t\tif( !array_key_exists( $p_config, $this->configs ) ) {\n\t\t\t$this->configs[$p_config] = $t_old;\n\t\t}\n\t}\n\n\t/**\n\t * Creates a test issue, deleted in tearDown().\n\t *\n\t * @return int Issue id.\n\t */\n\tprivate function createIssue() {\n\t\t$t_issue = new \\BugData();\n\t\t$t_issue->project_id = 1;\n\t\t$t_issue->summary = $this->getTestName() . ' ' . rand( 1, 1000000 );\n\t\t$t_issue->description = 'Test issue for file upload checks';\n\t\t$t_issue->category_id = 1;\n\t\t$t_issue_id = $t_issue->create();\n\t\t$this->issueIds[] = $t_issue_id;\n\n\t\treturn $t_issue_id;\n\t}\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1195,"cache_read_input_tokens":81915,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1195},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"bac2224d-87f8-4f58-a277-81ea294822df","uuid":"91ac7386-f113-4967-add9-4b7a96b05201","timestamp":"2026-11-02T04:30:45.403Z","request_id":"req_011CgdUMLcPbUpEuBV83aLwv","wire_tool_inputs":{"toolu_01KEpcWAyPNStTL1t5nBVjSB":{"file_path":"/Users/victor/Repos/unwritten/uw-harness-cases/mantisbt/bench/trees/mantisbt-1-control/tests/Mantis/FileEnsureUploadedTest.php","content":"<?php\n# MantisBT - A PHP based bugtracking system\n\n# MantisBT is free software: you can redistribute it and/or modify\n# it under the terms of the GNU General Public License as published by\n# the Free Software Foundation, either version 2 of the License, or\n# (at your option) any later version.\n#\n# MantisBT is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU General Public License for more details.\n#\n# You should have received a copy of the GNU General Public License\n# along with MantisBT.  If not, see <http://www.gnu.org/licenses/>.\n\n/**\n * Test cases for the checks of uploaded files (file_ensure_uploaded())\n * and their use by file_add() and the issue / file / note add commands.\n *\n * @package    Tests\n * @subpackage FileApi\n * @copyright  Copyright MantisBT Team - mantisbt-dev@lists.sourceforge.net\n * @link       http://www.mantisbt.org\n *\n * @noinspection PhpIllegalPsrClassPathInspection\n */\n\nnamespace Mantis\\tests\\Mantis;\n\nuse Mantis\\Exceptions\\ClientException;\n\n/**\n * PHPUnit tests for file_ensure_uploaded()\n */\nclass FileEnsureUploadedTest extends MantisCoreBase {\n\n\t/**\n\t * @var string[] Temporary files to delete after each test.\n\t */\n\tprivate $tmpFiles = array();\n\n\t/**\n\t * @var array Config options changed by the test (name => old value).\n\t */\n\tprivate $configs = array();\n\n\t/**\n\t * @var int[] Issues created by the test.\n\t */\n\tprivate $issueIds = array();\n\n\tprotected function setUp(): void {\n\t\tparent::setUp();\n\t\tself::login();\n\t}\n\n\tprotected function tearDown(): void {\n\t\tforeach( $this->issueIds as $t_issue_id ) {\n\t\t\tif( bug_exists( $t_issue_id ) ) {\n\t\t\t\tbug_delete( $t_issue_id );\n\t\t\t}\n\t\t}\n\t\tforeach( array_reverse( $this->configs, true ) as $t_config => $t_value ) {\n\t\t\t$this->restoreConfig( $t_config, $t_value );\n\t\t}\n\t\tforeach( $this->tmpFiles as $t_file ) {\n\t\t\tif( file_exists( $t_file ) ) {\n\t\t\t\tunlink( $t_file );\n\t\t\t}\n\t\t}\n\t\tparent::tearDown();\n\t}\n\n\t/**\n\t * Valid files pass, with and without the `error` key.\n\t */\n\tpublic function testValidFilePasses() {\n\t\t$t_file = $this->makeFile();\n\t\tfile_ensure_uploaded( $t_file );\n\n\t\t# Files added through the API have no `error` key.\n\t\tunset( $t_file['error'] );\n\t\tfile_ensure_uploaded( $t_file );\n\n\t\t$this->addToAssertionCount( 1 );\n\t}\n\n\t/**\n\t * The antispam check is done first.\n\t */\n\tpublic function testAntispamCheckIsFirst() {\n\t\t# Make the administrator subject to the antispam check, with a limit\n\t\t# of one event; creating an issue logs at least one history event.\n\t\tglobal $g_allow_signup, $g_cache_config_eval;\n\t\t$t_old_signup = $g_allow_signup;\n\t\t$g_allow_signup = ON;\n\t\tunset( $g_cache_config_eval['g_allow_signup'] );\n\t\t$this->changeConfig( 'default_new_account_access_level', ADMINISTRATOR );\n\t\t$this->changeConfig( 'antispam_max_event_count', 1 );\n\t\t$this->createIssue();\n\n\t\ttry {\n\t\t\t# An empty name would fail the second check.\n\t\t\t$this->assertClientException(\n\t\t\t\tarray( 'name' => '', 'tmp_name' => '' ),\n\t\t\t\t'Hit rate limit threshold',\n\t\t\t\tERROR_SPAM_SUSPECTED );\n\t\t} finally {\n\t\t\t$g_allow_signup = $t_old_signup;\n\t\t\tunset( $g_cache_config_eval['g_allow_signup'] );\n\t\t}\n\t}\n\n\t/**\n\t * Missing or empty names are rejected before the upload error is checked.\n\t */\n\tpublic function testEmptyName() {\n\t\t$this->assertClientException(\n\t\t\tarray( 'tmp_name' => '' ),\n\t\t\t'File name is empty',\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\n\t\t$this->assertClientException(\n\t\t\tarray( 'name' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_INI_SIZE ),\n\t\t\t'File name is empty',\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * Upload errors reported by PHP.\n\t *\n\t * @dataProvider providerUploadErrors\n\t *\n\t * @param int    $p_error   Upload error code.\n\t * @param string $p_message Expected message.\n\t * @param int    $p_code    Expected error code.\n\t */\n\tpublic function testUploadErrors( $p_error, $p_message, $p_code ) {\n\t\t# A too long name makes sure the upload error is checked before.\n\t\t$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.txt';\n\t\t$t_file = $this->makeFile( $t_name );\n\t\t$t_file['error'] = $p_error;\n\n\t\t$this->assertClientException( $t_file, sprintf( $p_message, $t_name ), $p_code );\n\t}\n\n\t/**\n\t * Data provider for testUploadErrors().\n\t *\n\t * @return array\n\t */\n\tpublic static function providerUploadErrors() {\n\t\treturn array(\n\t\t\t'ini size' => array( UPLOAD_ERR_INI_SIZE, \"File '%s' too big\", ERROR_FILE_TOO_BIG ),\n\t\t\t'form size' => array( UPLOAD_ERR_FORM_SIZE, \"File '%s' too big\", ERROR_FILE_TOO_BIG ),\n\t\t\t'partial' => array( UPLOAD_ERR_PARTIAL, \"File '%s' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE ),\n\t\t\t'no file' => array( UPLOAD_ERR_NO_FILE, \"File '%s' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE ),\n\t\t\t'no tmp dir' => array( UPLOAD_ERR_NO_TMP_DIR, \"File '%s' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE ),\n\t\t\t'cant write' => array( UPLOAD_ERR_CANT_WRITE, \"File '%s' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE ),\n\t\t\t'extension' => array( UPLOAD_ERR_EXTENSION, \"File '%s' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE ),\n\t\t\t'unknown' => array( 99, \"File '%s' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE ),\n\t\t);\n\t}\n\n\t/**\n\t * Names longer than the database field are rejected before the type check.\n\t */\n\tpublic function testNameTooLong() {\n\t\t$this->changeConfig( 'disallowed_files', 'exe' );\n\t\t$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.exe';\n\t\t$t_file = $this->makeFile( $t_name );\n\n\t\ttry {\n\t\t\tfile_ensure_uploaded( $t_file );\n\t\t\t$this->fail( 'ClientException expected' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( sprintf( \"Filename '%s' is too long\", $t_name ), $e->getMessage() );\n\t\t\t$this->assertEquals( ERROR_FILE_NAME_TOO_LONG, $e->getCode() );\n\t\t\t$this->assertEquals( array( $t_name ), $e->getParams() );\n\t\t}\n\n\t\t# Limit itself is allowed\n\t\t$t_file = $this->makeFile( str_repeat( 'b', DB_FIELD_SIZE_FILENAME - 4 ) . '.txt' );\n\t\tfile_ensure_uploaded( $t_file );\n\t}\n\n\t/**\n\t * Disallowed file types are rejected before the temporary file is checked.\n\t */\n\tpublic function testTypeNotAllowed() {\n\t\t$this->changeConfig( 'disallowed_files', 'exe' );\n\n\t\t$this->assertClientException(\n\t\t\tarray( 'name' => 'virus.exe', 'tmp_name' => '' ),\n\t\t\t\"File 'virus.exe' type not allowed\",\n\t\t\tERROR_FILE_NOT_ALLOWED );\n\n\t\t$this->changeConfig( 'disallowed_files', '' );\n\t\t$this->changeConfig( 'allowed_files', 'png' );\n\t\t$this->assertClientException(\n\t\t\t$this->makeFile( 'notes.txt' ),\n\t\t\t\"File 'notes.txt' type not allowed\",\n\t\t\tERROR_FILE_NOT_ALLOWED );\n\t}\n\n\t/**\n\t * Missing or empty temporary file path.\n\t */\n\tpublic function testPathEmpty() {\n\t\t$this->assertClientException(\n\t\t\tarray( 'name' => 'test.txt', 'tmp_name' => '' ),\n\t\t\t\"File 'test.txt' path is empty\",\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\n\t\t$this->assertClientException(\n\t\t\tarray( 'name' => 'test.txt' ),\n\t\t\t\"File 'test.txt' path is empty\",\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * Temporary file not readable.\n\t */\n\tpublic function testNotReadable() {\n\t\t$t_path = sys_get_temp_dir() . '/mantis-missing-' . uniqid();\n\n\t\t$this->assertClientException(\n\t\t\tarray( 'name' => 'test.txt', 'tmp_name' => $t_path, 'error' => UPLOAD_ERR_OK ),\n\t\t\t\"File 'test.txt' is not readable\",\n\t\t\tERROR_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * Empty file.\n\t */\n\tpublic function testEmptyFile() {\n\t\t$this->assertClientException(\n\t\t\t$this->makeFile( 'test.txt', '' ),\n\t\t\t\"File 'test.txt' not uploaded\",\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * File bigger than the maximum file size.\n\t */\n\tpublic function testFileTooBig() {\n\t\t$this->changeConfig( 'max_file_size', 10 );\n\n\t\t$this->assertClientException(\n\t\t\t$this->makeFile( 'test.txt', str_repeat( 'x', 11 ) ),\n\t\t\t\"File 'test.txt' too big\",\n\t\t\tERROR_FILE_TOO_BIG );\n\n\t\t# Maximum size itself is allowed\n\t\tfile_ensure_uploaded( $this->makeFile( 'test.txt', str_repeat( 'x', 10 ) ) );\n\t}\n\n\t/**\n\t * file_add() uses the same checks.\n\t */\n\tpublic function testFileAddChecksFile() {\n\t\t$this->changeConfig( 'disallowed_files', 'exe' );\n\t\t$t_issue_id = $this->createIssue();\n\n\t\ttry {\n\t\t\tfile_add( $t_issue_id, $this->makeFile( 'virus.exe' ) );\n\t\t\t$this->fail( 'ClientException expected' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( ERROR_FILE_NOT_ALLOWED, $e->getCode() );\n\t\t}\n\n\t\t$this->assertCount( 0, bug_get_attachments( $t_issue_id ) );\n\t}\n\n\t/**\n\t * IssueAddCommand checks the files during validation.\n\t */\n\tpublic function testIssueAddCommandChecksFiles() {\n\t\t$t_summary = __METHOD__ . ' ' . rand( 1, 1000000 );\n\t\t$t_command = new \\IssueAddCommand( array(\n\t\t\t'payload' => array( 'issue' => array(\n\t\t\t\t'project' => array( 'id' => 1 ),\n\t\t\t\t'summary' => $t_summary,\n\t\t\t\t'description' => 'Test issue',\n\t\t\t\t'category' => array( 'id' => 1 ),\n\t\t\t\t'files' => array( $this->makeFile( 'empty.txt', '' ) ),\n\t\t\t) ),\n\t\t) );\n\n\t\ttry {\n\t\t\t$t_command->validate();\n\t\t\t$this->fail( 'ClientException expected' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'empty.txt' not uploaded\", $e->getMessage() );\n\t\t\t$this->assertEquals( ERROR_FILE_NO_UPLOAD_FAILURE, $e->getCode() );\n\t\t}\n\t}\n\n\t/**\n\t * IssueAddCommand accepts valid files and ignores empty web form slots.\n\t */\n\tpublic function testIssueAddCommandWithValidFile() {\n\t\t$t_command = new \\IssueAddCommand( array(\n\t\t\t'payload' => array( 'issue' => array(\n\t\t\t\t'project' => array( 'id' => 1 ),\n\t\t\t\t'summary' => __METHOD__ . ' ' . rand( 1, 1000000 ),\n\t\t\t\t'description' => 'Test issue',\n\t\t\t\t'category' => array( 'id' => 1 ),\n\t\t\t\t'files' => array(\n\t\t\t\t\t$this->makeFile( 'valid.txt' ),\n\t\t\t\t\t$this->makeEmptySlot(),\n\t\t\t\t),\n\t\t\t) ),\n\t\t) );\n\t\t$t_result = $t_command->execute();\n\t\t$this->issueIds[] = $t_result['issue_id'];\n\n\t\t$t_attachments = bug_get_attachments( $t_result['issue_id'] );\n\t\t$this->assertCount( 1, $t_attachments );\n\t}\n\n\t/**\n\t * IssueFileAddCommand checks the files during validation.\n\t */\n\tpublic function testIssueFileAddCommandChecksFiles() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_command = new \\IssueFileAddCommand( array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array(\n\t\t\t\t$this->makeFile( 'valid.txt' ),\n\t\t\t\tarray_merge( $this->makeFile( 'partial.txt' ), array( 'error' => UPLOAD_ERR_PARTIAL ) ),\n\t\t\t) ),\n\t\t) );\n\n\t\ttry {\n\t\t\t$t_command->execute();\n\t\t\t$this->fail( 'ClientException expected' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'partial.txt' upload failure\", $e->getMessage() );\n\t\t\t$this->assertEquals( ERROR_FILE_NO_UPLOAD_FAILURE, $e->getCode() );\n\t\t}\n\n\t\t# No file was added, not even the valid one.\n\t\t$this->assertCount( 0, bug_get_attachments( $t_issue_id ) );\n\t}\n\n\t/**\n\t * IssueFileAddCommand accepts files without `error` key (API).\n\t */\n\tpublic function testIssueFileAddCommandWithApiFile() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_file = $this->makeFile( 'api.txt' );\n\t\tunset( $t_file['error'] );\n\t\t$t_file['browser_upload'] = false;\n\n\t\t$t_command = new \\IssueFileAddCommand( array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array( $t_file ) ),\n\t\t) );\n\t\t$t_command->execute();\n\n\t\t$this->assertCount( 1, bug_get_attachments( $t_issue_id ) );\n\t}\n\n\t/**\n\t * IssueNoteAddCommand checks the files during validation.\n\t */\n\tpublic function testIssueNoteAddCommandChecksFiles() {\n\t\t$this->changeConfig( 'disallowed_files', 'exe' );\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_command = new \\IssueNoteAddCommand( array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array(\n\t\t\t\t'text' => 'Note with a disallowed file',\n\t\t\t\t'files' => array( $this->makeFile( 'virus.exe' ) ),\n\t\t\t),\n\t\t) );\n\n\t\ttry {\n\t\t\t$t_command->execute();\n\t\t\t$this->fail( 'ClientException expected' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'virus.exe' type not allowed\", $e->getMessage() );\n\t\t\t$this->assertEquals( ERROR_FILE_NOT_ALLOWED, $e->getCode() );\n\t\t}\n\n\t\t# The note was not created.\n\t\t$this->assertEquals( 0, bug_get_bugnote_count( $t_issue_id ) );\n\t}\n\n\t/**\n\t * IssueNoteAddCommand ignores empty web form slots.\n\t */\n\tpublic function testIssueNoteAddCommandIgnoresEmptySlot() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_command = new \\IssueNoteAddCommand( array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array(\n\t\t\t\t'text' => 'Note without file',\n\t\t\t\t'files' => array( $this->makeEmptySlot() ),\n\t\t\t),\n\t\t) );\n\t\t$t_result = $t_command->execute();\n\n\t\t$this->assertTrue( bugnote_exists( $t_result['id'] ) );\n\t\t$this->assertCount( 0, bug_get_attachments( $t_issue_id ) );\n\t}\n\n\t/**\n\t * Asserts that file_ensure_uploaded() throws the expected exception.\n\t *\n\t * @param array  $p_file    File info.\n\t * @param string $p_message Expected message.\n\t * @param int    $p_code    Expected error code.\n\t */\n\tprivate function assertClientException( array $p_file, $p_message, $p_code ) {\n\t\ttry {\n\t\t\tfile_ensure_uploaded( $p_file );\n\t\t\t$this->fail( \"ClientException '$p_message' expected\" );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( $p_message, $e->getMessage() );\n\t\t\t$this->assertEquals( $p_code, $e->getCode() );\n\t\t}\n\t}\n\n\t/**\n\t * Creates a temporary file and returns its file info array.\n\t *\n\t * @param string $p_name    File name.\n\t * @param string $p_content File content.\n\t *\n\t * @return array\n\t */\n\tprivate function makeFile( $p_name = 'test.txt', $p_content = 'File content' ) {\n\t\t$t_path = tempnam( sys_get_temp_dir(), 'mantis-upload-' );\n\t\tfile_put_contents( $t_path, $p_content );\n\t\t$this->tmpFiles[] = $t_path;\n\n\t\treturn array(\n\t\t\t'name' => $p_name,\n\t\t\t'tmp_name' => $t_path,\n\t\t\t'type' => 'text/plain',\n\t\t\t'error' => UPLOAD_ERR_OK,\n\t\t\t'size' => strlen( $p_content ),\n\t\t);\n\t}\n\n\t/**\n\t * Returns the entry sent by a browser for a file input without file.\n\t *\n\t * @return array\n\t */\n\tprivate function makeEmptySlot() {\n\t\treturn array(\n\t\t\t'name' => '',\n\t\t\t'tmp_name' => '',\n\t\t\t'type' => '',\n\t\t\t'error' => UPLOAD_ERR_NO_FILE,\n\t\t\t'size' => 0,\n\t\t);\n\t}\n\n\t/**\n\t * Sets a config option, it is restored in tearDown().\n\t *\n\t * @param string $p_config Config name.\n\t * @param mixed  $p_value  Value.\n\t */\n\tprivate function changeConfig( $p_config, $p_value ) {\n\t\t$t_old = $this->setConfig( $p_config, $p_value );\n\t\tif( !array_key_exists( $p_config, $this->configs ) ) {\n\t\t\t$this->configs[$p_config] = $t_old;\n\t\t}\n\t}\n\n\t/**\n\t * Creates a test issue, deleted in tearDown().\n\t *\n\t * @return int Issue id.\n\t */\n\tprivate function createIssue() {\n\t\t$t_issue = new \\BugData();\n\t\t$t_issue->project_id = 1;\n\t\t$t_issue->summary = $this->getTestName() . ' ' . rand( 1, 1000000 );\n\t\t$t_issue->description = 'Test issue for file upload checks';\n\t\t$t_issue->category_id = 1;\n\t\t$t_issue_id = $t_issue->create();\n\t\t$this->issueIds[] = $t_issue_id;\n\n\t\treturn $t_issue_id;\n\t}\n}\n"}}}

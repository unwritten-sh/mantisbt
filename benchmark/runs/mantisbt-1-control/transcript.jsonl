{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QKAeeMzP9sSSLTqw3Y8yiV","type":"tool_result","content":"760\t\tdb_query( $t_query, array( $c_file_id ) );\n761\t\treturn true;\n762\t}\n763\t\n764\t/**\n765\t * File type check.\n766\t *\n767\t * @param string $p_file_name File name.\n768\t *\n769\t * @return bool\n770\t */\n771\tfunction file_type_check( $p_file_name ) {\n772\t\t$t_allowed_files = config_get( 'allowed_files' );\n773\t\t$t_disallowed_files = config_get( 'disallowed_files' );\n774\t\n775\t\t# grab extension\n776\t\t$t_extension = pathinfo( $p_file_name, PATHINFO_EXTENSION );\n777\t\n778\t\t# check against disallowed files\n779\t\tif( !is_blank( $t_disallowed_files ) ) {\n780\t\t\t$t_disallowed_arr = explode( ',', $t_disallowed_files );\n781\t\t\tforeach( $t_disallowed_arr as $t_val ) {\n782\t\t\t\tif( 0 == strcasecmp( $t_val, $t_extension ) ) {\n783\t\t\t\t\treturn false;\n784\t\t\t\t}\n785\t\t\t}\n786\t\t}\n787\t\n788\t\t# if the allowed list is not populated then the file must be allowed\n789\t\tif( is_blank( $t_allowed_files ) ) {\n790\t\t\treturn true;\n791\t\t}\n792\t\n793\t\t# check against allowed files\n794\t\t$t_allowed_arr = explode( ',', $t_allowed_files );\n795\t\tforeach( $t_allowed_arr as $t_val ) {\n796\t\t\tif( 0 == strcasecmp( $t_val, $t_extension ) ) {\n797\t\t\t\treturn true;\n798\t\t\t}\n799\t\t}\n800\t\n801\t\treturn false;\n802\t}\n803\t\n804\t/**\n805\t * Clean up the file name.\n806\t *\n807\t * Removes sensitive characters, replacing them with underscores.\n808\t *\n809\t * @param string $p_filename File name.\n810\t *\n811\t * @return string\n812\t */\n813\tfunction file_clean_name( $p_filename ) {\n814\t\treturn preg_replace( '/[\\/*?\"<>| :&]/', '_', $p_filename );\n815\t}\n816\t\n817\t/**\n818\t * Generate a unique string for a given file path.\n819\t *\n820\t * 32 characters hash to be used as the identifier for the file.\n821\t *\n822\t * @param string $p_filepath File path.\n823\t *\n824\t * @return string\n825\t * @throws Exception If no randomness source available (RandomException since PHP 8.2)\n826\t */\n827\tfunction file_generate_unique_name( $p_filepath ) {\n828\t\tdo {\n829\t\t\t$t_string = md5( random_bytes( 32 ) );\n830\t\t} while( !diskfile_is_name_unique( $t_string, $p_filepath ) );\n831\t\n832\t\treturn $t_string;\n833\t}\n834\t\n835\t/**\n836\t * Validates that the given disk file name identifier is unique.\n837\t *\n838\t * Checking both in the DB tables (bug and project) and on disk.\n839\t * This ensures that in case a file has been deleted from disk but its record\n840\t * remains in the DB, we never get in a situation where the DB points to a file\n841\t * which is not the originally uploaded one.\n842\t *\n843\t * @param string $p_name     File name.\n844\t * @param string $p_filepath File path.\n845\t *\n846\t * @return bool true if unique\n847\t */\n848\tfunction diskfile_is_name_unique( $p_name, $p_filepath ) {\n849\t\t$c_name = $p_filepath . $p_name;\n850\t\n851\t\tdb_param_push();\n852\t\t$t_query = 'SELECT count(*)\n853\t\t\tFROM (\n854\t\t\t\tSELECT diskfile FROM {bug_file} WHERE diskfile=' . db_param() . '\n855\t\t\t\tUNION\n856\t\t\t\tSELECT diskfile FROM {project_file} WHERE diskfile=' . db_param() . '\n857\t\t\t\t) f';\n858\t\t$t_result = db_query( $t_query, array( $c_name, $c_name) );\n859\t\t$t_count = db_result( $t_result );\n860\t\n861\t\treturn ( $t_count == 0 ) && !file_exists( $c_name );\n862\t}\n863\t\n864\t/**\n865\t * Validates that the given file name is unique in the given context.\n866\t *\n867\t * We don't allow multiple attachments with the same name for a given bug or project.\n868\t *\n869\t * @param string $p_name   File name.\n870\t * @param int    $p_bug_id A bug identifier (not used for project files).\n871\t * @param string $p_table  Optional file table to check: 'project' or 'bug' (default).\n872\t *\n873\t * @return bool true if unique\n874\t */\n875\tfunction file_is_name_unique( $p_name, $p_bug_id, $p_table = 'bug' ) {\n876\t\t$t_file_table = db_get_table( \"{$p_table}_file\" );\n877\t\n878\t\tdb_param_push();\n879\t\t$t_query = 'SELECT COUNT(*) FROM ' . $t_file_table . ' WHERE filename=' . db_param();\n880\t\t$t_param = array( $p_name );\n881\t\tif( $p_table == 'bug' ) {\n882\t\t\t$t_query .= ' AND bug_id=' . db_param();\n883\t\t\t$t_param[] = $p_bug_id;\n884\t\t}\n885\t\n886\t\t$t_result = db_query( $t_query, $t_param );\n887\t\t$t_count = db_result( $t_result );\n888\t\n889\t\treturn ( $t_count == 0 );\n890\t}\n891\t\n892\t/**\n893\t * Add a file to the system using the configured storage method.\n894\t *\n895\t * If file was not uploaded by the browser standard POST method, set value\n896\t * for key `browser_upload` on $p_file to false.  Otherwise, the file_add()\n897\t * operation will fail.\n898\t *\n899\t * @param int    $p_bug_id          The bug id (should be 0 when adding project\n900\t *                                  doc).\n901\t * @param array  $p_file            The uploaded file info, as retrieved from\n902\t *                                  gpc_get_file().\n903\t * @param string $p_table           Either 'bug' or 'project' depending on\n904\t *                                  attachment type.\n905\t * @param string $p_title           File title.\n906\t * @param string $p_desc            File description.\n907\t * @param int    $p_user_id         User id (defaults to current user).\n908\t * @param int    $p_date_added      Date added.\n909\t * @param bool   $p_skip_bug_update Skip bug last modification update (useful\n910\t *                                  when importing bug attachments).\n911\t * @param int    $p_bugnote_id      The bugnote id or 0 if associated with the\n912\t *                                  issue.\n913\t *\n914\t * @return array The file info array (keys: name, size)\n915\t * @throws ClientException\n916\t * @throws ServiceException\n917\t * @throws Exception\n918\t */\n919\tfunction file_add( $p_bug_id, array $p_fi
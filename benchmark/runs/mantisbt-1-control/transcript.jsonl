le '%s' upload failure\", $t_name ),\n\t\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t\t}\n\t}\n\n\tif( strlen( $t_name ) > DB_FIELD_SIZE_FILENAME ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"Filename '%s' is too long\", $t_name ),\n\t\t\tERROR_FILE_NAME_TOO_LONG,\n\t\t\tarray( $t_name ) );\n\t}\n\n\tif( !file_type_check( $t_name ) ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"File '%s' type not allowed\", $t_name ),\n\t\t\tERROR_FILE_NOT_ALLOWED );\n\t}\n\n\t$t_tmp_name = isset( $p_file['tmp_name'] ) ? (string)$p_file['tmp_name'] : '';\n\tif( $t_tmp_name === '' ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"File '%s' path is empty\", $t_name ),\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\tif( !is_readable( $t_tmp_name ) ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"File '%s' is not readable\", $t_name ),\n\t\t\tERROR_UPLOAD_FAILURE );\n\t}\n\n\t$t_file_size = filesize( $t_tmp_name );\n\tif( !$t_file_size ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"File '%s' not uploaded\", $t_name ),\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\tif( $t_file_size > file_get_max_file_size() ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"File '%s' too big\", $t_name ),\n\t\t\tERROR_FILE_TOO_BIG );\n\t}\n}"}}}

+# along with MantisBT.  If not, see <http://www.gnu.org/licenses/>.
+
+/**
+ * Test cases for the checks of uploaded files (file_ensure_uploaded())
+ * and their use by file_add() and the issue / file / note add commands.
+ *
+ * @package    Tests
+ * @subpackage FileApi
+ * @copyright  Copyright MantisBT Team - mantisbt-dev@lists.sourceforge.net
+ * @link       http://www.mantisbt.org
+ *
+ * @noinspection PhpIllegalPsrClassPathInspection
+ */
+
+namespace Mantis\tests\Mantis;
+
+use Mantis\Exceptions\ClientException;
+
+/**
+ * PHPUnit tests for file_ensure_uploaded()
+ */
+class FileEnsureUploadedTest extends MantisCoreBase {
+
+	/**
+	 * @var string[] Temporary files to delete after each test.
+	 */
+	private $tmpFiles = array();
+
+	/**
+	 * @var array Config options changed by the test (name => old value).
+	 */
+	private $configs = array();
+
+	/**
+	 * @var int[] Issues created by the test.
+	 */
+	private $issueIds = array();
+
+	protected function setUp(): void {
+		parent::setUp();
+		self::login();
+	}
+
+	protected function tearDown(): void {
+		foreach( $this->issueIds as $t_issue_id ) {
+			if( bug_exists( $t_issue_id ) ) {
+				bug_delete( $t_issue_id );
+			}
+		}
+		foreach( array_reverse( $this->configs, true ) as $t_config => $t_value ) {
+			$this->restoreConfig( $t_config, $t_value );
+		}
+		foreach( $this->tmpFiles as $t_file ) {
+			if( file_exists( $t_file ) ) {
+				unlink( $t_file );
+			}
+		}
+		parent::tearDown();
+	}
+
+	/**
+	 * Valid files pass, with and without the `error` key.
+	 */
+	public function testValidFilePasses() {
+		$t_file = $this->makeFile();
+		file_ensure_uploaded( $t_file );
+
+		# Files added through the API have no `error` key.
+		unset( $t_file['error'] );
+		file_ensure_uploaded( $t_file );
+
+		$this->addToAssertionCount( 1 );
+	}
+
+	/**
+	 * The antispam check is done first.
+	 */
+	public function testAntispamCheckIsFirst() {
+		# Make the administrator subject to the antispam check, with a limit
+		# of one event; creating an issue logs at least one history event.
+		global $g_allow_signup, $g_cache_config_eval;
+		$t_old_signup = $g_allow_signup;
+		$g_allow_signup = ON;
+		unset( $g_cache_config_eval['g_allow_signup'] );
+		$this->changeConfig( 'default_new_account_access_level', ADMINISTRATOR );
+		$this->changeConfig( 'antispam_max_event_count', 1 );
+		$this->createIssue();
+
+		try {
+			# An empty name would fail the second check.
+			$this->assertClientException(
+				array( 'name' => '', 'tmp_name' => '' ),
+				'Hit rate limit threshold',
+				ERROR_SPAM_SUSPECTED );
+		} finally {
+			$g_allow_signup = $t_old_signup;
+			unset( $g_cache_config_eval['g_allow_signup'] );
+		}
+	}
+
+	/**
+	 * Missing or empty names are rejected before the upload error is checked.
+	 */
+	public function testEmptyName() {
+		$this->assertClientException(
+			array( 'tmp_name' => '' ),
+			'File name is empty',
+			ERROR_FILE_NO_UPLOAD_FAILURE );
+
+		$this->assertClientException(
+			array( 'name' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_INI_SIZE ),
+			'File name is empty',
+			ERROR_FILE_NO_UPLOAD_FAILURE );
+	}
+
+	/**
+	 * Upload errors reported by PHP.
+	 *
+	 * @dataProvider providerUploadErrors
+	 *
+	 * @param int    $p_error   Upload error code.
+	 * @param string $p_message Expected message.
+	 * @param int    $p_code    Expected error code.
+	 */
+	public function testUploadErrors( $p_error, $p_message, $p_code ) {
+		# A too long name makes sure the upload error is checked before.
+		$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.txt';
+		$t_file = $this->makeFile( $t_name );
+		$t_file['error'] = $p_error;
+
+		$this->assertClientException( $t_file, sprintf( $p_message, $t_name ), $p_code );
+	}
+
+	/**
+	 * Data provider for testUploadErrors().
+	 *
+	 * @return array
+	 */
+	public static function providerUploadErrors() {
+		return array(
+			'ini size' => array( UPLOAD_ERR_INI_SIZE, "File '%s' too big", ERROR_FILE_TOO_BIG ),
+			'form size' => array( UPLOAD_ERR_FORM_SIZE, "File '%s' too big", ERROR_FILE_TOO_BIG ),
+			'partial' => array( UPLOAD_ERR_PARTIAL, "File '%s' upload failure", ERROR_FILE_NO_UPLOAD_FAILURE ),
+			'no file' => array( UPLOAD_ERR_NO_FILE, "File '%s' upload failure", ERROR_FILE_NO_UPLOAD_FAILURE ),
+			'no tmp dir' => array( UPLOAD_ERR_NO_TMP_DIR, "File '%s' upload failure", ERROR_FILE_NO_UPLOAD_FAILURE ),
+			'cant write' => array( UPLOAD_ERR_CANT_WRITE, "File '%s' upload failure", ERROR_FILE_NO_UPLOAD_FAILURE ),
+			'extension' => array( UPLOAD_ERR_EXTENSION, "File '%s' upload failure", ERROR_FILE_NO_UPLOAD_FAILURE ),
+			'unknown' => array( 99, "File '%s' upload failure", ERROR_FILE_NO_UPLOAD_FAILURE ),
+		);
+	}
+
+	/**
+	 * Names longer than the database field are rejected before the type check.
+	 */
+	public function testNameTooLong() {
+		$this->changeConfig( 'disallowed_files', 'exe' );
+		$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.exe';
+		$t_file = $this->makeFile( $t_name );
+
+		try {
+			file_ensure_uploaded( $t_file );
+			$this->fail( 'ClientException expected' );
+		} catch( ClientException $e ) {
+			$this->assertEquals( sprintf( "Filename '%s' is too long", $t_name ), $e->getMessage() );
+			$this->assertEquals( ERROR_FILE_NAME_TOO_LONG, $e->getCode() );
+			$this->assertEquals( array( $t_name ), $e->getParams() );
+		}
+
+		# Limit itself is allowed
+		$t_file = $this->makeFile( str_repeat( 'b', DB_FIELD_SIZE_FILENAME - 4 ) . '.txt' );
+		file_ensure_uploaded( $t_file );
+	}
+
+	/**
+	 * Disallowed file types are rejected before the temporary file is checked.
+	 */
+	public function testTypeNotAllowed() {
+		$this->changeConfig( 'disallowed_files', 'exe' );
+
+		$this->assertClientException(
+			array( 'name' => 'virus.exe', 'tmp_name' => '' ),
+			"File 'virus.exe' type not allowed",
+			ERROR_FILE_NOT_ALLOWED );
+
+		$this->changeConfig( 'disallowed_files', '' );
+		$this->changeConfig( 'allowed_files', 'png' );
+		$this->assertClientException(
+			$this->makeFile( 'notes.txt' ),
+			"File 'notes.txt' type not allowed",
+			ERROR_FILE_NOT_ALLOWED );
+	}
+
+	/**
+	 * Missing or empty temporary file path.
+	 */
+	public function testPathEmpty() {
+		$this->assertClientException(
+			array( 'name' => 'test.txt', 'tmp_name' => '' ),
+			"File 'test.txt' path is empty",
+			ERROR_FILE_NO_UPLOAD_FAILURE );
+
+		$this->assertClientException(
+			array( 'name' => 'test.txt' ),
+			"File 'test.txt' path is empty",
+			ERROR_FILE_NO_UPLOAD_FAILURE );
+	}
+
+	/**
+	 * Temporary file not readable.
+	 */
+	public function testNotReadable() {
+		$t_path = sys_get_temp_dir() . '/mantis-missing-' . uniqid();
+
+		$this->assertClientException(
+			array( 'name' => 'test.txt', 'tmp_name' => $t_path, 'error' => UPLOAD_ERR_OK ),
+			"File 'test.txt' is not readable",
+			ERROR_UPLOAD_FAILURE );
+	}
+
+	/**
+	 * Empty file.
+	 */
+	public function testEmptyFile() {
+		$this->assertClientException(
+			$this->makeFile( 'test.txt', '' ),
+			"File 'test.txt' not uploaded",
+			ERROR_FILE_NO_UPLOAD_FAILURE );
+	}
+
+	/**
+	 * File bigger than the maximum file size.
+	 */
+	public function testFileTooBig() {
+		$this->changeConfig( 'max_file_size', 10 );
+
+		$this->assertClientException(
+			$this->makeFile( 'test.txt', str_repeat( 'x', 11 ) ),
+			"File 'test.txt' too big",
+			ERROR_FILE_TOO_BIG );
+
+		# Maximum size itself is allowed
+		file_ensure_uploaded( $this->makeFile( 'test.txt', str_repeat( 'x', 10 ) ) );
+	}
+
+	/**
+	 * file_add() uses the same checks.
+	 */
+	public function testFileAddChecksFile() {
+		$this->changeConfig( 'disallowed_files', 'exe' );
+		$t_issue_id = $this->createIssue();
+
+		try {
+			file_add( $t_issue_id, $this->makeFile( 'virus.exe' ) );
+			$this->fail( 'ClientException expected' );
+		} catch( ClientException $e ) {
+			$this->assertEquals( ERROR_FILE_NOT_ALLOWED, $e->getCode() );
+		}
+
+		$this->assertCount( 0, bug_get_attachments( $t_issue_id ) );
+	}
+
+	/**
+	 * IssueAddCommand checks the files during validation.
+	 */
+	public function testIssueAddCommandChecksFiles() {
+		$t_summary = __METHOD__ . ' ' . rand( 1, 1000000 );
+		$t_command = new \IssueAddCommand( array(
+			'payload' => array( 'issue' => array(
+				'project' => array( 'id' => 1 ),
+				'summary' => $t_summary,
+				'description' => 'Test issue',
+				'category' => array( 'id' => 1 ),
+				'files' => array( $this->makeFile( 'empty.txt', '' ) ),
+			) ),
+		) );
+
+		try {
+			$t_command->execute();
+			$this->fail( 'ClientException expected' );
+		} catch( ClientException $e ) {
+			$this->assertEquals( "File 'empty.txt' not uploaded", $e->getMessage() );
+			$this->assertEquals( ERROR_FILE_NO_UPLOAD_FAILURE, $e->getCode() );
+		}
+
+		# The issue was not created.
+		db_param_push();
+		$t_result = db_query( 'SELECT COUNT(*) FROM {bug} WHERE summary=' . db_param(), array( $t_summary ) );
+		$this->assertEquals( 0, db_result( $t_result ) );
+	}
+
+	/**
+	 * IssueAddCommand accepts valid files and ignores empty web form slots.
+	 */
+	public function testIssueAddCommandWithValidFile() {
+		$t_command = new \IssueAddCommand( array(
+			'payload' => array( 'issue' => array(
+				'project' => array( 'id' => 1 ),
+				'summary' => __METHOD__ . ' ' . rand( 1, 1000000 ),
+				'description' => 'Test issue',
+				'category' => array( 'id' => 1 ),
+				'files' => array(
+					$this->makeFile( 'valid.txt' ),
+					$this->makeEmptySlot(),
+				),
+			) ),
+		) );
+		$t_result = $t_command->execute();
+		$this->issueIds[] = $t_result['issue_id'];
+
+		$t_attachments = bug_get_attachments( $t_result['issue_id'] );
+		$this->assertCount( 1, $t_attachments );
+	}
+
+	/**
+	 * IssueFileAddCommand checks the files during validation.
+	 */
+	public function testIssueFileAddCommandChecksFiles() {
+		$t_issue_id = $this->createIssue();
+		$t_command = new \IssueFileAddCommand( array(
+			'query' => array( 'issue_id' => $t_issue_id ),
+			'payload' => array( 'files' => array(
+				$this->makeFile( 'valid.txt' ),
+				array_merge( $this->makeFile( 'partial.txt' ), array( 'error' => UPLOAD_ERR_PARTIAL ) ),
+			) ),
+		) );
+
+		try {
+			$t_command->execute();
+			$this->fail( 'ClientException expected' );
+		} catch( ClientException $e ) {
+			$this->assertEquals( "File 'partial.txt' upload failure", $e->getMessage() );
+			$this->assertEquals( ERROR_FILE_NO_UPLOAD_FAILURE, $e->getCode() );
+		}
+
+		# No file was added, not even the valid one.
+		$this->assertCount( 0, bug_get_attachments( $t_issue_id ) );
+	}
+
+	/**
+	 * IssueFileAddCommand accepts files without `error` key (API).

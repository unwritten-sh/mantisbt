+	/**
+	 * Asserts that file_ensure_uploaded() throws the expected exception.
+	 *
+	 * @param array  $p_file    File info.
+	 * @param string $p_message Expected message.
+	 * @param int    $p_code    Expected error code.
+	 */
+	private function assertClientException( array $p_file, $p_message, $p_code ) {
+		try {
+			file_ensure_uploaded( $p_file );
+			$this->fail( "ClientException '$p_message' expected" );
+		} catch( ClientException $e ) {
+			$this->assertEquals( $p_message, $e->getMessage() );
+			$this->assertEquals( $p_code, $e->getCode() );
+		}
+	}
+
+	/**
+	 * Creates a temporary file and returns its file info array.
+	 *
+	 * @param string $p_name    File name.
+	 * @param string $p_content File content.
+	 *
+	 * @return array
+	 */
+	private function makeFile( $p_name = 'test.txt', $p_content = 'File content' ) {
+		$t_path = tempnam( sys_get_temp_dir(), 'mantis-upload-' );
+		file_put_contents( $t_path, $p_content );
+		$this->tmpFiles[] = $t_path;
+
+		return array(
+			'name' => $p_name,
+			'tmp_name' => $t_path,
+			'type' => 'text/plain',
+			'error' => UPLOAD_ERR_OK,
+			'size' => strlen( $p_content ),
+		);
+	}
+
+	/**
+	 * Returns the entry sent by a browser for a file input without file.
+	 *
+	 * @return array
+	 */
+	private function makeEmptySlot() {
+		return array(
+			'name' => '',
+			'tmp_name' => '',
+			'type' => '',
+			'error' => UPLOAD_ERR_NO_FILE,
+			'size' => 0,
+		);
+	}
+
+	/**
+	 * Sets a config option, it is restored in tearDown().
+	 *
+	 * @param string $p_config Config name.
+	 * @param mixed  $p_value  Value.
+	 */
+	private function changeConfig( $p_config, $p_value ) {
+		$t_old = $this->setConfig( $p_config, $p_value );
+		if( !array_key_exists( $p_config, $this->configs ) ) {
+			$this->configs[$p_config] = $t_old;
+		}
+	}
+
+	/**
+	 * Creates a test issue, deleted in tearDown().
+	 *
+	 * @return int Issue id.
+	 */
+	private function createIssue() {
+		$t_issue = new \BugData();
+		$t_issue->project_id = 1;
+		$t_issue->summary = $this->getTestName() . ' ' . rand( 1, 1000000 );
+		$t_issue->description = 'Test issue for file upload checks';
+		$t_issue->category_id = 1;
+		$t_issue_id = $t_issue->create();
+		$this->issueIds[] = $t_issue_id;
+
+		return $t_issue_id;
+	}
+}

+		$t_file = $this->makeFile( 'api.txt' );
+		unset( $t_file['error'] );
+		$t_file['browser_upload'] = false;
+
+		$t_command = new \IssueFileAddCommand( array(
+			'query' => array( 'issue_id' => $t_issue_id ),
+			'payload' => array( 'files' => array( $t_file ) ),
+		) );

+	/**
+	 * Test adding a category with a handler referenced by id or by name.
+	 *
+	 * @return void
+	 */
+	public function testAddWithHandler() {
+		self::login();
+		$t_user_id = auth_get_current_user_id();
+		$t_user_name = user_get_username( $t_user_id );
+
+		foreach( [ [ 'id' => $t_user_id ], [ 'name' => $t_user_name ] ] as $t_handler ) {

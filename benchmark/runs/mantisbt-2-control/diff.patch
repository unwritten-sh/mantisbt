+	private function getCategory( $p_category_id ) {
+		category_cache_flush( 1 );
+		$t_data = [ 'query' => [ 'project_id' => 1, 'category_id' => $p_category_id ] ];
+		$t_command = new \CategoryGetCommand( $t_data );
+		$t_result = $t_command->execute();
+		return $t_result['categories'][0];
+	}

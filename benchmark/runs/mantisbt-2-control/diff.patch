+/**
+ * Resolve a category handler reference to a user id.
+ *
+ * The reference follows the REST API convention for users: an array (or
+ * object) with either an 'id' or a 'name' key. A null reference means no
+ * handler.
+ *
+ * When the reference is given by id, the user's existence is not checked
+ * here; use {@see category_validate_assigned_to()} for that. This allows
+ * callers to skip validation when the handler is unchanged.
+ *
+ * @param array|object|null $p_handler Handler reference, or null for no handler.
+ *
+ * @return int User identifier, or NO_USER.
+ * @throws ClientException If the reference is malformed, or if the user
+ *                         referenced by name does not exist.
+ */
+function category_resolve_handler( $p_handler ) {
+	if( $p_handler === null ) {
+		return NO_USER;
+	}
+
+	if( is_object( $p_handler ) ) {
+		$p_handler = get_object_vars( $p_handler );
+	}
+
+	if( is_array( $p_handler ) ) {
+		if( isset( $p_handler['id'] ) ) {
+			if( is_numeric( $p_handler['id'] ) && (int)$p_handler['id'] > 0 ) {
+				return (int)$p_handler['id'];
+			}
+		} elseif( isset( $p_handler['name'] ) && is_string( $p_handler['name'] ) && !is_blank( $p_handler['name'] ) ) {
+			return user_get_id_by_name( $p_handler['name'], /* throw */ true );
+		}
+	}
+
+	throw new ClientException( "'handler' must be null or an object with a user 'id' or 'name'",
+		ERROR_INVALID_FIELD_VALUE,
+		[ 'handler' ]
+	);
+}

+				$this->assertEquals( $t_user_name, $t_category['handler']['name'] );
+				$this->assertEquals( $t_user_id, (int)category_get_field( $t_category['id'], 'user_id' ) );
+
+				$t_category = $this->getCategory( $t_category['id'] );
+				$this->assertEquals( $t_user_id, $t_category['handler']['id'] );

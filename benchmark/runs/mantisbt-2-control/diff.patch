+	 *
+	 * @param int   $p_category_id Category identifier.
+	 * @param array $p_payload     Update payload.
+	 *
+	 * @return array Updated category.
+	 */
+	private function updateCategory( $p_category_id, array $p_payload ) {
+		$t_data = [
+			'query' => [ 'project_id' => 1, 'category_id' => $p_category_id ],
+			'payload' => $p_payload,
+		];
+		$t_command = new \CategoryUpdateCommand( $t_data );
+		$t_result = $t_command->execute();
+		return $t_result['category'];

@@ -875,3 +875,25 @@ function category_enabled_to_status( $p_enabled ) {
 function category_status_to_enabled( $p_status ) {
 	return (int)$p_status === CATEGORY_STATUS_ENABLED;
 }
+
+/**
+ * Parse and validate the project id used by the category commands.
+ *
+ * ALL_PROJECTS (0) is accepted, to manage global categories.
+ *
+ * @param mixed $p_project_id The project id, as received by the command.
+ * @return int The project id.
+ * @throws ClientException If the project id is invalid or the project does not exist.
+ */
+function category_parse_project_id( $p_project_id ) {
+	if( is_numeric( $p_project_id ) && (int)$p_project_id === ALL_PROJECTS ) {
+		return ALL_PROJECTS;
+	}
+
+	$t_project_id = helper_parse_id( $p_project_id, 'project_id' );
+	if( !project_exists( $t_project_id ) ) {
+		throw new ClientException( "Project '$t_project_id' not found", ERROR_PROJECT_NOT_FOUND, [ $t_project_id ] );
+	}
+
+	return $t_project_id;
+}

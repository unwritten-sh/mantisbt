+	/**
+	 * Create a temporary file and return its file array, as sent by PHP.
+	 *
+	 * @param string $p_name    File name.
+	 * @param string $p_content File content.
+	 * @return array
+	 */
+	private function createFile( $p_name, $p_content = 'test content' ) {
+		$t_tmp_name = tempnam( sys_get_temp_dir(), 'MantisTest' );
+		file_put_contents( $t_tmp_name, $p_content );
+		$this->tmpFiles[] = $t_tmp_name;
+
+		return array(
+			'name' => $p_name,
+			'type' => 'text/plain',
+			'tmp_name' => $t_tmp_name,
+			'error' => UPLOAD_ERR_OK,
+			'size' => strlen( $p_content ),
+		);
+	}

+	 */
+	private function createIssue() {
+		$t_issue = new \BugData();
+		$t_issue->project_id = 1;
+		$t_issue->summary = __CLASS__ . ': test issue ' . rand( 1, 1000000 );
+		$t_issue->description = 'Test issue for file checks';
+		$t_issue->category_id = 1;
+
+		$t_issue_id = $t_issue->create();
+		$this->issueIds[] = $t_issue_id;
+		return $t_issue_id;
+	}
+
+	/**
+	 * Set a configuration option and remember its old value.
+	 *
+	 * @param string $p_config Option name.
+	 * @param mixed  $p_value  New value.
+	 */
+	private function changeConfig( $p_config, $p_value ) {
+		$t_old = $this->setConfig( $p_config, $p_value );
+		if( !array_key_exists( $p_config, $this->oldConfigs ) ) {
+			$this->oldConfigs[$p_config] = $t_old;
+		}
+	}
+
+	/**
+	 * Set the global allow_signup option.
+	 *
+	 * @param mixed $p_value New value.
+	 */
+	private function setAllowSignup( $p_value ) {
+		global $g_cache_config_eval;
+		$GLOBALS['g_allow_signup'] = $p_value;
+		unset( $g_cache_config_eval['g_allow_signup'] );
+	}
+
+	/**
+	 * Log in as a new reporter that has reached the antispam limit.
+	 */
+	private function loginAsSpammer() {
+		$this->oldAllowSignup = config_get_global( 'allow_signup' );
+		$this->setAllowSignup( ON );
+
+		$t_issue_id = $this->createIssue();
+
+		$t_username = 'spam' . rand( 1, 1000000 );
+		user_create( $t_username, 'password', $t_username . '@localhost.localdomain', REPORTER );
+		$t_user_id = user_get_id_by_name( $t_username );
+		$this->userIds[] = $t_user_id;
+
+		$this->changeConfig( 'default_new_account_access_level', REPORTER );
+		$this->changeConfig( 'antispam_max_event_count', 1 );
+
+		history_log_event_direct( $t_issue_id, 'summary', 'old', 'new', $t_user_id );
+
+		$this->assertTrue( auth_attempt_script_login( $t_username, 'password' ) );
+	}
+}

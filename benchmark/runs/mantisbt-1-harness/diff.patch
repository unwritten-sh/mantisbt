+/**
+ * Remove the entries of a list of uploaded files for which the user did not
+ * select any file.
+ *
+ * A web form with an empty file input sends an entry with an empty name and
+ * the error code UPLOAD_ERR_NO_FILE. Such entries are not upload errors and
+ * are ignored by file_attach_files().
+ *
+ * @param array $p_files List of file arrays, as retrieved from gpc_get_file()
+ *                       and transposed with helper_array_transpose().
+ *
+ * @return array The files that were selected, with keys re-indexed.
+ */
+function file_filter_not_selected( array $p_files ) {
+	$t_files = array();
+	foreach( $p_files as $t_file ) {
+		if( is_array( $t_file )
+			&& empty( $t_file['name'] )
+			&& isset( $t_file['error'] )
+			&& UPLOAD_ERR_NO_FILE == $t_file['error']
+		) {
+			continue;
+		}
+		$t_files[] = $t_file;
+	}
+	return $t_files;
+}

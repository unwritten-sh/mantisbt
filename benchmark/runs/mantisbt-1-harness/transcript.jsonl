{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgcyfersm81EhNjn62yDz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LPZ8vZ3FfgYJvp3XB588qP","name":"Write","input":{"file_path":"/Users/victor/Repos/unwritten/uw-harness-cases/mantisbt/bench/trees/mantisbt-1-harness/tests/Mantis/FileEnsureUploadedTest.php","content":"<?php\n# MantisBT - A PHP based bugtracking system\n\n# MantisBT is free software: you can redistribute it and/or modify\n# it under the terms of the GNU General Public License as published by\n# the Free Software Foundation, either version 2 of the License, or\n# (at your option) any later version.\n#\n# MantisBT is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU General Public License for more details.\n#\n# You should have received a copy of the GNU General Public License\n# along with MantisBT.  If not, see <http://www.gnu.org/licenses/>.\n\n/**\n * Test cases for the checks on uploaded files (file_ensure_uploaded())\n * and their use by the commands that attach files.\n *\n * @package    Tests\n * @subpackage FileApi\n * @copyright  Copyright MantisBT Team - mantisbt-dev@lists.sourceforge.net\n * @link       http://www.mantisbt.org\n *\n * @noinspection PhpIllegalPsrClassPathInspection\n */\n\nnamespace Mantis\\tests\\Mantis;\n\nuse Mantis\\Exceptions\\ClientException;\n\nrequire_api( 'file_api.php' );\n\n/**\n * PHPUnit tests for file_ensure_uploaded()\n */\nclass FileEnsureUploadedTest extends MantisCoreBase {\n\t/**\n\t * @var string[] Temporary files to delete after the test\n\t */\n\tprivate $tmpFiles = array();\n\n\t/**\n\t * @var int[] Issues to delete after the test\n\t */\n\tprivate $issueIds = array();\n\n\t/**\n\t * @var int[] Users to delete after the test\n\t */\n\tprivate $userIds = array();\n\n\t/**\n\t * @var array Configuration options to restore after the test\n\t */\n\tprivate $oldConfigs = array();\n\n\t/**\n\t * @var mixed|null Old value of the global allow_signup option\n\t */\n\tprivate $oldAllowSignup = null;\n\n\tprotected function setUp(): void {\n\t\tparent::setUp();\n\t\tself::login();\n\t}\n\n\tprotected function tearDown(): void {\n\t\tforeach( $this->oldConfigs as $t_config => $t_value ) {\n\t\t\t$this->restoreConfig( $t_config, $t_value );\n\t\t}\n\n\t\tif( $this->oldAllowSignup !== null ) {\n\t\t\t$this->setAllowSignup( $this->oldAllowSignup );\n\t\t}\n\n\t\tself::login();\n\n\t\tforeach( $this->issueIds as $t_issue_id ) {\n\t\t\tif( bug_exists( $t_issue_id ) ) {\n\t\t\t\tbug_delete( $t_issue_id );\n\t\t\t}\n\t\t}\n\n\t\tforeach( $this->userIds as $t_user_id ) {\n\t\t\tuser_delete( $t_user_id );\n\t\t}\n\n\t\tforeach( $this->tmpFiles as $t_file ) {\n\t\t\tif( file_exists( $t_file ) ) {\n\t\t\t\tunlink( $t_file );\n\t\t\t}\n\t\t}\n\n\t\tparent::tearDown();\n\t}\n\n\t/**\n\t * A valid file passes, with or without the 'error' key.\n\t *\n\t * @doesNotPerformAssertions\n\t */\n\tpublic function testValidFile() {\n\t\t$t_file = $this->createFile( 'valid.txt' );\n\t\tfile_ensure_uploaded( $t_file );\n\n\t\tunset( $t_file['error'] );\n\t\tfile_ensure_uploaded( $t_file );\n\t}\n\n\t/**\n\t * Data provider for testInvalidFile().\n\t *\n\t * Each case: file array modifier, expected message, expected error code.\n\t *\n\t * @return array\n\t */\n\tpublic static function providerInvalidFile() {\n\t\t$t_long_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.txt';\n\n\t\treturn array(\n\t\t\t'name missing' => array(\n\t\t\t\tarray( 'name' => null ),\n\t\t\t\t'File name is empty',\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'name empty' => array(\n\t\t\t\tarray( 'name' => '' ),\n\t\t\t\t'File name is empty',\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'name empty before upload error' => array(\n\t\t\t\tarray( 'name' => '', 'error' => UPLOAD_ERR_NO_FILE ),\n\t\t\t\t'File name is empty',\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'ini size' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_INI_SIZE ),\n\t\t\t\t\"File 'test.txt' too big\",\n\t\t\t\tERROR_FILE_TOO_BIG,\n\t\t\t),\n\t\t\t'form size' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_FORM_SIZE ),\n\t\t\t\t\"File 'test.txt' too big\",\n\t\t\t\tERROR_FILE_TOO_BIG,\n\t\t\t),\n\t\t\t'partial' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_PARTIAL ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'no file' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_NO_FILE ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'no tmp dir' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_NO_TMP_DIR ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'cant write' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_CANT_WRITE ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'extension' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_EXTENSION ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'unknown error code' => array(\n\t\t\t\tarray( 'error' => 99 ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'upload error before name too long' => array(\n\t\t\t\tarray( 'name' => $t_long_name, 'error' => UPLOAD_ERR_PARTIAL ),\n\t\t\t\t\"File '$t_long_name' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'name too long' => array(\n\t\t\t\tarray( 'name' => $t_long_name ),\n\t\t\t\t\"Filename '$t_long_name' is too long\",\n\t\t\t\tERROR_FILE_NAME_TOO_LONG,\n\t\t\t),\n\t\t\t'name too long before type' => array(\n\t\t\t\tarray( 'name' => str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.svg' ),\n\t\t\t\t\"Filename '\" . str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . \".svg' is too long\",\n\t\t\t\tERROR_FILE_NAME_TOO_LONG,\n\t\t\t),\n\t\t\t'type not allowed' => array(\n\t\t\t\tarray( 'name' => 'test.svg' ),\n\t\t\t\t\"File 'test.svg' type not allowed\",\n\t\t\t\tERROR_FILE_NOT_ALLOWED,\n\t\t\t),\n\t\t\t'type before path' => array(\n\t\t\t\tarray( 'name' => 'test.svg', 'tmp_name' => '' ),\n\t\t\t\t\"File 'test.svg' type not allowed\",\n\t\t\t\tERROR_FILE_NOT_ALLOWED,\n\t\t\t),\n\t\t\t'path missing' => array(\n\t\t\t\tarray( 'tmp_name' => null ),\n\t\t\t\t\"File 'test.txt' path is empty\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'path empty' => array(\n\t\t\t\tarray( 'tmp_name' => '' ),\n\t\t\t\t\"File 'test.txt' path is empty\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'not readable' => array(\n\t\t\t\tarray( 'tmp_name' => '/nonexistent/mantis-test-file' ),\n\t\t\t\t\"File 'test.txt' is not readable\",\n\t\t\t\tERROR_UPLOAD_FAILURE,\n\t\t\t),\n\t\t);\n\t}\n\n\t/**\n\t * Each invalid file gives the expected exception.\n\t *\n\t * @dataProvider providerInvalidFile\n\t *\n\t * @param array  $p_changes Changes to apply to a valid file array (null removes the key).\n\t * @param string $p_message Expected exception message.\n\t * @param int    $p_code    Expected error code.\n\t */\n\tpublic function testInvalidFile( array $p_changes, $p_message, $p_code ) {\n\t\t$t_file = $this->createFile( 'test.txt' );\n\t\tforeach( $p_changes as $t_key => $t_value ) {\n\t\t\tif( $t_value === null ) {\n\t\t\t\tunset( $t_file[$t_key] );\n\t\t\t} else {\n\t\t\t\t$t_file[$t_key] = $t_value;\n\t\t\t}\n\t\t}\n\n\t\t$this->assertClientException( $t_file, $p_message, $p_code );\n\t}\n\n\t/**\n\t * An empty file is rejected.\n\t */\n\tpublic function testEmptyFile() {\n\t\t$t_file = $this->createFile( 'empty.txt', '' );\n\t\t$this->assertClientException( $t_file, \"File 'empty.txt' not uploaded\", ERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * A file bigger than the maximum file size is rejected.\n\t */\n\tpublic function testFileTooBig() {\n\t\t$this->changeConfig( 'max_file_size', 10 );\n\t\t$t_file = $this->createFile( 'big.txt', str_repeat( 'x', 11 ) );\n\t\t$this->assertClientException( $t_file, \"File 'big.txt' too big\", ERROR_FILE_TOO_BIG );\n\n\t\t# Exactly the maximum size is fine\n\t\t$t_file = $this->createFile( 'max.txt', str_repeat( 'x', 10 ) );\n\t\tfile_ensure_uploaded( $t_file );\n\t}\n\n\t/**\n\t * The antispam check is done first, before any other check.\n\t */\n\tpublic function testAntispamCheckedFirst() {\n\t\t$this->loginAsSpammer();\n\n\t\t$this->assertClientException( array( 'name' => '' ), 'Hit rate limit threshold', ERROR_SPAM_SUSPECTED );\n\t}\n\n\t/**\n\t * Entries for empty file inputs of web forms are removed, others are kept.\n\t */\n\tpublic function testFilterNotSelected() {\n\t\t$t_valid = $this->createFile( 'valid.txt' );\n\t\t$t_not_selected = array( 'name' => '', 'type' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE, 'size' => 0 );\n\t\t$t_api_no_name = array( 'name' => '', 'tmp_name' => '/tmp/x' );\n\t\t$t_failed = array( 'name' => 'a.txt', 'tmp_name' => '', 'error' => UPLOAD_ERR_PARTIAL );\n\n\t\t$t_result = file_filter_not_selected( array( $t_not_selected, $t_valid, $t_api_no_name, $t_failed, $t_not_selected ) );\n\n\t\t$this->assertSame( array( $t_valid, $t_api_no_name, $t_failed ), $t_result );\n\t}\n\n\t/**\n\t * IssueFileAddCommand checks the files during validation, before any file is added.\n\t */\n\tpublic function testIssueFileAddCommandChecksFiles() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array(\n\t\t\t\t$this->createFile( 'good.txt' ),\n\t\t\t\t$this->createFile( 'bad.svg' ),\n\t\t\t) ),\n\t\t);\n\n\t\ttry {\n\t\t\t$t_command = new \\IssueFileAddCommand( $t_data );\n\t\t\t$t_command->execute();\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( ERROR_FILE_NOT_ALLOWED, $e->getCode() );\n\t\t\t$this->assertEquals( \"File 'bad.svg' type not allowed\", $e->getMessage() );\n\t\t}\n\n\t\t$this->assertCount( 0, file_get_visible_attachments( $t_issue_id ), 'No file must be added' );\n\t}\n\n\t/**\n\t * IssueFileAddCommand reports an upload error of the web server.\n\t */\n\tpublic function testIssueFileAddCommandUploadError() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_file = array( 'name' => 'big.txt', 'type' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_INI_SIZE, 'size' => 0 );\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array( $t_file ) ),\n\t\t);\n\n\t\t$this->expectException( ClientException::class );\n\t\t$this->expectExceptionMessage( \"File 'big.txt' too big\" );\n\t\t$this->expectExceptionCode( ERROR_FILE_TOO_BIG );\n\n\t\t$t_command = new \\IssueFileAddCommand( $t_data );\n\t\t$t_command->execute();\n\t}\n\n\t/**\n\t * IssueFileAddCommand ignores empty file inputs, so no file is provided.\n\t */\n\tpublic function testIssueFileAddCommandOnlyEmptyInput() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_file = array( 'name' => '', 'type' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE, 'size' => 0 );\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array( $t_file ) ),\n\t\t);\n\n\t\t$this->expectException( ClientException::class );\n\t\t$this->expectExceptionCode( ERROR_INVALID_FIELD_VALUE );\n\n\t\t$t_command = new \\IssueFileAddCommand( $t_data );\n\t\t$t_command->execute();\n\t}\n\n\t/**\n\t * IssueFileAddCommand adds valid files, with and without the 'error' key.\n\t */\n\tpublic function testIssueFileAddCommandValidFiles() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_api_file = $this->createFile( 'api.txt' );\n\t\tunset( $t_api_file['error'] );\n\t\t$t_api_file['browser_upload'] = false;\n\t\t$t_web_file = $this->createFile( 'web.txt' );\n\t\t$t_web_file['browser_upload'] = false;\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array(\n\t\t\t\t$t_api_file,\n\t\t\t\tarray( 'name' => '', 'type' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE, 'size' => 0 ),\n\t\t\t\t$t_web_file,\n\t\t\t) ),\n\t\t);\n\n\t\t$t_command = new \\IssueFileAddCommand( $t_data );\n\t\t$t_command->execute();\n\n\t\t$this->assertCount( 2, file_get_visible_attachments( $t_issue_id ) );\n\t}\n\n\t/**\n\t * IssueNoteAddCommand checks the files during validation, before the note is added.\n\t */\n\tpublic function testIssueNoteAddCommandChecksFiles() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array(\n\t\t\t\t'text' => 'Note with an empty file',\n\t\t\t\t'files' => array( $this->createFile( 'empty.txt', '' ) ),\n\t\t\t),\n\t\t);\n\n\t\ttry {\n\t\t\t$t_command = new \\IssueNoteAddCommand( $t_data );\n\t\t\t$t_command->execute();\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( ERROR_FILE_NO_UPLOAD_FAILURE, $e->getCode() );\n\t\t\t$this->assertEquals( \"File 'empty.txt' not uploaded\", $e->getMessage() );\n\t\t}\n\n\t\t$this->assertEquals( 0, bugnote_count_by_bug( $t_issue_id ), 'No note must be added' );\n\t}\n\n\t/**\n\t * file_add() does the same checks.\n\t */\n\tpublic function testFileAddChecksFile() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_file = $this->createFile( 'bad.svg' );\n\n\t\ttry {\n\t\t\tfile_add( $t_issue_id, $t_file );\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( ERROR_FILE_NOT_ALLOWED, $e->getCode() );\n\t\t}\n\n\t\t$t_file = $this->createFile( 'test.txt' );\n\t\t$t_file['error'] = UPLOAD_ERR_PARTIAL;\n\t\ttry {\n\t\t\tfile_add( $t_issue_id, $t_file );\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'test.txt' upload failure\", $e->getMessage() );\n\t\t}\n\n\t\t$this->assertCount( 0, file_get_visible_attachments( $t_issue_id ) );\n\t}\n\n\t/**\n\t * Check that file_ensure_uploaded() throws the expected exception.\n\t *\n\t * @param array  $p_file    File array.\n\t * @param string $p_message Expected message.\n\t * @param int    $p_code    Expected error code.\n\t */\n\tprivate function assertClientException( array $p_file, $p_message, $p_code ) {\n\t\ttry {\n\t\t\tfile_ensure_uploaded( $p_file );\n\t\t\t$this->fail( \"Expected ClientException '$p_message'\" );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( $p_message, $e->getMessage() );\n\t\t\t$this->assertEquals( $p_code, $e->getCode() );\n\t\t}\n\t}\n\n\t/**\n\t * Create a temporary file and return its file array, as sent by PHP.\n\t *\n\t * @param string $p_name    File name.\n\t * @param string $p_content File content.\n\t * @return array\n\t */\n\tprivate function createFile( $p_name, $p_content = 'test content' ) {\n\t\t$t_tmp_name = tempnam( sys_get_temp_dir(), 'MantisTest' );\n\t\tfile_put_contents( $t_tmp_name, $p_content );\n\t\t$this->tmpFiles[] = $t_tmp_name;\n\n\t\treturn array(\n\t\t\t'name' => $p_name,\n\t\t\t'type' => 'text/plain',\n\t\t\t'tmp_name' => $t_tmp_name,\n\t\t\t'error' => UPLOAD_ERR_OK,\n\t\t\t'size' => strlen( $p_content ),\n\t\t);\n\t}\n\n\t/**\n\t * Create a test issue.\n\t *\n\t * @return int Issue id\n\t */\n\tprivate function createIssue() {\n\t\t$t_issue = new \\BugData();\n\t\t$t_issue->project_id = 1;\n\t\t$t_issue->summary = __CLASS__ . ': test issue ' . rand( 1, 1000000 );\n\t\t$t_issue->description = 'Test issue for file checks';\n\t\t$t_issue->category_id = 1;\n\n\t\t$t_issue_id = $t_issue->create();\n\t\t$this->issueIds[] = $t_issue_id;\n\t\treturn $t_issue_id;\n\t}\n\n\t/**\n\t * Set a configuration option and remember its old value.\n\t *\n\t * @param string $p_config Option name.\n\t * @param mixed  $p_value  New value.\n\t */\n\tprivate function changeConfig( $p_config, $p_value ) {\n\t\t$t_old = $this->setConfig( $p_config, $p_value );\n\t\tif( !array_key_exists( $p_config, $this->oldConfigs ) ) {\n\t\t\t$this->oldConfigs[$p_config] = $t_old;\n\t\t}\n\t}\n\n\t/**\n\t * Set the global allow_signup option.\n\t *\n\t * @param mixed $p_value New value.\n\t */\n\tprivate function setAllowSignup( $p_value ) {\n\t\tglobal $g_cache_config_eval;\n\t\t$GLOBALS['g_allow_signup'] = $p_value;\n\t\tunset( $g_cache_config_eval['g_allow_signup'] );\n\t}\n\n\t/**\n\t * Log in as a new reporter that has reached the antispam limit.\n\t */\n\tprivate function loginAsSpammer() {\n\t\t$this->oldAllowSignup = config_get_global( 'allow_signup' );\n\t\t$this->setAllowSignup( ON );\n\n\t\t$t_issue_id = $this->createIssue();\n\n\t\t$t_username = 'spam' . rand( 1, 1000000 );\n\t\tuser_create( $t_username, 'password', $t_username . '@localhost.localdomain', REPORTER );\n\t\t$t_user_id = user_get_id_by_name( $t_username );\n\t\t$this->userIds[] = $t_user_id;\n\n\t\t$this->changeConfig( 'default_new_account_access_level', REPORTER );\n\t\t$this->changeConfig( 'antispam_max_event_count', 1 );\n\n\t\thistory_log_event_direct( $t_issue_id, 'summary', 'old', 'new', $t_user_id );\n\n\t\t$this->assertTrue( auth_attempt_script_login( $t_username, 'password' ) );\n\t}\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1182,"cache_read_input_tokens":73376,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1182},"output_tokens":9,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1ca2ce3e-380c-491b-ab5a-8ef2c3322553","uuid":"a4b73f8f-a10a-40de-82a4-7f9e1828ae41","timestamp":"2026-11-01T22:14:45.175Z","request_id":"req_011CgcyfeV44CMxMXCqMs4C3","wire_tool_inputs":{"toolu_01LPZ8vZ3FfgYJvp3XB588qP":{"file_path":"/Users/victor/Repos/unwritten/uw-harness-cases/mantisbt/bench/trees/mantisbt-1-harness/tests/Mantis/FileEnsureUploadedTest.php","content":"<?php\n# MantisBT - A PHP based bugtracking system\n\n# MantisBT is free software: you can redistribute it and/or modify\n# it under the terms of the GNU General Public License as published by\n# the Free Software Foundation, either version 2 of the License, or\n# (at your option) any later version.\n#\n# MantisBT is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU General Public License for more details.\n#\n# You should have received a copy of the GNU General Public License\n# along with MantisBT.  If not, see <http://www.gnu.org/licenses/>.\n\n/**\n * Test cases for the checks on uploaded files (file_ensure_uploaded())\n * and their use by the commands that attach files.\n *\n * @package    Tests\n * @subpackage FileApi\n * @copyright  Copyright MantisBT Team - mantisbt-dev@lists.sourceforge.net\n * @link       http://www.mantisbt.org\n *\n * @noinspection PhpIllegalPsrClassPathInspection\n */\n\nnamespace Mantis\\tests\\Mantis;\n\nuse Mantis\\Exceptions\\ClientException;\n\nrequire_api( 'file_api.php' );\n\n/**\n * PHPUnit tests for file_ensure_uploaded()\n */\nclass FileEnsureUploadedTest extends MantisCoreBase {\n\t/**\n\t * @var string[] Temporary files to delete after the test\n\t */\n\tprivate $tmpFiles = array();\n\n\t/**\n\t * @var int[] Issues to delete after the test\n\t */\n\tprivate $issueIds = array();\n\n\t/**\n\t * @var int[] Users to delete after the test\n\t */\n\tprivate $userIds = array();\n\n\t/**\n\t * @var array Configuration options to restore after the test\n\t */\n\tprivate $oldConfigs = array();\n\n\t/**\n\t * @var mixed|null Old value of the global allow_signup option\n\t */\n\tprivate $oldAllowSignup = null;\n\n\tprotected function setUp(): void {\n\t\tparent::setUp();\n\t\tself::login();\n\t}\n\n\tprotected function tearDown(): void {\n\t\tforeach( $this->oldConfigs as $t_config => $t_value ) {\n\t\t\t$this->restoreConfig( $t_config, $t_value );\n\t\t}\n\n\t\tif( $this->oldAllowSignup !== null ) {\n\t\t\t$this->setAllowSignup( $this->oldAllowSignup );\n\t\t}\n\n\t\tself::login();\n\n\t\tforeach( $this->issueIds as $t_issue_id ) {\n\t\t\tif( bug_exists( $t_issue_id ) ) {\n\t\t\t\tbug_delete( $t_issue_id );\n\t\t\t}\n\t\t}\n\n\t\tforeach( $this->userIds as $t_user_id ) {\n\t\t\tuser_delete( $t_user_id );\n\t\t}\n\n\t\tforeach( $this->tmpFiles as $t_file ) {\n\t\t\tif( file_exists( $t_file ) ) {\n\t\t\t\tunlink( $t_file );\n\t\t\t}\n\t\t}\n\n\t\tparent::tearDown();\n\t}\n\n\t/**\n\t * A valid file passes, with or without the 'error' key.\n\t *\n\t * @doesNotPerformAssertions\n\t */\n\tpublic function testValidFile() {\n\t\t$t_file = $this->createFile( 'valid.txt' );\n\t\tfile_ensure_uploaded( $t_file );\n\n\t\tunset( $t_file['error'] );\n\t\tfile_ensure_uploaded( $t_file );\n\t}\n\n\t/**\n\t * Data provider for testInvalidFile().\n\t *\n\t * Each case: file array modifier, expected message, expected error code.\n\t *\n\t * @return array\n\t */\n\tpublic static function providerInvalidFile() {\n\t\t$t_long_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.txt';\n\n\t\treturn array(\n\t\t\t'name missing' => array(\n\t\t\t\tarray( 'name' => null ),\n\t\t\t\t'File name is empty',\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'name empty' => array(\n\t\t\t\tarray( 'name' => '' ),\n\t\t\t\t'File name is empty',\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'name empty before upload error' => array(\n\t\t\t\tarray( 'name' => '', 'error' => UPLOAD_ERR_NO_FILE ),\n\t\t\t\t'File name is empty',\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'ini size' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_INI_SIZE ),\n\t\t\t\t\"File 'test.txt' too big\",\n\t\t\t\tERROR_FILE_TOO_BIG,\n\t\t\t),\n\t\t\t'form size' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_FORM_SIZE ),\n\t\t\t\t\"File 'test.txt' too big\",\n\t\t\t\tERROR_FILE_TOO_BIG,\n\t\t\t),\n\t\t\t'partial' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_PARTIAL ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'no file' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_NO_FILE ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'no tmp dir' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_NO_TMP_DIR ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'cant write' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_CANT_WRITE ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'extension' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_EXTENSION ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'unknown error code' => array(\n\t\t\t\tarray( 'error' => 99 ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'upload error before name too long' => array(\n\t\t\t\tarray( 'name' => $t_long_name, 'error' => UPLOAD_ERR_PARTIAL ),\n\t\t\t\t\"File '$t_long_name' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'name too long' => array(\n\t\t\t\tarray( 'name' => $t_long_name ),\n\t\t\t\t\"Filename '$t_long_name' is too long\",\n\t\t\t\tERROR_FILE_NAME_TOO_LONG,\n\t\t\t),\n\t\t\t'name too long before type' => array(\n\t\t\t\tarray( 'name' => str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.svg' ),\n\t\t\t\t\"Filename '\" . str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . \".svg' is too long\",\n\t\t\t\tERROR_FILE_NAME_TOO_LONG,\n\t\t\t),\n\t\t\t'type not allowed' => array(\n\t\t\t\tarray( 'name' => 'test.svg' ),\n\t\t\t\t\"File 'test.svg' type not allowed\",\n\t\t\t\tERROR_FILE_NOT_ALLOWED,\n\t\t\t),\n\t\t\t'type before path' => array(\n\t\t\t\tarray( 'name' => 'test.svg', 'tmp_name' => '' ),\n\t\t\t\t\"File 'test.svg' type not allowed\",\n\t\t\t\tERROR_FILE_NOT_ALLOWED,\n\t\t\t),\n\t\t\t'path missing' => array(\n\t\t\t\tarray( 'tmp_name' => null ),\n\t\t\t\t\"File 'test.txt' path is empty\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'path empty' => array(\n\t\t\t\tarray( 'tmp_name' => '' ),\n\t\t\t\t\"File 'test.txt' path is empty\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'not readable' => array(\n\t\t\t\tarray( 'tmp_name' => '/nonexistent/mantis-test-file' ),\n\t\t\t\t\"File 'test.txt' is not readable\",\n\t\t\t\tERROR_UPLOAD_FAILURE,\n\t\t\t),\n\t\t);\n\t}\n\n\t/**\n\t * Each invalid file gives the expected exception.\n\t *\n\t * @dataProvider providerInvalidFile\n\t *\n\t * @param array  $p_changes Changes to apply to a valid file array (null removes the key).\n\t * @param string $p_message Expected exception message.\n\t * @param int    $p_code    Expected error code.\n\t */\n\tpublic function testInvalidFile( array $p_changes, $p_message, $p_code ) {\n\t\t$t_file = $this->createFile( 'test.txt' );\n\t\tforeach( $p_changes as $t_key => $t_value ) {\n\t\t\tif( $t_value === null ) {\n\t\t\t\tunset( $t_file[$t_key] );\n\t\t\t} else {\n\t\t\t\t$t_file[$t_key] = $t_value;\n\t\t\t}\n\t\t}\n\n\t\t$this->assertClientException( $t_file, $p_message, $p_code );\n\t}\n\n\t/**\n\t * An empty file is rejected.\n\t */\n\tpublic function testEmptyFile() {\n\t\t$t_file = $this->createFile( 'empty.txt', '' );\n\t\t$this->assertClientException( $t_file, \"File 'empty.txt' not uploaded\", ERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * A file bigger than the maximum file size is rejected.\n\t */\n\tpublic function testFileTooBig() {\n\t\t$this->changeConfig( 'max_file_size', 10 );\n\t\t$t_file = $this->createFile( 'big.txt', str_repeat( 'x', 11 ) );\n\t\t$this->assertClientException( $t_file, \"File 'big.txt' too big\", ERROR_FILE_TOO_BIG );\n\n\t\t# Exactly the maximum size is fine\n\t\t$t_file = $this->createFile( 'max.txt', str_repeat( 'x', 10 ) );\n\t\tfile_ensure_uploaded( $t_file );\n\t}\n\n\t/**\n\t * The antispam check is done first, before any other check.\n\t */\n\tpublic function testAntispamCheckedFirst() {\n\t\t$this->loginAsSpammer();\n\n\t\t$this->assertClientException( array( 'name' => '' ), 'Hit rate limit threshold', ERROR_SPAM_SUSPECTED );\n\t}\n\n\t/**\n\t * Entries for empty file inputs of web forms are removed, others are kept.\n\t */\n\tpublic function testFilterNotSelected() {\n\t\t$t_valid = $this->createFile( 'valid.txt' );\n\t\t$t_not_selected = array( 'name' => '', 'type' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE, 'size' => 0 );\n\t\t$t_api_no_name = array( 'name' => '', 'tmp_name' => '/tmp/x' );\n\t\t$t_failed = array( 'name' => 'a.txt', 'tmp_name' => '', 'error' => UPLOAD_ERR_PARTIAL );\n\n\t\t$t_result = file_filter_not_selected( array( $t_not_selected, $t_valid, $t_api_no_name, $t_failed, $t_not_selected ) );\n\n\t\t$this->assertSame( array( $t_valid, $t_api_no_name, $t_failed ), $t_result );\n\t}\n\n\t/**\n\t * IssueFileAddCommand checks the files during validation, before any file is added.\n\t */\n\tpublic function testIssueFileAddCommandChecksFiles() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array(\n\t\t\t\t$this->createFile( 'good.txt' ),\n\t\t\t\t$this->createFile( 'bad.svg' ),\n\t\t\t) ),\n\t\t);\n\n\t\ttry {\n\t\t\t$t_command = new \\IssueFileAddCommand( $t_data );\n\t\t\t$t_command->execute();\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( ERROR_FILE_NOT_ALLOWED, $e->getCode() );\n\t\t\t$this->assertEquals( \"File 'bad.svg' type not allowed\", $e->getMessage() );\n\t\t}\n\n\t\t$this->assertCount( 0, file_get_visible_attachments( $t_issue_id ), 'No file must be added' );\n\t}\n\n\t/**\n\t * IssueFileAddCommand reports an upload error of the web server.\n\t */\n\tpublic function testIssueFileAddCommandUploadError() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_file = array( 'name' => 'big.txt', 'type' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_INI_SIZE, 'size' => 0 );\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array( $t_file ) ),\n\t\t);\n\n\t\t$this->expectException( ClientException::class );\n\t\t$this->expectExceptionMessage( \"File 'big.txt' too big\" );\n\t\t$this->expectExceptionCode( ERROR_FILE_TOO_BIG );\n\n\t\t$t_command = new \\IssueFileAddCommand( $t_data );\n\t\t$t_command->execute();\n\t}\n\n\t/**\n\t * IssueFileAddCommand ignores empty file inputs, so no file is provided.\n\t */\n\tpublic function testIssueFileAddCommandOnlyEmptyInput() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_file = array( 'name' => '', 'type' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE, 'size' => 0 );\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array( $t_file ) ),\n\t\t);\n\n\t\t$this->expectException( ClientException::class );\n\t\t$this->expectExceptionCode( ERROR_INVALID_FIELD_VALUE );\n\n\t\t$t_command = new \\IssueFileAddCommand( $t_data );\n\t\t$t_command->execute();\n\t}\n\n\t/**\n\t * IssueFileAddCommand adds valid files, with and without the 'error' key.\n\t */\n\tpublic function testIssueFileAddCommandValidFiles() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_api_file = $this->createFile( 'api.txt' );\n\t\tunset( $t_api_file['error'] );\n\t\t$t_api_file['browser_upload'] = false;\n\t\t$t_web_file = $this->createFile( 'web.txt' );\n\t\t$t_web_file['browser_upload'] = false;\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array(\n\t\t\t\t$t_api_file,\n\t\t\t\tarray( 'name' => '', 'type' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE, 'size' => 0 ),\n\t\t\t\t$t_web_file,\n\t\t\t) ),\n\t\t);\n\n\t\t$t_command = new \\IssueFileAddCommand( $t_data );\n\t\t$t_command->execute();\n\n\t\t$this->assertCount( 2, file_get_visible_attachments( $t_issue_id ) );\n\t}\n\n\t/**\n\t * IssueNoteAddCommand checks the files during validation, before the note is added.\n\t */\n\tpublic function testIssueNoteAddCommandChecksFiles() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array(\n\t\t\t\t'text' => 'Note with an empty file',\n\t\t\t\t'files' => array( $this->createFile( 'empty.txt', '' ) ),\n\t\t\t),\n\t\t);\n\n\t\ttry {\n\t\t\t$t_command = new \\IssueNoteAddCommand( $t_data );\n\t\t\t$t_command->execute();\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( ERROR_FILE_NO_UPLOAD_FAILURE, $e->getCode() );\n\t\t\t$this->assertEquals( \"File 'empty.txt' not uploaded\", $e->getMessage() );\n\t\t}\n\n\t\t$this->assertEquals( 0, bugnote_count_by_bug( $t_issue_id ), 'No note must be added' );\n\t}\n\n\t/**\n\t * file_add() does the same checks.\n\t */\n\tpublic function testFileAddChecksFile() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_file = $this->createFile( 'bad.svg' );\n\n\t\ttry {\n\t\t\tfile_add( $t_issue_id, $t_file );\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( ERROR_FILE_NOT_ALLOWED, $e->getCode() );\n\t\t}\n\n\t\t$t_file = $this->createFile( 'test.txt' );\n\t\t$t_file['error'] = UPLOAD_ERR_PARTIAL;\n\t\ttry {\n\t\t\tfile_add( $t_issue_id, $t_file );\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'test.txt' upload failure\", $e->getMessage() );\n\t\t}\n\n\t\t$this->assertCount( 0, file_get_visible_attachments( $t_issue_id ) );\n\t}\n\n\t/**\n\t * Check that file_ensure_uploaded() throws the expected exception.\n\t *\n\t * @param array  $p_file    File array.\n\t * @param string $p_message Expected message.\n\t * @param int    $p_code    Expected error code.\n\t */\n\tprivate function assertClientException( array $p_file, $p_message, $p_code ) {\n\t\ttry {\n\t\t\tfile_ensure_uploaded( $p_file );\n\t\t\t$this->fail( \"Expected ClientException '$p_message'\" );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( $p_message, $e->getMessage() );\n\t\t\t$this->assertEquals( $p_code, $e->getCode() );\n\t\t}\n\t}\n\n\t/**\n\t * Create a temporary file and return its file array, as sent by PHP.\n\t *\n\t * @param string $p_name    File name.\n\t * @param string $p_content File content.\n\t * @return array\n\t */\n\tprivate function createFile( $p_name, $p_content = 'test content' ) {\n\t\t$t_tmp_name = tempnam( sys_get_temp_dir(), 'MantisTest' );\n\t\tfile_put_contents( $t_tmp_name, $p_content );\n\t\t$this->tmpFiles[] = $t_tmp_name;\n\n\t\treturn array(\n\t\t\t'name' => $p_name,\n\t\t\t'type' => 'text/plain',\n\t\t\t'tmp_name' => $t_tmp_name,\n\t\t\t'error' => UPLOAD_ERR_OK,\n\t\t\t'size' => strlen( $p_content ),\n\t\t);\n\t}\n\n\t/**\n\t * Create a test issue.\n\t *\n\t * @return int Issue id\n\t */\n\tprivate function createIssue() {\n\t\t$t_issue = new \\BugData();\n\t\t$t_issue->project_id = 1;\n\t\t$t_issue->summary = __CLASS__ . ': test issue ' . rand( 1, 1000000 );\n\t\t$t_issue->description = 'Test issue for file checks';\n\t\t$t_issue->category_id = 1;\n\n\t\t$t_issue_id = $t_issue->create();\n\t\t$this->issueIds[] = $t_issue_id;\n\t\treturn $t_issue_id;\n\t}\n\n\t/**\n\t * Set a configuration option and remember its old value.\n\t *\n\t * @param string $p_config Option name.\n\t * @param mixed  $p_value  New value.\n\t */\n\tprivate function changeConfig( $p_config, $p_value ) {\n\t\t$t_old = $this->setConfig( $p_config, $p_value );\n\t\tif( !array_key_exists( $p_config, $this->oldConfigs ) ) {\n\t\t\t$this->oldConfigs[$p_config] = $t_old;\n\t\t}\n\t}\n\n\t/**\n\t * Set the global allow_signup option.\n\t *\n\t * @param mixed $p_value New value.\n\t */\n\tprivate function setAllowSignup( $p_value ) {\n\t\tglobal $g_cache_config_eval;\n\t\t$GLOBALS['g_allow_signup'] = $p_value;\n\t\tunset( $g_cache_config_eval['g_allow_signup'] );\n\t}\n\n\t/**\n\t * Log in as a new reporter that has reached the antispam limit.\n\t */\n\tprivate function loginAsSpammer() {\n\t\t$this->oldAllowSignup = config_get_global( 'allow_signup' );\n\t\t$this->setAllowSignup( ON );\n\n\t\t$t_issue_id = $this->createIssue();\n\n\t\t$t_username = 'spam' . rand( 1, 1000000 );\n\t\tuser_create( $t_username, 'password', $t_username . '@localhost.localdomain', REPORTER );\n\t\t$t_user_id = user_get_id_by_name( $t_username );\n\t\t$this->userIds[] = $t_user_id;\n\n\t\t$this->changeConfig( 'default_new_account_access_level', REPORTER );\n\t\t$this->changeConfig( 'antispam_max_event_count', 1 );\n\n\t\thistory_log_event_direct( $t_issue_id, 'summary', 'old', 'new', $t_user_id );\n\n\t\t$this->assertTrue( auth_attempt_script_login( $t_username, 'password' ) );\n\t}\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LPZ8vZ3FfgYJvp3XB588qP","type":"tool_result","content":"File created successfully at: /Users/victor/Repos/unwritten/uw-harness-cases/mantisbt/bench/trees/mantisbt-1-harness/tests/Mantis/FileEnsureUploadedTest.php (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1ca2ce3e-380c-491b-ab5a-8ef2c3322553","uuid":"7a4c844d-43c1-48e0-b5d8-46870fa1883e","timestamp":"2026-11-01T22:14:45.198Z","tool_use_result":{"type":"create","filePath":"/Users/victor/Repos/unwritten/uw-harness-cases/mantisbt/bench/trees/mantisbt-1-harness/tests/Mantis/FileEnsureUploadedTest.php","content":"<?php\n# MantisBT - A PHP based bugtracking system\n\n# MantisBT is free software: you can redistribute it and/or modify\n# it under the terms of the GNU General Public License as published by\n# the Free Software Foundation, either version 2 of the License, or\n# (at your option) any later version.\n#\n# MantisBT is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU General Public License for more details.\n#\n# You should have received a copy of the GNU General Public License\n# along with MantisBT.  If not, see <http://www.gnu.org/licenses/>.\n\n/**\n * Test cases for the checks on uploaded files (file_ensure_uploaded())\n * and their use by the commands that attach files.\n *\n * @package    Tests\n * @subpackage FileApi\n * @copyright  Copyright MantisBT Team - mantisbt-dev@lists.sourceforge.net\n * @link       http://www.mantisbt.org\n *\n * @noinspection PhpIllegalPsrClassPathInspection\n */\n\nnamespace Mantis\\tests\\Mantis;\n\nuse Mantis\\Exceptions\\ClientException;\n\nrequire_api( 'file_api.php' );\n\n/**\n * PHPUnit tests for file_ensure_uploaded()\n */\nclass FileEnsureUploadedTest extends MantisCoreBase {\n\t/**\n\t * @var string[] Temporary files to delete after the test\n\t */\n\tprivate $tmpFiles = array();\n\n\t/**\n\t * @var int[] Issues to delete after the test\n\t */\n\tprivate $issueIds = array();\n\n\t/**\n\t * @var int[] Users to delete after the test\n\t */\n\tprivate $userIds = array();\n\n\t/**\n\t * @var array Configuration options to restore after the test\n\t */\n\tprivate $oldConfigs = array();\n\n\t/**\n\t * @var mixed|null Old value of the global allow_signup option\n\t */\n\tprivate $oldAllowSignup = null;\n\n\tprotected function setUp(): void {\n\t\tparent::setUp();\n\t\tself::login();\n\t}\n\n\tprotected function tearDown(): void {\n\t\tforeach( $this->oldConfigs as $t_config => $t_value ) {\n\t\t\t$this->restoreConfig( $t_config, $t_value );\n\t\t}\n\n\t\tif( $this->oldAllowSignup !== null ) {\n\t\t\t$this->setAllowSignup( $this->oldAllowSignup );\n\t\t}\n\n\t\tself::login();\n\n\t\tforeach( $this->issueIds as $t_issue_id ) {\n\t\t\tif( bug_exists( $t_issue_id ) ) {\n\t\t\t\tbug_delete( $t_issue_id );\n\t\t\t}\n\t\t}\n\n\t\tforeach( $this->userIds as $t_user_id ) {\n\t\t\tuser_delete( $t_user_id );\n\t\t}\n\n\t\tforeach( $this->tmpFiles as $t_file ) {\n\t\t\tif( file_exists( $t_file ) ) {\n\t\t\t\tunlink( $t_file );\n\t\t\t}\n\t\t}\n\n\t\tparent::tearDown();\n\t}\n\n\t/**\n\t * A valid file passes, with or without the 'error' key.\n\t *\n\t * @doesNotPerformAssertions\n\t */\n\tpublic function testValidFile() {\n\t\t$t_file = $this->createFile( 'valid.txt' );\n\t\tfile_ensure_uploaded( $t_file );\n\n\t\tunset( $t_file['error'] );\n\t\tfile_ensure_uploaded( $t_file );\n\t}\n\n\t/**\n\t * Data provider for testInvalidFile().\n\t *\n\t * Each case: file array modifier, expected message, expected error code.\n\t *\n\t * @return array\n\t */\n\tpublic static function providerInvalidFile() {\n\t\t$t_long_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.txt';\n\n\t\treturn array(\n\t\t\t'name missing' => array(\n\t\t\t\tarray( 'name' => null ),\n\t\t\t\t'File name is empty',\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'name empty' => array(\n\t\t\t\tarray( 'name' => '' ),\n\t\t\t\t'File name is empty',\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'name empty before upload error' => array(\n\t\t\t\tarray( 'name' => '', 'error' => UPLOAD_ERR_NO_FILE ),\n\t\t\t\t'File name is empty',\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'ini size' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_INI_SIZE ),\n\t\t\t\t\"File 'test.txt' too big\",\n\t\t\t\tERROR_FILE_TOO_BIG,\n\t\t\t),\n\t\t\t'form size' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_FORM_SIZE ),\n\t\t\t\t\"File 'test.txt' too big\",\n\t\t\t\tERROR_FILE_TOO_BIG,\n\t\t\t),\n\t\t\t'partial' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_PARTIAL ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'no file' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_NO_FILE ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'no tmp dir' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_NO_TMP_DIR ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'cant write' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_CANT_WRITE ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'extension' => array(\n\t\t\t\tarray( 'error' => UPLOAD_ERR_EXTENSION ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'unknown error code' => array(\n\t\t\t\tarray( 'error' => 99 ),\n\t\t\t\t\"File 'test.txt' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'upload error before name too long' => array(\n\t\t\t\tarray( 'name' => $t_long_name, 'error' => UPLOAD_ERR_PARTIAL ),\n\t\t\t\t\"File '$t_long_name' upload failure\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'name too long' => array(\n\t\t\t\tarray( 'name' => $t_long_name ),\n\t\t\t\t\"Filename '$t_long_name' is too long\",\n\t\t\t\tERROR_FILE_NAME_TOO_LONG,\n\t\t\t),\n\t\t\t'name too long before type' => array(\n\t\t\t\tarray( 'name' => str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.svg' ),\n\t\t\t\t\"Filename '\" . str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . \".svg' is too long\",\n\t\t\t\tERROR_FILE_NAME_TOO_LONG,\n\t\t\t),\n\t\t\t'type not allowed' => array(\n\t\t\t\tarray( 'name' => 'test.svg' ),\n\t\t\t\t\"File 'test.svg' type not allowed\",\n\t\t\t\tERROR_FILE_NOT_ALLOWED,\n\t\t\t),\n\t\t\t'type before path' => array(\n\t\t\t\tarray( 'name' => 'test.svg', 'tmp_name' => '' ),\n\t\t\t\t\"File 'test.svg' type not allowed\",\n\t\t\t\tERROR_FILE_NOT_ALLOWED,\n\t\t\t),\n\t\t\t'path missing' => array(\n\t\t\t\tarray( 'tmp_name' => null ),\n\t\t\t\t\"File 'test.txt' path is empty\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'path empty' => array(\n\t\t\t\tarray( 'tmp_name' => '' ),\n\t\t\t\t\"File 'test.txt' path is empty\",\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE,\n\t\t\t),\n\t\t\t'not readable' => array(\n\t\t\t\tarray( 'tmp_name' => '/nonexistent/mantis-test-file' ),\n\t\t\t\t\"File 'test.txt' is not readable\",\n\t\t\t\tERROR_UPLOAD_FAILURE,\n\t\t\t),\n\t\t);\n\t}\n\n\t/**\n\t * Each invalid file gives the expected exception.\n\t *\n\t * @dataProvider providerInvalidFile\n\t *\n\t * @param array  $p_changes Changes to apply to a valid file array (null removes the key).\n\t * @param string $p_message Expected exception message.\n\t * @param int    $p_code    Expected error code.\n\t */\n\tpublic function testInvalidFile( array $p_changes, $p_message, $p_code ) {\n\t\t$t_file = $this->createFile( 'test.txt' );\n\t\tforeach( $p_changes as $t_key => $t_value ) {\n\t\t\tif( $t_value === null ) {\n\t\t\t\tunset( $t_file[$t_key] );\n\t\t\t} else {\n\t\t\t\t$t_file[$t_key] = $t_value;\n\t\t\t}\n\t\t}\n\n\t\t$this->assertClientException( $t_file, $p_message, $p_code );\n\t}\n\n\t/**\n\t * An empty file is rejected.\n\t */\n\tpublic function testEmptyFile() {\n\t\t$t_file = $this->createFile( 'empty.txt', '' );\n\t\t$this->assertClientException( $t_file, \"File 'empty.txt' not uploaded\", ERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * A file bigger than the maximum file size is rejected.\n\t */\n\tpublic function testFileTooBig() {\n\t\t$this->changeConfig( 'max_file_size', 10 );\n\t\t$t_file = $this->createFile( 'big.txt', str_repeat( 'x', 11 ) );\n\t\t$this->assertClientException( $t_file, \"File 'big.txt' too big\", ERROR_FILE_TOO_BIG );\n\n\t\t# Exactly the maximum size is fine\n\t\t$t_file = $this->createFile( 'max.txt', str_repeat( 'x', 10 ) );\n\t\tfile_ensure_uploaded( $t_file );\n\t}\n\n\t/**\n\t * The antispam check is done first, before any other check.\n\t */\n\tpublic function testAntispamCheckedFirst() {\n\t\t$this->loginAsSpammer();\n\n\t\t$this->assertClientException( array( 'name' => '' ), 'Hit rate limit threshold', ERROR_SPAM_SUSPECTED );\n\t}\n\n\t/**\n\t * Entries for empty file inputs of web forms are removed, others are kept.\n\t */\n\tpublic function testFilterNotSelected() {\n\t\t$t_valid = $this->createFile( 'valid.txt' );\n\t\t$t_not_selected = array( 'name' => '', 'type' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE, 'size' => 0 );\n\t\t$t_api_no_name = array( 'name' => '', 'tmp_name' => '/tmp/x' );\n\t\t$t_failed = array( 'name' => 'a.txt', 'tmp_name' => '', 'error' => UPLOAD_ERR_PARTIAL );\n\n\t\t$t_result = file_filter_not_selected( array( $t_not_selected, $t_valid, $t_api_no_name, $t_failed, $t_not_selected ) );\n\n\t\t$this->assertSame( array( $t_valid, $t_api_no_name, $t_failed ), $t_result );\n\t}\n\n\t/**\n\t * IssueFileAddCommand checks the files during validation, before any file is added.\n\t */\n\tpublic function testIssueFileAddCommandChecksFiles() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array(\n\t\t\t\t$this->createFile( 'good.txt' ),\n\t\t\t\t$this->createFile( 'bad.svg' ),\n\t\t\t) ),\n\t\t);\n\n\t\ttry {\n\t\t\t$t_command = new \\IssueFileAddCommand( $t_data );\n\t\t\t$t_command->execute();\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( ERROR_FILE_NOT_ALLOWED, $e->getCode() );\n\t\t\t$this->assertEquals( \"File 'bad.svg' type not allowed\", $e->getMessage() );\n\t\t}\n\n\t\t$this->assertCount( 0, file_get_visible_attachments( $t_issue_id ), 'No file must be added' );\n\t}\n\n\t/**\n\t * IssueFileAddCommand reports an upload error of the web server.\n\t */\n\tpublic function testIssueFileAddCommandUploadError() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_file = array( 'name' => 'big.txt', 'type' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_INI_SIZE, 'size' => 0 );\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array( $t_file ) ),\n\t\t);\n\n\t\t$this->expectException( ClientException::class );\n\t\t$this->expectExceptionMessage( \"File 'big.txt' too big\" );\n\t\t$this->expectExceptionCode( ERROR_FILE_TOO_BIG );\n\n\t\t$t_command = new \\IssueFileAddCommand( $t_data );\n\t\t$t_command->execute();\n\t}\n\n\t/**\n\t * IssueFileAddCommand ignores empty file inputs, so no file is provided.\n\t */\n\tpublic function testIssueFileAddCommandOnlyEmptyInput() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_file = array( 'name' => '', 'type' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE, 'size' => 0 );\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array( $t_file ) ),\n\t\t);\n\n\t\t$this->expectException( ClientException::class );\n\t\t$this->expectExceptionCode( ERROR_INVALID_FIELD_VALUE );\n\n\t\t$t_command = new \\IssueFileAddCommand( $t_data );\n\t\t$t_command->execute();\n\t}\n\n\t/**\n\t * IssueFileAddCommand adds valid files, with and without the 'error' key.\n\t */\n\tpublic function testIssueFileAddCommandValidFiles() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_api_file = $this->createFile( 'api.txt' );\n\t\tunset( $t_api_file['error'] );\n\t\t$t_api_file['browser_upload'] = false;\n\t\t$t_web_file = $this->createFile( 'web.txt' );\n\t\t$t_web_file['browser_upload'] = false;\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array( 'files' => array(\n\t\t\t\t$t_api_file,\n\t\t\t\tarray( 'name' => '', 'type' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE, 'size' => 0 ),\n\t\t\t\t$t_web_file,\n\t\t\t) ),\n\t\t);\n\n\t\t$t_command = new \\IssueFileAddCommand( $t_data );\n\t\t$t_command->execute();\n\n\t\t$this->assertCount( 2, file_get_visible_attachments( $t_issue_id ) );\n\t}\n\n\t/**\n\t * IssueNoteAddCommand checks the files during validation, before the note is added.\n\t */\n\tpublic function testIssueNoteAddCommandChecksFiles() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $t_issue_id ),\n\t\t\t'payload' => array(\n\t\t\t\t'text' => 'Note with an empty file',\n\t\t\t\t'files' => array( $this->createFile( 'empty.txt', '' ) ),\n\t\t\t),\n\t\t);\n\n\t\ttry {\n\t\t\t$t_command = new \\IssueNoteAddCommand( $t_data );\n\t\t\t$t_command->execute();\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( ERROR_FILE_NO_UPLOAD_FAILURE, $e->getCode() );\n\t\t\t$this->assertEquals( \"File 'empty.txt' not uploaded\", $e->getMessage() );\n\t\t}\n\n\t\t$this->assertEquals( 0, bugnote_count_by_bug( $t_issue_id ), 'No note must be added' );\n\t}\n\n\t/**\n\t * file_add() does the same checks.\n\t */\n\tpublic function testFileAddChecksFile() {\n\t\t$t_issue_id = $this->createIssue();\n\t\t$t_file = $this->createFile( 'bad.svg' );\n\n\t\ttry {\n\t\t\tfile_add( $t_issue_id, $t_file );\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( ERROR_FILE_NOT_ALLOWED, $e->getCode() );\n\t\t}\n\n\t\t$t_file = $this->createFile( 'test.txt' );\n\t\t$t_file['error'] = UPLOAD_ERR_PARTIAL;\n\t\ttry {\n\t\t\tfile_add( $t_issue_id, $t_file );\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'test.txt' upload failure\", $e->getMessage() );\n\t\t}\n\n\t\t$this->assertCount( 0, file_get_visible_attachments( $t_issue_id ) );\n\t}\n\n\t/**\n\t * Check that file_ensure_uploaded() throws the expected exception.\n\t *\n\t * @param array  $p_file    File array.\n\t * @param string $p_message Expected message.\n\t * @param int    $p_code    Expected error code.\n\t */\n\tprivate function assertClientException( array $p_file, $p_message, $p_code ) {\n\t\ttry {\n\t\t\tfile_ensure_uploaded( $p_file );\n\t\t\t$this->fail( \"Expected ClientException '$p_message'\" );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( $p_message, $e->getMessage() );\n\t\t\t$this->assertEquals( $p_code, $e->getCode() );\n\t\t}\n\t}\n\n\t/**\n\t * Create a temporary file and return its file array, as sent by PHP.\n\t *\n\t * @param string $p_name    File name.\n\t * @param string $p_content File content.\n\t * @return array\n\t */\n\tprivate function createFile( $p_name, $p_content = 'test content' ) {\n\t\t$t_tmp_name = tempnam( sys_get_temp_dir(), 'MantisTest' );\n\t\tfile_put_contents( $t_tmp_name, $p_content );\n\t\t$this->tmpFiles[] = $t_tmp_name;\n\n\t\treturn array(\n\t\t\t'name' => $p_name,\n\t\t\t'type' => 'text/plain',\n\t\t\t'tmp_name' => $t_tmp_name,\n\t\t\t'error' => UPLOAD_ERR_OK,\n\t\t\t'size' => strlen( $p_content ),\n\t\t);\n\t}\n\n\t/**\n\t * Create a test issue.\n\t *\n\t * @return int Issue id\n\t */\n\tprivate function createIssue() {\n\t\t$t_issue = new \\BugData();\n\t\t$t_issue->project_id = 1;\n\t\t$t_issue->summary = __CLASS__ . ': test issue ' . rand( 1, 1000000 );\n\t\t$t_issue->description = 'Test issue for file checks';\n\t\t$t_issue->category_id = 1;\n\n\t\t$t_issue_id = $t_issue->create();\n\t\t$this->issueIds[] = $t_issue_id;\n\t\treturn $t_issue_id;\n\t}\n\n\t/**\n\t * Set a configuration option and remember its old value.\n\t *\n\t * @param string $p_config Option name.\n\t * @param mixed  $p_value  New value.\n\t */\n\tprivate function changeConfig( $p_config, $p_value ) {\n\t\t$t_old = $this->setConfig( $p_config, $p_value );\n\t\tif( !array_key_exists( $p_config, $this->oldConfigs ) ) {\n\t\t\t$this->oldConfigs[$p_config] = $t_old;\n\t\t}\n\t}\n\n\t/**\n\t * Set the global allow_signup option.\n\t *\n\t * @param mixed $p_value New value.\n\t */\n\tprivate function setAllowSignup( $p_value ) {\n\t\tglobal $g_cache_config_eval;\n\t\t$GLOBALS['g_allow_signup'] = $p_value;\n\t\tunset( $g_cache_config_eval['g_allow_signup'] );\n\t}\n\n\t/**\n\t * Log in as a new reporter that has reached the antispam limit.\n\t */\n\tprivate function loginAsSpammer() {\n\t\t$this->oldAllowSignup = config_get_global( 'allow_signup' );\n\t\t$this->setAllowSignup( ON );\n\n\t\t$t_issue_id = $this->createIssue();\n\n\t\t$t_username = 'spam' . rand( 1, 1000000 );\n\t\tuser_create( $t_username, 'password', $t_username . '@localhost.localdomain', REPORTER );\n\t\t$t_user_id = user_get_id_by_name( $t_username );\n\t\t$this->userIds[] = $t_user_id;\n\n\t\t$this->changeConfig( 'default_new_account_access_level', REPORTER );\n\t\t$this->changeConfig( 'antispam_max_event_count', 1 );\n\n\t\thistory_log_event_direct( $t_issue_id, 'summary', 'old', 'new', $t_user_id );\n\n\t\t$this->assertTrue( auth_attempt_script_login( $t_username, 'password' ) );\n\t}\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01LPZ8vZ3FfgYJvp3XB588qP","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

pi( 'html_api.php' );\n54\trequire_api( 'lang_api.php' );\n55\trequire_api( 'print_api.php' );\n56\trequire_api( 'utility_api.php' );\n57\t\n58\tform_security_validate( 'proj_doc_update' );\n59\t\n60\t# Check if project documentation feature is enabled.\n61\tif( OFF == config_get( 'enable_project_documentation' ) ||\n62\t\t!file_is_uploading_enabled() ||\n63\t\t!file_allow_project_upload() ) {\n64\t\taccess_denied();\n65\t}\n66\t\n67\t$f_file_id = gpc_get_int( 'file_id' );\n68\t$f_title = gpc_get_string( 'title' );\n69\t$f_description\t= gpc_get_string( 'description' );\n70\t$f_file = gpc_get_file( 'file' );\n71\t\n72\t$t_project_id = file_get_field( $f_file_id, 'project_id', 'project' );\n73\t\n74\taccess_ensure_project_level( config_get( 'upload_project_file_threshold' ), $t_project_id );\n75\t\n76\tif( is_blank( $f_title ) ) {\n77\t\tthrow new ClientException( \"Title is required\",\n78\t\t\tERROR_EMPTY_FIELD,\n79\t\t\t[ lang_get( 'title' ) ]\n80\t\t);\n81\t}\n82\t\n83\t# @todo (thraxisp) this code should probably be integrated into file_api to share methods used to store files\n84\t\n85\tif( isset( $f_file['tmp_name'] ) && is_uploaded_file( $f_file['tmp_name'] ) ) {\n86\t\tfile_ensure_uploaded( $f_file );\n87\t\n88\t\t$t_file_name = $f_file['name'];\n89\t\tif( strlen( $t_file_name ) > DB_FIELD_SIZE_FILENAME ) {\n90\t\t\terror_parameters( $t_file_name );\n91\t\t\ttrigger_error( ERROR_FILE_NAME_TOO_LONG, ERROR );\n92\t\t}\n93\t\n94\t\t$t_project_id = helper_get_current_project();\n95\t\n96\t\t# grab the original file path and name\n97\t\t$t_disk_file_name = file_get_field( $f_file_id, 'diskfile', 'project' );\n98\t\t$t_file_path = dirname( $t_disk_file_name );\n99\t\n100\t\t# prepare variables for insertion\n101\t\t$t_file_size = filesize( $f_file['tmp_name'] );\n102\t\t$t_max_file_size = file_get_max_file_size();\n103\t\tif( $t_file_size > $t_max_file_size ) {\n104\t\t\ttrigger_error( ERROR_FILE_TOO_BIG, ERROR );\n105\t\t}\n106\t\n107\t\t$t_method = config_get( '
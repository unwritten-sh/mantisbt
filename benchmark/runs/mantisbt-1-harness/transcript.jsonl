mime_type( $t_tmp_file );\n938\t\tif( $t_type !== false ) {\n939\t\t\t$p_file['type'] = $t_type;\n940\t\t} else if( !isset( $p_file['type'] ) ) {\n941\t\t\t$p_file['type'] = 'application/octet-stream';\n942\t\t}\n943\t\n944\t\tfile_ensure_uploaded( $p_file );\n945\t\t$t_file_name = $p_file['name'];\n946\t\n947\t\tif( strlen( $t_file_name ) > DB_FIELD_SIZE_FILENAME ) {\n948\t\t\tthrow new ClientException(\n949\t\t\t\tsprintf( \"Filename '%s' is too long\", $t_file_name ),\n950\t\t\t\tERROR_FILE_NAME_TOO_LONG,\n951\t\t\t\tarray( $t_file_name )\n952\t\t\t);\n953\t\t}\n954\t\n955\t\tif( !file_type_check( $t_file_name ) ) {\n956\t\t\tthrow new ClientException(\n957\t\t\t\tsprintf( \"File '%s' type not allowed\", $t_file_name ),\n958\t\t\t\tERROR_FILE_NOT_ALLOWED\n959\t\t\t);\n960\t\t}\n961\t\n962\t\t$t_org_filename = $t_file_name;\n963\t\t$t_suffix_id = 1;\n964\t\n965\t\twhile( !file_is_name_unique( $t_file_name, $p_bug_id ) ) {\n966\t\t\t$t_suffix_id++;\n967\t\n968\t\t\t$t_dot_index = strripos( $t_org_filename, '.' );\n969\t\t\tif( $t_dot_index === false ) {\n970\t\t\t\t$t_file_name = $t_org_filename . '-' . $t_suffix_id;\n971\t\t\t} else {\n972\t\t\t\t$t_extension = substr( $t_org_filename, $t_dot_index, strlen( $t_org_filename ) - $t_dot_index );\n973\t\t\t\t$t_file_name = substr( $t_org_filename, 0, $t_dot_index ) . '-' . $t_suffix_id . $t_extension;\n974\t\t\t}\n975\t\t}\n976\t\n977\t\t$t_file_info['name'] = $t_file_name;\n978\t\tantispam_check();\n979\t\n980\t\t$t_file_size = filesize( $t_tmp_file );\n981\t\tif( 0 == $t_file_size ) {\n982\t\t\tthrow new ClientException(\n983\t\t\t\tsprintf( \"File '%s' not uploaded\", $t_file_name ),\n984\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n985\t\t}\n986\t\n987\t\t$t_file_info['size'] = $t_file_size;\n988\t\n989\t\t$t_max_file_size = (int)min( ini_get_number( 'upload_max_filesize' ), ini_get_number( 'post_max_size' ), config_get( 'max_file_size' ) );\n990\t\tif( $t_file_size > $t_max_file_size ) {\n991\t\t\tthrow new ClientException(\n992\t\t\t\tsprintf( \"File '%s' too big\", $t_file_name ),\n993\t\t\t\tERROR_FILE_TOO_BIG );\n994\t\t}\n995\t\n996\t\tif( 'bug' == $p_table ) {\n997\t\t\t$t_project_id = bug_get_field( $p_bug_id, 'project_id' );\n998\t\t\t$t_id = (int)$p_bug_id;\n999\t\t} else {\n1000\t\t\t$t_project_id = helper_get_current_project();\n1001\t\t\t$t_id = $t_project_id;\n1002\t\t}\n1003\t\n1004\t\tif( $p_user_id === null ) {\n1005\t\t\t$p_user_id = auth_get_current_user_id();\n1006\t\t}\n1007\t\n1008\t\tif( $p_date_added <= 0 ) {\n1009\t\t\t$p_date_added = db_now();\n1010\t\t}\n1011\t\n1012\t\tif( $t_project_id == ALL_PROJECTS ) {\n1013\t\t\t$t_file_path = config_get_global( 'absolute_path_default_upload_folder' );\n1014\t\t} else {\n1015\t\t\t$t_file_path = project_get_field( $t_project_id, 'file_path' );\n1016\t\t\tif( is_blank( $t_file_path ) ) {\n1017\t\t\t\t$t_file_path = config_get_global( 'absolute_path_default_upload_folder' );\n1018\t\t\t}\n1019\t\t}\n1020\t\n1021\t\t$t_unique_name = file_generate_unique_name( $t_file_path );\n1022\t\t$t_method = config_get( 'file_upload_method' );\n1023\t\n1024\t\tswitch( $t_method ) {\n1025\t\t\tcase DISK:\n1026\t\t\t\tfile_ensure_valid_upload_path( $t_file_path );\n1027\t\n1028\t\t\t\t$t_disk_file_name = $t_file_path . $t_unique_name;\n1029\t\t\t\tif( !file_exists( $t_disk_file_name ) ) {\n1030\t\t\t\t\tif( $p_file['browser_upload'] ) {\n1031\t\t\t\t\t\tif( !move_uploaded_file( $t_tmp_file, $t_disk_file_name ) ) {\n1032\t\t\t\t\t\t\tthrow new ServiceException(\n1033\t\t\t\t\t\t\t\t'Unable to move uploaded file',\n1034\t\t\t\t\t\t\t\tERROR_FILE_MOVE_FAILED\n1035\t\t\t\t\t\t\t);\n1036\t\t\t\t\t\t}\n1037\t\t\t\t\t} else {\n1038\t\t\t\t\t\tif( !copy( $t_tmp_file, $t_disk_file_name ) || !unlink( $t_tmp_file ) ) {\n1039\t\t\t\t\t\t\tthrow new ServiceException(\n1040\t\t\t\t\t\t\t\t'Unable to move uploaded file',\n1041\t\t\t\t\t\t\t\tERROR_FILE_MOVE_FAILED\n1042\t\t\t\t\t\t\t);\n1043\t\t\t\t\t\t}\n1044\t\t\t\t\t}\n1045\t\n1046\t\t\t\t\tchmod( $t_disk_file_name, config_get( 'attachments_file_permissions' ) );\n1047\t\n1048\t\t\t\t\t$c_content = '';\n1049\t\t\t\t} else {\n1050\t\t\t\t\tthrow new ClientException( 'Duplicate file', ERROR_FILE_DUPLICATE );\n1051\t\t\t\t}\n1052\t\t\t\tbreak;\n1053\t\t\tcase DATABASE:\n1054\t\t\t\t$c_content = db_prepare_binary_string( fread( fopen( $t_tmp_file, 'rb' ), $t_file_size ) );\n1055\t\t\t\t$t_file_path = '';\n1056\t\t\t\tbreak;\n1057\t\t\tdefault:\n1058\t\t\t\tthrow new ServiceException( 'Unknown file upload method', ERROR_GENERIC );\n1059\t\t}\n1060\t\n1061\t\t$t_file_table = db_get_table( $p_table . '_file' );\n1062\t\t$t_id_col = $p_table . '_id';\n1063\t\n1064\t\tdb_param_push();\n1065\t\n1066\t\t$t_param = array(\n1067\t\t\t$t_id_col     => $t_id,\n1068\t\t\t'title'       => $p_title,\n1069\t\t\t'description' => $p_desc,\n1070\t\t\t'diskfile'    => $t_unique_name,\n1071\t\t\t'filename'    => $t_file_name,\n1072\t\t\t'folder'      => $t_file_path,\n1073\t\t\t'filesize'    => $t_file_size,\n1074\t\t\t'file_type'   => $p_file['type'],\n1075\t\t\t'date_added'  => $p_date_added,\n1076\t\t\t'user_id'     => (int)$p_user_id\n1077\t\t);\n1078\t\tif( 'bug' == $p_table ) {\n1079\t\t\t$t_param['bugnote_id'] = is_null( $p_bugnote_id ) ? null : (int)$p_bugnote_id;\n1080\t\t}\n1081\t\t# Oracle has to update BLOBs separately\n1082\t\tif( !db_is_oracle() ) {\n1083\t\t\t$t_param['content'] = $c_content;\n1084\t\t}\n1085\t\n1086\t\t$t_query_param = db_param();\n1087\t\tfor( $i = 1; $i < count( $t_param ); $i++ ) {\n1088\t\t\t$t_query_param .= ', ' . db_param();\n1089\t\t}\n1090\t\n1091\t\t$t_query = 'INSERT INTO ' . $t_file_table . '\n1092\t\t\t( ' . implode( ', ', array_keys( $t_param ) ) . ' )\n1093\t\tVALUES\n1094\t\t\t( ' . $t_query_param . ' )';\n1095\t\tdb_query( $t_query, array_values( $t_param ) );\n1096\t\n1097\t\t$t_file_info['id'] = db_insert_id( $t_file_table );\n1098\t\n1099\t\tif( db_is_oracle() ) {\n1100\t\t\tdb_update_blob( $t_file_table, 'content', $c_content, \"diskfile='$t_unique_name'\" );\n1101\t\t}\n1102\t\n1103\t\tif( 'bug' == $p_table ) {\n1104\t\t\t# update the last_updated date\n1105\t\t\tif( !$p_skip_bug_update ) {\n1106\t\t\t\tbug_update_date( $p_bug_id );\n1107\t\t\t}\n1108\t\n1109\t\t\t# log file added to bug history\n1110\t\t\thistory_log_event_special( $p_bug_id, FILE_ADDED, $t_file_name, $p_bugnote_id );\n1111\t\t}\n1112\t\n1113\t\treturn $t_file_info;\n1114\t}\n1115\t\n1116\t/**\n1117\t * Return true if file uploading is enabled, false otherwise.\n1118\t *\n1119\t * Checks both our config and PHP's.\n1120\t *\n1121\t * @return bool\n1122\t */\n1123\tfunction file_is_uploading_enabled() {\n1124\t\treturn ini_get_bool( 'file_uploads' )\n1125\t\t\t&& ( ON == config_get( 'allow_file_upload' ) );\n1126\t}\n1127\t\n1128\t/**\n1129\t * Check if the user can upload files for this project.\n1130\t *\n1131\t * the project defaults to the current project and the user to the current user\n1132\t *\n1133\t * @param int $p_project_id A project identifier.\n1134\t * @param int $p_user_id    A user identifier.\n1135\t *\n1136\t * @return bool True if user can upload, false otherwise\n1137\t * @throws ClientException\n1138\t */\n1139\tfunction file_allow_project_upload( $p_project_id = null, $p_user_id = null ) {\n1140\t\tif( null === $p_project_id ) {\n1141\t\t\t$p_project_id = helper_get_current_project();\n1142\t\t}\n1143\t\tif( null === $p_user_id ) {\n1144\t\t\t$p_user_id = auth_get_current_user_id();\n1145\t\t}\n1146\t\treturn( file_is_uploading_enabled() && ( access_has_project_level( config_get( 'upload_project_file_threshold' ), $p_project_id, $p_user_id ) ) );\n1147\t}\n1148\t\n1149\t/**\n1150\t * Check if the user can upload files for this bug.\n1151\t *\n1152\t * If the bug Id is null (default) we check whether the user can upload a file\n1153\t * to a new bug in the project.\n1154\t *\n1155\t * @param int $p_bug_id     A bug identifier.\n1156\t * @param int $p_user_id    A user identifier or null for the current user (default).\n1157\t * @param int $p_project_id The project id to check for or null for bug\n1158\t *                          project or current project.\n1159\t *\n1160\t * @return bool True if user can upload files, false otherwise.\n1161\t * @throws ClientException\n1162\t */\n1163\tfunction file_allow_bug_upload( $p_bug_id = null, $p_user_id = null, $p_project_id = null ) {\n1164\t\tif( null === $p_user_id ) {\n1165\t\t\t$p_user_id = auth_get_current_user_id();\n1166\t\t}\n1167\t\n1168\t\t# If uploads are disabled just return false\n1169\t\tif( !file_is_uploading_enabled() ) {\n1170\t\t\treturn false;\n1171\t\t}\n1172\t\n1173\t\tif( null === $p_bug_id ) {\n1174\t\t\t# new bug\n1175\t\t\t$t_project_id = $p_project_id === null ? helper_get_current_project() : $p_project_id;\n1176\t\n1177\t\t\t# the user must be the reporter if they're reporting a new bug\n1178\t\t\t$t_reporter = true;\n1179\t\t} else {\n1180\t\t\t# existing bug\n1181\t\t\t$t_project_id = bug_get_field( $p_bug_id, 'project_id' );\n1182\t\n1183\t\t\t# check if the user is the reporter of the bug\n1184\t\t\t$t_reporter = bug_is_user_reporter( $p_bug_id, $p_user_id );\n1185\t\t}\n1186\t\n1187\t\tif( $t_reporter && ( ON == config_get( 'allow_reporter_upload' ) ) ) {\n1188\t\t\treturn true;\n1189\t\t}\n1190\t\n1191\t\t# Check the access level against the config setting\n1192\t\t$t_upload_bug_file_threshold = config_get( 'upload_bug_file_threshold' );\n1193\t\tif( null !== $p_bug_id ) {\n1194\t\t\t# Existing issue: if user can't view it, then they can't add attachments\n1195\t\t\treturn access_has_bug_level( $t_upload_bug_file_threshold, $p_bug_id, $p_user_id );\n1196\t\t}\n1197\t\t# New issue - check against project\n1198\t\treturn access_has_project_level( $t_upload_bug_file_threshold, $t_project_id, $p_user_id );\n1199\t}\n1200\t\n1201\t/**\n1202\t * Checks whether the specified upload path exists and is writable.\n1203\t *\n1204\t * @param string $p_upload_path Upload path.\n1205\t *\n1206\t * @return void\n1207\t * @throws ServiceException\n1208\t */\n1209\tfunction file_ensure_valid_upload_path( $p_upload_path ) {\n1210\t\tif( !file_exists( $p_upload_path ) || !is_dir( $p_upload_path ) || !is_writable( $p_upload_path ) || !is_readable( $p_upload_path ) ) {\n1211\t\t\tthrow new ServiceException(\n1212\t\t\t\t'Upload folder not valid',\n1213\t\t\t\tERROR_FILE_INVALID_UPLOAD_PATH );\n1214\t\t}\n1215\t}\n1216\t\n1217\t/**\n1218\t * Ensure a file was uploaded.\n1219\t *\n1220\t * This function perform various checks for determining if the upload was\n1221\t * successful.\n1222\t *\n1223\t * @param array $p_file The uploaded file info, as retrieved from\n1224\t *                      gpc_get_file().\n1225\t *\n1226\t * @return void\n1227\t * @throws ClientException\n1228\t */\n1229\tfunction file_ensure_uploaded( array $p_file ) {\n1230\t\tswitch( $p_file['error'] ) {\n1231\t\t\tcase UPLOAD_ERR_INI_SIZE:\n1232\t\t\tcase UPLOAD_ERR_FORM_SIZE:\n1233\t\t\t\tthrow new ClientException(\n1234\t\t\t\t\tsprintf( \"File '%s' too big\", $p_file['name'] ),\n1235\t\t\t\t\tERROR_FILE_TOO_BIG );\n1236\t\n1237\t\t\tcase UPLOAD_ERR_PARTIAL:\n1238\t\t\tcase UPLOAD_ERR_NO_FILE:\n1239\t\t\t\tthrow new ClientException(\n1240\t\t\t\t\tsprintf( \"File '%s' upload failure\", $p_file['name'] ),\n1241\t\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n1242\t\t}\n1243\t\n1244\t\tif( ( '' == $p_file['tmp_name'] ) || ( '' == $p_file['name'] ) ) {\n1245\t\t\tthrow new ClientException(\n1246\t\t\t\t'File name or path is empty',\n1247\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n1248\t\t}\n1249\t\n1250\t\tif( !is_readable( $p_file['tmp_name'] ) ) {\n1251\t\t\tthrow new ClientException( 'File is not readable', ERROR_UPLOAD_FAILURE );\n1252\t\t}\n1253\t}\n1254\t\n1255\t/**\n1256\t * Return instance of fileinfo class.\n1257\t *\n1258\t * @return finfo instance of finfo class.\n1259\t */"}]},"parent_tool_use_id":null,"session_id":"1ca2ce3e-380c-491b-ab5a-8ef2c3322553","uuid":"e5765f47-1896-46ec-a876-086b8f64df50","timestamp":"2026-11-01T22:11:06.855Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/victor/Repos/unwritten/uw-harness-cases/mantisbt/bench/trees/mantisbt-1-harness/core/file_api.php","content":" *                                  doc).\n * @param array  $p_file            The uploaded file info, as retrieved from\n *                                  gpc_get_file().\n * @param string $p_table           Either 'bug' or 'project' depending on\n *                                  attachment type.\n * @param string $p_title           File title.\n * @param string $p_desc            File description.\n * @param int    $p_user_id         User id (defaults to current user).\n * @param int    $p_date_added      Date added.\n * @param bool   $p_skip_bug_update Skip bug last modification update (useful\n *                                  when importing bug attachments).\n * @param int    $p_bugnote_id      The bugnote id or 0 if associated with the\n *                                  issue.\n *\n * @return array The file info array (keys: name, size)\n * @throws ClientException\n * @throws ServiceException\n * @throws Exception\n */\nfunction file_add( $p_bug_id, array $p_file, $p_table = 'bug', $p_title = '', $p_desc = '', $p_user_id = null, $p_date_added = 0, $p_skip_bug_update = false, $p_bugnote_id = 0 ) {\n\t$t_file_info = array();\n\n\tif( !isset( $p_file['error'] ) ) {\n\t\t$p_file['error'] = UPLOAD_ERR_OK;\n\t}\n\n\tif( !isset( $p_file['browser_upload'] ) ) {\n\t\t$p_file['browser_upload'] = true;\n\t}\n\n\t$t_tmp_file = $p_file['tmp_name'];\n\n\t# Override passed value with one detected by PHP (if available).\n\t# If PHP can't detect it, then use supplied value.\n\t# If no value supplied, then default to a reasonable value.\n\t# The value will be overridden by PHP anyway if content type is\n\t# known at rendering time.\n\t$t_type = file_get_mime_type( $t_tmp_file );\n\tif( $t_type !== false ) {\n\t\t$p_file['type'] = $t_type;\n\t} else if( !isset( $p_file['type'] ) ) {\n\t\t$p_file['type'] = 'application/octet-stream';\n\t}\n\n\tfile_ensure_uploaded( $p_file );\n\t$t_file_name = $p_file['name'];\n\n\tif( strlen( $t_file_name ) > DB_FIELD_SIZE_FILENAME ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"Filename '%s' is too long\", $t_file_name ),\n\t\t\tERROR_FILE_NAME_TOO_LONG,\n\t\t\tarray( $t_file_name )\n\t\t);\n\t}\n\n\tif( !file_type_check( $t_file_name ) ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"File '%s' type not allowed\", $t_file_name ),\n\t\t\tERROR_FILE_NOT_ALLOWED\n\t\t);\n\t}\n\n\t$t_org_filename = $t_file_name;\n\t$t_suffix_id = 1;\n\n\twhile( !file_is_name_unique( $t_file_name, $p_bug_id ) ) {\n\t\t$t_suffix_id++;\n\n\t\t$t_dot_index = strripos( $t_org_filename, '.' );\n\t\tif( $t_dot_index === false ) {\n\t\t\t$t_file_name = $t_org_filename . '-' . $t_suffix_id;\n\t\t} else {\n\t\t\t$t_extension = substr( $t_org_filename, $t_dot_index, strlen( $t_org_filename ) - $t_dot_index );\n\t\t\t$t_file_name = substr( $t_org_filename, 0, $t_dot_index ) . '-' . $t_suffix_id . $t_extension;\n\t\t}\n\t}\n\n\t$t_file_info['name'] = $t_file_name;\n\tantispam_check();\n\n\t$t_file_size = filesize( $t_tmp_file );\n\tif( 0 == $t_file_size ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"File '%s' not uploaded\", $t_file_name ),\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t$t_file_info['size'] = $t_file_size;\n\n\t$t_max_file_size = (int)min( ini_get_number( 'upload_max_filesize' ), ini_get_number( 'post_max_size' ), config_get( 'max_file_size' ) );\n\tif( $t_file_size > $t_max_file_size ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"File '%s' too big\", $t_file_name ),\n\t\t\tERROR_FILE_TOO_BIG );\n\t}\n\n\tif( 'bug' == $p_table ) {\n\t\t$t_project_id = bug_get_field( $p_bug_id, 'project_id' );\n\t\t$t_id = (int)$p_bug_id;\n\t} else {\n\t\t$t_project_id = helper_get_current_project();\n\t\t$t_id = $t_project_id;\n\t}\n\n\tif( $p_user_id === null ) {\n\t\t$p_user_id = auth_get_current_user_id();\n\t}\n\n\tif( $p_date_added <= 0 ) {\n\t\t$p_date_added = db_now();\n\t}\n\n\tif( $t_project_id == ALL_PROJECTS ) {\n\t\t$t_file_path = config_get_global( 'absolute_path_default_upload_folder' );\n\t} else {\n\t\t$t_file_path = project_get_field( $t_project_id, 'file_path' );\n\t\tif( is_blank( $t_file_path ) ) {\n\t\t\t$t_file_path = config_get_global( 'absolute_path_default_upload_folder' );\n\t\t}\n\t}\n\n\t$t_unique_name = file_generate_unique_name( $t_file_path );\n\t$t_method = config_get( 'file_upload_method' );\n\n\tswitch( $t_method ) {\n\t\tcase DISK:\n\t\t\tfile_ensure_valid_upload_path( $t_file_path );\n\n\t\t\t$t_disk_file_name = $t_file_path . $t_unique_name;\n\t\t\tif( !file_exists( $t_disk_file_name ) ) {\n\t\t\t\tif( $p_file['browser_upload'] ) {\n\t\t\t\t\tif( !move_uploaded_file( $t_tmp_file, $t_disk_file_name ) ) {\n\t\t\t\t\t\tthrow new ServiceException(\n\t\t\t\t\t\t\t'Unable to move uploaded file',\n\t\t\t\t\t\t\tERROR_FILE_MOVE_FAILED\n\t\t\t\t\t\t);\n\t\t\t\t\t}\n\t\t\t\t} else {\n\t\t\t\t\tif( !copy( $t_tmp_file, $t_disk_file_name ) || !unlink( $t_tmp_file ) ) {\n\t\t\t\t\t\tthrow new ServiceException(\n\t\t\t\t\t\t\t'Unable to move uploaded file',\n\t\t\t\t\t\t\tERROR_FILE_MOVE_FAILED\n\t\t\t\t\t\t);\n\t\t\t\t\t}\n\t\t\t\t}\n\n\t\t\t\tchmod( $t_disk_file_name, config_get( 'attachments_file_permissions' ) );\n\n\t\t\t\t$c_content = '';\n\t\t\t} else {\n\t\t\t\tthrow new ClientException( 'Duplicate file', ERROR_FILE_DUPLICATE );\n\t\t\t}\n\t\t\tbreak;\n\t\tcase DATABASE:\n\t\t\t$c_content = db_prepare_binary_string( fread( fopen( $t_tmp_file, 'rb' ), $t_file_size ) );\n\t\t\t$t_file_path = '';\n\t\t\tbreak;\n\t\tdefault:\n\t\t\tthrow new ServiceException( 'Unknown file upload method', ERROR_GENERIC );\n\t}\n\n\t$t_file_table = db_get_table( $p_table . '_file' );\n\t$t_id_col = $p_table . '_id';\n\n\tdb_param_push();\n\n\t$t_param = array(\n\t\t$t_id_col     => $t_id,\n\t\t'title'       => $p_title,\n\t\t'description' => $p_desc,\n\t\t'diskfile'    => $t_unique_name,\n\t\t'filename'    => $t_file_name,\n\t\t'folder'      => $t_file_path,\n\t\t'filesize'    => $t_file_size,\n\t\t'file_type'   => $p_file['type'],\n\t\t'date_added'  => $p_date_added,\n\t\t'user_id'     => (int)$p_user_id\n\t);\n\tif( 'bug' == $p_table ) {\n\t\t$t_param['bugnote_id'] = is_null( $p_bugnote_id ) ? null : (int)$p_bugnote_id;\n\t}\n\t# Oracle has to update BLOBs separately\n\tif( !db_is_oracle() ) {\n\t\t$t_param['content'] = $c_content;\n\t}\n\n\t$t_query_param = db_param();\n\tfor( $i = 1; $i < count( $t_param ); $i++ ) {\n\t\t$t_query_param .= ', ' . db_param();\n\t}\n\n\t$t_query = 'INSERT INTO ' . $t_file_table . '\n\t\t( ' . implode( ', ', array_keys( $t_param ) ) . ' )\n\tVALUES\n\t\t( ' . $t_query_param . ' )';\n\tdb_query( $t_query, array_values( $t_param ) );\n\n\t$t_file_info['id'] = db_insert_id( $t_file_table );\n\n\tif( db_is_oracle() ) {\n\t\tdb_update_blob( $t_file_table, 'content', $c_content, \"diskfile='$t_unique_name'\" );\n\t}\n\n\tif( 'bug' == $p_table ) {\n\t\t# update the last_updated date\n\t\tif( !$p_skip_bug_update ) {\n\t\t\tbug_update_date( $p_bug_id );\n\t\t}\n\n\t\t# log file added to bug history\n\t\thistory_log_event_special( $p_bug_id, FILE_ADDED, $t_file_name, $p_bugnote_id );\n\t}\n\n\treturn $t_file_info;\n}\n\n/**\n * Return true if file uploading is enabled, false otherwise.\n *\n * Checks both our config and PHP's.\n *\n * @return bool\n */\nfunction file_is_uploading_enabled() {\n\treturn ini_get_bool( 'file_uploads' )\n\t\t&& ( ON == config_get( 'allow_file_upload' ) );\n}\n\n/**\n * Check if the user can upload files for this project.\n *\n * the project defaults to the current project and the user to the current user\n *\n * @param int $p_project_id A project identifier.\n * @param int $p_user_id    A user identifier.\n *\n * @return bool True if user can upload, false otherwise\n * @throws ClientException\n */\nfunction file_allow_project_upload( $p_project_id = null, $p_user_id = null ) {\n\tif( null === $p_project_id ) {\n\t\t$p_project_id = helper_get_current_project();\n\t}\n\tif( null === $p_user_id ) {\n\t\t$p_user_id = auth_get_current_user_id();\n\t}\n\treturn( file_is_uploading_enabled() && ( access_has_project_level( config_get( 'upload_project_file_threshold' ), $p_project_id, $p_user_id ) ) );\n}\n\n/**\n * Check if the user can upload files for this bug.\n *\n * If the bug Id is null (default) we check whether the user can upload a file\n * to a new bug in the project.\n *\n * @param int $p_bug_id     A bug identifier.\n * @param int $p_user_id    A user identifier or null for the current user (default).\n * @param int $p_project_id The project id to check for or null for bug\n *                          project or current project.\n *\n * @return bool True if user can upload files, false otherwise.\n * @throws ClientException\n */\nfunction file_allow_bug_upload( $p_bug_id = null, $p_user_id = null, $p_project_id = null ) {\n\tif( null === $p_user_id ) {\n\t\t$p_user_id = auth_get_current_user_id();\n\t}\n\n\t# If uploads are disabled just return false\n\tif( !file_is_uploading_enabled() ) {\n\t\treturn false;\n\t}\n\n\tif( null === $p_bug_id ) {\n\t\t# new bug\n\t\t$t_project_id = $p_project_id === null ? helper_get_current_project() : $p_project_id;\n\n\t\t# the user must be the reporter if they're reporting a new bug\n\t\t$t_reporter = true;\n\t} else {\n\t\t# existing bug\n\t\t$t_project_id = bug_get_field( $p_bug_id, 'project_id' );\n\n\t\t# check if the user is the reporter of the bug\n\t\t$t_reporter = bug_is_user_reporter( $p_bug_id, $p_user_id );\n\t}\n\n\tif( $t_reporter && ( ON == config_get( 'allow_reporter_upload' ) ) ) {\n\t\treturn true;\n\t}\n\n\t# Check the access level against the config setting\n\t$t_upload_bug_file_threshold = config_get( 'upload_bug_file_threshold' );\n\tif( null !== $p_bug_id ) {\n\t\t# Existing issue: if user can't view it, then they can't add attachments\n\t\treturn access_has_bug_level( $t_upload_bug_file_threshold, $p_bug_id, $p_user_id );\n\t}\n\t# New issue - check against project\n\treturn access_has_project_level( $t_upload_bug_file_threshold, $t_project_id, $p_user_id );\n}\n\n/**\n * Checks whether the specified upload path exists and is writable.\n *\n * @param string $p_upload_path Upload path.\n *\n * @return void\n * @throws ServiceException\n */\nfunction file_ensure_valid_upload_path( $p_upload_path ) {\n\tif( !file_exists( $p_upload_path ) || !is_dir( $p_upload_path ) || !is_writable( $p_upload_path ) || !is_readable( $p_upload_path ) ) {\n\t\tthrow new ServiceException(\n\t\t\t'Upload folder not valid',\n\t\t\tERROR_FILE_INVALID_UPLOAD_PATH );\n\t}\n}\n\n/**\n * Ensure a file was uploaded.\n *\n * This function perform various checks for determining if the upload was\n * successful.\n *\n * @param array $p_file The uploaded file info, as retrieved from\n *                      gpc_get_file().\n *\n * @return void\n * @throws ClientException\n */\nfunction file_ensure_uploaded( array $p_file ) {\n\tswitch( $p_file['error'] ) {\n\t\tcase UPLOAD_ERR_INI_SIZE:\n\t\tcase UPLOAD_ERR_FORM_SIZE:\n\t\t\tthrow new ClientException(\n\t\t\t\tsprintf( \"File '%s' too big\", $p_file['name'] ),\n\t\t\t\tERROR_FILE_TOO_BIG );\n\n\t\tcase UPLOAD_ERR_PARTIAL:\n\t\tcase UPLOAD_ERR_NO_FILE:\n\t\t\tthrow new ClientException(\n\t\t\t\tsprintf( \"File '%s' upload failure\", $p_file['name'] ),\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\tif( ( '' == $p_file['tmp_name'] ) || ( '' == $p_file['name'] ) ) {\n\t\tthrow new ClientException(\n\t\t\t'File name or path is empty',\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\tif( !is_readable( $p_file['tmp_name'] ) ) {\n\t\tthrow new ClientException( 'File is not readable', ERROR_UPLOAD_FAILURE );\n\t}\n}\n\n/**\n * Return instance of fileinfo class.\n *\n * @return finfo instance of finfo class.\n */","numLines":360,"startLine":900,"totalLines":1545}},"tool_result_meta":[{"id":"toolu_01VUwkqzupjHbu9YbGaDT4TB","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

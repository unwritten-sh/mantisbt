goryDeleteCommand( $t_data );\n\t\t\ttry {\n\t\t\t\t$t_command->execute();\n\t\t\t\t$this->fail( 'The default category must not be deleted.' );\n\t\t\t} catch( ClientException $e ) {\n\t\t\t\t$this->assertEquals( ERROR_CATEGORY_CANNOT_UPDATE_DEFAULT, $e->getCode() );\n\t\t\t}\n\n\t\t\t$this->assertTrue( category_exists( $t_category_id ) );\n\t\t} finally {\n\t\t\tif( $t_had_database_value ) {\n\t\t\t\tconfig_set( 'default_category_for_moves', $t_old_value, ALL_USERS, ALL_PROJECTS );\n\t\t\t} else {\n\t\t\t\tconfig_delete( 'default_category_for_moves', ALL_USERS, ALL_PROJECTS );\n\t\t\t}\n\t\t\tcategory_remove( $t_category_id );\n\t\t}\n\t}\n\n\t/**\n\t * Test that a category of a project cannot be deleted through ALL_PROJECTS.\n\t *\n\t * @return void\n\t */\n\tpublic function testCannotDeleteProjectCategoryThroughAllProjects() {\n\t\tself::login();\n\t\t$t_category_id = category_add( 1, 'command project category ' . rand( 1, 1000000 ) );\n\n\t\ttry {\n\t\t\t$t_data = [ 'query' => [\n\t\t\t\t'project_id' => ALL_PROJECTS,\n\t\t\t\t'category_id' => $t_category_id,\n\t\t\t] ];\n\t\t\t$t_command = new \\CategoryDeleteCommand( $t_data );\n\t\t\ttry {\n\t\t\t\t$t_command->execute();\n\t\t\t\t$this->fail( 'A project category must not be found in ALL_PROJECTS.' );\n\t\t\t} catch( ClientException $e ) {\n\t\t\t\t$this->assertEquals( ERROR_CATEGORY_NOT_FOUND, $e->getCode() );\n\t\t\t}\n\n\t\t\t$this->assertTrue( category_exists( $t_category_id ) );\n\t\t} finally {\n\t\t\tcategory_remove( $t_category_id );\n\t\t}\n\t}\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":305,"cache_read_input_tokens":59543,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":305},"output_tokens":56,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgczRQEXF5aCVwZgoEEEL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01AWBPektu2kZUv6nDsqJZkH","name":"Write","input":{"file_path":"/Users/victor/Repos/unwritten/uw-harness-cases/mantisbt/bench/trees/mantisbt-1-control/tests/Mantis/FileUploadCheckTest.php","content":"<?php\n# MantisBT - A PHP based bugtracking system\n\n# MantisBT is free software: you can redistribute it and/or modify\n# it under the terms of the GNU General Public License as published by\n# the Free Software Foundation, either version 2 of the License, or\n# (at your option) any later version.\n#\n# MantisBT is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU General Public License for more details.\n#\n# You should have received a copy of the GNU General Public License\n# along with MantisBT.  If not, see <http://www.gnu.org/licenses/>.\n\n/**\n * Test cases for the checks on uploaded files (file_ensure_uploaded) and\n * their use in file_add() and the issue, issue file and issue note commands.\n *\n * @package    Tests\n * @subpackage FileApi\n * @copyright  Copyright MantisBT Team - mantisbt-dev@lists.sourceforge.net\n * @link       http://www.mantisbt.org\n *\n * @noinspection PhpIllegalPsrClassPathInspection\n */\n\nnamespace Mantis\\tests\\Mantis;\n\nuse Mantis\\Exceptions\\ClientException;\n\n/**\n * PHPUnit tests for uploaded file checks\n */\nclass FileUploadCheckTest extends MantisCoreBase {\n\t/**\n\t * @var int Test issue id\n\t */\n\tprivate $issueId;\n\n\t/**\n\t * @var string[] Temporary files to delete in tearDown\n\t */\n\tprivate $tmpFiles = array();\n\n\t/**\n\t * @var array Configs to restore in tearDown (name => old value)\n\t */\n\tprivate $configs = array();\n\n\t/**\n\t * Create a test issue.\n\t */\n\tprotected function setUp(): void {\n\t\tparent::setUp();\n\t\tself::login();\n\n\t\t$t_issue_data = new \\BugData();\n\t\t$t_issue_data->project_id = 1;\n\t\t$t_issue_data->summary = __CLASS__ . ': test issue ' . rand( 1, 1000000 );\n\t\t$t_issue_data->description = 'Test issue for uploaded file checks';\n\t\t$t_issue_data->category_id = 1;\n\n\t\t$this->issueId = $t_issue_data->create();\n\t}\n\n\t/**\n\t * Delete the test issue, temporary files and restore configs.\n\t */\n\tprotected function tearDown(): void {\n\t\tforeach( $this->configs as $t_config => $t_value ) {\n\t\t\t$this->restoreConfig( $t_config, $t_value );\n\t\t}\n\t\tbug_delete( $this->issueId );\n\t\tforeach( $this->tmpFiles as $t_file ) {\n\t\t\tif( file_exists( $t_file ) ) {\n\t\t\t\tunlink( $t_file );\n\t\t\t}\n\t\t}\n\t}\n\n\t/**\n\t * Set a config for the duration of the test.\n\t *\n\t * @param string $p_config Config name.\n\t * @param mixed  $p_value  Config value.\n\t */\n\tprivate function setTestConfig( $p_config, $p_value ) {\n\t\tif( !array_key_exists( $p_config, $this->configs ) ) {\n\t\t\t$this->configs[$p_config] = $this->setConfig( $p_config, $p_value );\n\t\t} else {\n\t\t\tconfig_set( $p_config, $p_value );\n\t\t}\n\t}\n\n\t/**\n\t * Create a temporary file.\n\t *\n\t * @param string $p_content File content.\n\t * @return string The file path.\n\t */\n\tprivate function makeTmpFile( $p_content = 'some content' ) {\n\t\t$t_path = tempnam( sys_get_temp_dir(), 'mantisbt-test' );\n\t\tfile_put_contents( $t_path, $p_content );\n\t\t$this->tmpFiles[] = $t_path;\n\t\treturn $t_path;\n\t}\n\n\t/**\n\t * Build a valid file info array, as sent by the API (no error key).\n\t *\n\t * @param array $p_override Keys to override.\n\t * @return array\n\t */\n\tprivate function makeFile( array $p_override = array() ) {\n\t\t$t_file = array(\n\t\t\t'name' => 'test.txt',\n\t\t\t'tmp_name' => $this->makeTmpFile(),\n\t\t\t'browser_upload' => false,\n\t\t);\n\t\treturn array_merge( $t_file, $p_override );\n\t}\n\n\t/**\n\t * Assert that file_ensure_uploaded() throws the given error.\n\t *\n\t * @param array  $p_file    File info.\n\t * @param string $p_message Expected message.\n\t * @param int    $p_code    Expected error code.\n\t */\n\tprivate function assertUploadFails( array $p_file, $p_message, $p_code ) {\n\t\ttry {\n\t\t\tfile_ensure_uploaded( $p_file );\n\t\t\t$this->fail( \"Expected ClientException '$p_message'\" );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( $p_message, $e->getMessage() );\n\t\t\t$this->assertEquals( $p_code, $e->getCode() );\n\t\t}\n\t}\n\n\t/**\n\t * A valid file without error key passes (API case).\n\t * @doesNotPerformAssertions\n\t */\n\tpublic function testValidFileWithoutErrorKey() {\n\t\tfile_ensure_uploaded( $this->makeFile() );\n\t}\n\n\t/**\n\t * A valid file with UPLOAD_ERR_OK passes (web case).\n\t * @doesNotPerformAssertions\n\t */\n\tpublic function testValidFileWithErrorOk() {\n\t\tfile_ensure_uploaded( $this->makeFile( array( 'error' => UPLOAD_ERR_OK ) ) );\n\t}\n\n\t/**\n\t * Missing or empty name.\n\t */\n\tpublic function testEmptyName() {\n\t\t$this->assertUploadFails( $this->makeFile( array( 'name' => '' ) ),\n\t\t\t'File name is empty', ERROR_FILE_NO_UPLOAD_FAILURE );\n\n\t\t$t_file = $this->makeFile();\n\t\tunset( $t_file['name'] );\n\t\t$this->assertUploadFails( $t_file, 'File name is empty', ERROR_FILE_NO_UPLOAD_FAILURE );\n\n\t\t# Name is checked before the upload error\n\t\t$this->assertUploadFails(\n\t\t\tarray( 'name' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_INI_SIZE ),\n\t\t\t'File name is empty', ERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * Upload errors reported by the web server.\n\t */\n\tpublic function testUploadErrors() {\n\t\tforeach( array( UPLOAD_ERR_INI_SIZE, UPLOAD_ERR_FORM_SIZE ) as $t_error ) {\n\t\t\t$this->assertUploadFails(\n\t\t\t\tarray( 'name' => 'big.txt', 'tmp_name' => '', 'error' => $t_error ),\n\t\t\t\t\"File 'big.txt' too big\", ERROR_FILE_TOO_BIG );\n\t\t}\n\n\t\t$t_failures = array(\n\t\t\tUPLOAD_ERR_PARTIAL,\n\t\t\tUPLOAD_ERR_NO_FILE,\n\t\t\tUPLOAD_ERR_NO_TMP_DIR,\n\t\t\tUPLOAD_ERR_CANT_WRITE,\n\t\t\tUPLOAD_ERR_EXTENSION,\n\t\t\t999,\n\t\t);\n\t\tforeach( $t_failures as $t_error ) {\n\t\t\t$this->assertUploadFails(\n\t\t\t\tarray( 'name' => 'x.txt', 'tmp_name' => '', 'error' => $t_error ),\n\t\t\t\t\"File 'x.txt' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE );\n\t\t}\n\n\t\t# Upload error is checked before the name length and type\n\t\t$t_long_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.svg';\n\t\t$this->assertUploadFails(\n\t\t\tarray( 'name' => $t_long_name, 'tmp_name' => '', 'error' => UPLOAD_ERR_PARTIAL ),\n\t\t\t\"File '$t_long_name' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * Name longer than the database field.\n\t */\n\tpublic function testNameTooLong() {\n\t\t$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME - 3 ) . '.txt';\n\t\t$this->assertUploadFails( $this->makeFile( array( 'name' => $t_name ) ),\n\t\t\t\"Filename '$t_name' is too long\", ERROR_FILE_NAME_TOO_LONG );\n\n\t\t# Name length is checked before the file type\n\t\t$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.svg';\n\t\t$this->assertUploadFails( $this->makeFile( array( 'name' => $t_name ) ),\n\t\t\t\"Filename '$t_name' is too long\", ERROR_FILE_NAME_TOO_LONG );\n\n\t\t# A name of the maximum length is valid\n\t\t$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME - 4 ) . '.txt';\n\t\tfile_ensure_uploaded( $this->makeFile( array( 'name' => $t_name ) ) );\n\t}\n\n\t/**\n\t * File type not allowed.\n\t */\n\tpublic function testTypeNotAllowed() {\n\t\t$this->setTestConfig( 'disallowed_files', 'svg' );\n\n\t\t$this->assertUploadFails( $this->makeFile( array( 'name' => 'image.svg' ) ),\n\t\t\t\"File 'image.svg' type not allowed\", ERROR_FILE_NOT_ALLOWED );\n\n\t\t# Type is checked before the temporary file\n\t\t$this->assertUploadFails( array( 'name' => 'image.svg', 'tmp_name' => '' ),\n\t\t\t\"File 'image.svg' type not allowed\", ERROR_FILE_NOT_ALLOWED );\n\t}\n\n\t/**\n\t * Missing or empty temporary file path.\n\t */\n\tpublic function testEmptyPath() {\n\t\t$this->assertUploadFails( $this->makeFile( array( 'tmp_name' => '' ) ),\n\t\t\t\"File 'test.txt' path is empty\", ERROR_FILE_NO_UPLOAD_FAILURE );\n\n\t\t$t_file = $this->makeFile();\n\t\tunset( $t_file['tmp_name'] );\n\t\t$this->assertUploadFails( $t_file, \"File 'test.txt' path is empty\", ERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * Temporary file not readable.\n\t */\n\tpublic function testNotReadable() {\n\t\t$t_path = sys_get_temp_dir() . '/mantisbt-test-missing-' . uniqid();\n\t\t$this->assertUploadFails( $this->makeFile( array( 'tmp_name' => $t_path ) ),\n\t\t\t\"File 'test.txt' is not readable\", ERROR_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * Empty file.\n\t */\n\tpublic function testEmptyFile() {\n\t\t$this->assertUploadFails( $this->makeFile( array( 'tmp_name' => $this->makeTmpFile( '' ) ) ),\n\t\t\t\"File 'test.txt' not uploaded\", ERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * File bigger than the maximum file size.\n\t */\n\tpublic function testFileTooBig() {\n\t\t$this->setTestConfig( 'max_file_size', 10 );\n\n\t\t$this->assertUploadFails( $this->makeFile( array( 'tmp_name' => $this->makeTmpFile( str_repeat( 'x', 11 ) ) ) ),\n\t\t\t\"File 'test.txt' too big\", ERROR_FILE_TOO_BIG );\n\n\t\t# Exactly the maximum size is valid\n\t\tfile_ensure_uploaded( $this->makeFile( array( 'tmp_name' => $this->makeTmpFile( str_repeat( 'x', 10 ) ) ) ) );\n\t}\n\n\t/**\n\t * Antispam check runs first.\n\t */\n\tpublic function testAntispam() {\n\t\tglobal $g_allow_signup, $g_cache_config_eval;\n\n\t\t$t_old_signup = $g_allow_signup;\n\t\t$g_allow_signup = ON;\n\t\tunset( $g_cache_config_eval['g_allow_signup'] );\n\t\t$this->setTestConfig( 'default_new_account_access_level', ADMINISTRATOR );\n\t\t$this->setTestConfig( 'antispam_max_event_count', 1 );\n\n\t\ttry {\n\t\t\t# Even an invalid file gets the antispam error first\n\t\t\t$this->assertUploadFails( array( 'name' => '' ),\n\t\t\t\t'Hit rate limit threshold', ERROR_SPAM_SUSPECTED );\n\t\t} finally {\n\t\t\t$g_allow_signup = $t_old_signup;\n\t\t\tunset( $g_cache_config_eval['g_allow_signup'] );\n\t\t}\n\t}\n\n\t/**\n\t * Empty slots of web forms are removed, other entries are kept.\n\t */\n\tpublic function testRemoveEmptyUploads() {\n\t\t$t_valid = array( 'name' => 'a.txt', 'tmp_name' => '/tmp/x', 'error' => UPLOAD_ERR_OK );\n\t\t$t_empty = array( 'name' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE, 'size' => 0 );\n\t\t$t_api = array( 'name' => '', 'tmp_name' => '/tmp/y' );\n\t\t$t_named_error = array( 'name' => 'b.txt', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE );\n\n\t\t$this->assertEquals(\n\t\t\tarray( $t_valid, $t_api, $t_named_error ),\n\t\t\tfile_remove_empty_uploads( array( $t_empty, $t_valid, $t_api, $t_empty, $t_named_error ) ) );\n\t}\n\n\t/**\n\t * file_add() uses the checks.\n\t */\n\tpublic function testFileAddChecksFile() {\n\t\ttry {\n\t\t\tfile_add( $this->issueId, $this->makeFile( array( 'tmp_name' => $this->makeTmpFile( '' ) ) ) );\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'test.txt' not uploaded\", $e->getMessage() );\n\t\t}\n\t\t$this->assertCount( 0, bug_get_attachments( $this->issueId ) );\n\n\t\t$t_info = file_add( $this->issueId, $this->makeFile() );\n\t\t$this->assertEquals( 'test.txt', $t_info['name'] );\n\t\t$this->assertCount( 1, bug_get_attachments( $this->issueId ) );\n\t}\n\n\t/**\n\t * IssueFileAddCommand checks all files before it adds any.\n\t */\n\tpublic function testIssueFileAddCommandChecksFiles() {\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $this->issueId ),\n\t\t\t'payload' => array( 'files' => array(\n\t\t\t\t$this->makeFile( array( 'name' => 'good.txt' ) ),\n\t\t\t\t$this->makeFile( array( 'name' => 'bad.txt', 'error' => UPLOAD_ERR_CANT_WRITE ) ),\n\t\t\t) ),\n\t\t);\n\n\t\ttry {\n\t\t\t( new \\IssueFileAddCommand( $t_data ) )->execute();\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'bad.txt' upload failure\", $e->getMessage() );\n\t\t\t$this->assertEquals( ERROR_FILE_NO_UPLOAD_FAILURE, $e->getCode() );\n\t\t}\n\t\t$this->assertCount( 0, bug_get_attachments( $this->issueId ), 'No file must be added' );\n\n\t\t# Valid files, with an empty web form slot\n\t\t$t_data['payload']['files'] = array(\n\t\t\t$this->makeFile( array( 'name' => 'good.txt' ) ),\n\t\t\tarray( 'name' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE ),\n\t\t);\n\t\t( new \\IssueFileAddCommand( $t_data ) )->execute();\n\t\t$this->assertCount( 1, bug_get_attachments( $this->issueId ) );\n\t}\n\n\t/**\n\t * IssueFileAddCommand with only empty web form slots has no files.\n\t */\n\tpublic function testIssueFileAddCommandOnlyEmptySlots() {\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $this->issueId ),\n\t\t\t'payload' => array( 'files' => array(\n\t\t\t\tarray( 'name' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE ),\n\t\t\t) ),\n\t\t);\n\n\t\t$this->expectException( ClientException::class );\n\t\t$this->expectExceptionMessage( 'Files not provided' );\n\t\t( new \\IssueFileAddCommand( $t_data ) )->execute();\n\t}\n\n\t/**\n\t * IssueNoteAddCommand checks the files before it adds the note.\n\t */\n\tpublic function testIssueNoteAddCommandChecksFiles() {\n\t\t$t_name = str_repeat( 'n', DB_FIELD_SIZE_FILENAME ) . '.txt';\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $this->issueId ),\n\t\t\t'payload' => array(\n\t\t\t\t'text' => 'Note with invalid file',\n\t\t\t\t'files' => array( $this->makeFile( array( 'name' => $t_name ) ) ),\n\t\t\t),\n\t\t);\n\n\t\ttry {\n\t\t\t( new \\IssueNoteAddCommand( $t_data ) )->execute();\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"Filename '$t_name' is too long\", $e->getMessage() );\n\t\t\t$this->assertEquals( ERROR_FILE_NAME_TOO_LONG, $e->getCode() );\n\t\t}\n\t\t$this->assertEquals( 0, bugnote_count_attached( $this->issueId ), 'No note must be added' );\n\t\t$this->assertCount( 0, bug_get_attachments( $this->issueId ) );\n\n\t\t# A note with an empty web form slot is a note without files\n\t\t$t_data['payload']['files'] = array(\n\t\t\tarray( 'name' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE ),\n\t\t);\n\t\t$t_result = ( new \\IssueNoteAddCommand( $t_data ) )->execute();\n\t\t$this->assertTrue( bugnote_exists( $t_result['id'] ) );\n\t\t$this->assertCount( 0, bug_get_attachments( $this->issueId ) );\n\t}\n\n\t/**\n\t * IssueAddCommand checks the files before it creates the issue.\n\t */\n\tpublic function testIssueAddCommandChecksFiles() {\n\t\t$this->setTestConfig( 'max_file_size', 5 );\n\n\t\t$t_summary = __CLASS__ . ': issue with invalid file ' . rand( 1, 1000000 );\n\t\t$t_data = array(\n\t\t\t'payload' => array( 'issue' => array(\n\t\t\t\t'project' => array( 'id' => 1 ),\n\t\t\t\t'category' => array( 'id' => 1 ),\n\t\t\t\t'summary' => $t_summary,\n\t\t\t\t'description' => 'Issue with invalid file',\n\t\t\t\t'files' => array( $this->makeFile() ),\n\t\t\t) ),\n\t\t);\n\n\t\ttry {\n\t\t\t( new \\IssueAddCommand( $t_data ) )->execute();\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'test.txt' too big\", $e->getMessage() );\n\t\t\t$this->assertEquals( ERROR_FILE_TOO_BIG, $e->getCode() );\n\t\t}\n\n\t\t$t_count = db_result( db_query(\n\t\t\t'SELECT COUNT(*) FROM {bug} WHERE summary=' . db_param(),\n\t\t\tarray( $t_summary ) ) );\n\t\t$this->assertEquals( 0, $t_count, 'No issue must be created' );\n\t}\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1271,"cache_read_input_tokens":76336,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1271},"output_tokens":22,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2dedf4c0-c875-4877-8ab6-da77519c352d","uuid":"2c68b392-e673-4893-bb89-8e5021a6348c","timestamp":"2026-11-01T22:24:28.543Z","request_id":"req_011CgczRPztuHq7379L2C9YZ","wire_tool_inputs":{"toolu_01AWBPektu2kZUv6nDsqJZkH":{"file_path":"/Users/victor/Repos/unwritten/uw-harness-cases/mantisbt/bench/trees/mantisbt-1-control/tests/Mantis/FileUploadCheckTest.php","content":"<?php\n# MantisBT - A PHP based bugtracking system\n\n# MantisBT is free software: you can redistribute it and/or modify\n# it under the terms of the GNU General Public License as published by\n# the Free Software Foundation, either version 2 of the License, or\n# (at your option) any later version.\n#\n# MantisBT is distributed in the hope that it will be useful,\n# but WITHOUT ANY WARRANTY; without even the implied warranty of\n# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n# GNU General Public License for more details.\n#\n# You should have received a copy of the GNU General Public License\n# along with MantisBT.  If not, see <http://www.gnu.org/licenses/>.\n\n/**\n * Test cases for the checks on uploaded files (file_ensure_uploaded) and\n * their use in file_add() and the issue, issue file and issue note commands.\n *\n * @package    Tests\n * @subpackage FileApi\n * @copyright  Copyright MantisBT Team - mantisbt-dev@lists.sourceforge.net\n * @link       http://www.mantisbt.org\n *\n * @noinspection PhpIllegalPsrClassPathInspection\n */\n\nnamespace Mantis\\tests\\Mantis;\n\nuse Mantis\\Exceptions\\ClientException;\n\n/**\n * PHPUnit tests for uploaded file checks\n */\nclass FileUploadCheckTest extends MantisCoreBase {\n\t/**\n\t * @var int Test issue id\n\t */\n\tprivate $issueId;\n\n\t/**\n\t * @var string[] Temporary files to delete in tearDown\n\t */\n\tprivate $tmpFiles = array();\n\n\t/**\n\t * @var array Configs to restore in tearDown (name => old value)\n\t */\n\tprivate $configs = array();\n\n\t/**\n\t * Create a test issue.\n\t */\n\tprotected function setUp(): void {\n\t\tparent::setUp();\n\t\tself::login();\n\n\t\t$t_issue_data = new \\BugData();\n\t\t$t_issue_data->project_id = 1;\n\t\t$t_issue_data->summary = __CLASS__ . ': test issue ' . rand( 1, 1000000 );\n\t\t$t_issue_data->description = 'Test issue for uploaded file checks';\n\t\t$t_issue_data->category_id = 1;\n\n\t\t$this->issueId = $t_issue_data->create();\n\t}\n\n\t/**\n\t * Delete the test issue, temporary files and restore configs.\n\t */\n\tprotected function tearDown(): void {\n\t\tforeach( $this->configs as $t_config => $t_value ) {\n\t\t\t$this->restoreConfig( $t_config, $t_value );\n\t\t}\n\t\tbug_delete( $this->issueId );\n\t\tforeach( $this->tmpFiles as $t_file ) {\n\t\t\tif( file_exists( $t_file ) ) {\n\t\t\t\tunlink( $t_file );\n\t\t\t}\n\t\t}\n\t}\n\n\t/**\n\t * Set a config for the duration of the test.\n\t *\n\t * @param string $p_config Config name.\n\t * @param mixed  $p_value  Config value.\n\t */\n\tprivate function setTestConfig( $p_config, $p_value ) {\n\t\tif( !array_key_exists( $p_config, $this->configs ) ) {\n\t\t\t$this->configs[$p_config] = $this->setConfig( $p_config, $p_value );\n\t\t} else {\n\t\t\tconfig_set( $p_config, $p_value );\n\t\t}\n\t}\n\n\t/**\n\t * Create a temporary file.\n\t *\n\t * @param string $p_content File content.\n\t * @return string The file path.\n\t */\n\tprivate function makeTmpFile( $p_content = 'some content' ) {\n\t\t$t_path = tempnam( sys_get_temp_dir(), 'mantisbt-test' );\n\t\tfile_put_contents( $t_path, $p_content );\n\t\t$this->tmpFiles[] = $t_path;\n\t\treturn $t_path;\n\t}\n\n\t/**\n\t * Build a valid file info array, as sent by the API (no error key).\n\t *\n\t * @param array $p_override Keys to override.\n\t * @return array\n\t */\n\tprivate function makeFile( array $p_override = array() ) {\n\t\t$t_file = array(\n\t\t\t'name' => 'test.txt',\n\t\t\t'tmp_name' => $this->makeTmpFile(),\n\t\t\t'browser_upload' => false,\n\t\t);\n\t\treturn array_merge( $t_file, $p_override );\n\t}\n\n\t/**\n\t * Assert that file_ensure_uploaded() throws the given error.\n\t *\n\t * @param array  $p_file    File info.\n\t * @param string $p_message Expected message.\n\t * @param int    $p_code    Expected error code.\n\t */\n\tprivate function assertUploadFails( array $p_file, $p_message, $p_code ) {\n\t\ttry {\n\t\t\tfile_ensure_uploaded( $p_file );\n\t\t\t$this->fail( \"Expected ClientException '$p_message'\" );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( $p_message, $e->getMessage() );\n\t\t\t$this->assertEquals( $p_code, $e->getCode() );\n\t\t}\n\t}\n\n\t/**\n\t * A valid file without error key passes (API case).\n\t * @doesNotPerformAssertions\n\t */\n\tpublic function testValidFileWithoutErrorKey() {\n\t\tfile_ensure_uploaded( $this->makeFile() );\n\t}\n\n\t/**\n\t * A valid file with UPLOAD_ERR_OK passes (web case).\n\t * @doesNotPerformAssertions\n\t */\n\tpublic function testValidFileWithErrorOk() {\n\t\tfile_ensure_uploaded( $this->makeFile( array( 'error' => UPLOAD_ERR_OK ) ) );\n\t}\n\n\t/**\n\t * Missing or empty name.\n\t */\n\tpublic function testEmptyName() {\n\t\t$this->assertUploadFails( $this->makeFile( array( 'name' => '' ) ),\n\t\t\t'File name is empty', ERROR_FILE_NO_UPLOAD_FAILURE );\n\n\t\t$t_file = $this->makeFile();\n\t\tunset( $t_file['name'] );\n\t\t$this->assertUploadFails( $t_file, 'File name is empty', ERROR_FILE_NO_UPLOAD_FAILURE );\n\n\t\t# Name is checked before the upload error\n\t\t$this->assertUploadFails(\n\t\t\tarray( 'name' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_INI_SIZE ),\n\t\t\t'File name is empty', ERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * Upload errors reported by the web server.\n\t */\n\tpublic function testUploadErrors() {\n\t\tforeach( array( UPLOAD_ERR_INI_SIZE, UPLOAD_ERR_FORM_SIZE ) as $t_error ) {\n\t\t\t$this->assertUploadFails(\n\t\t\t\tarray( 'name' => 'big.txt', 'tmp_name' => '', 'error' => $t_error ),\n\t\t\t\t\"File 'big.txt' too big\", ERROR_FILE_TOO_BIG );\n\t\t}\n\n\t\t$t_failures = array(\n\t\t\tUPLOAD_ERR_PARTIAL,\n\t\t\tUPLOAD_ERR_NO_FILE,\n\t\t\tUPLOAD_ERR_NO_TMP_DIR,\n\t\t\tUPLOAD_ERR_CANT_WRITE,\n\t\t\tUPLOAD_ERR_EXTENSION,\n\t\t\t999,\n\t\t);\n\t\tforeach( $t_failures as $t_error ) {\n\t\t\t$this->assertUploadFails(\n\t\t\t\tarray( 'name' => 'x.txt', 'tmp_name' => '', 'error' => $t_error ),\n\t\t\t\t\"File 'x.txt' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE );\n\t\t}\n\n\t\t# Upload error is checked before the name length and type\n\t\t$t_long_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.svg';\n\t\t$this->assertUploadFails(\n\t\t\tarray( 'name' => $t_long_name, 'tmp_name' => '', 'error' => UPLOAD_ERR_PARTIAL ),\n\t\t\t\"File '$t_long_name' upload failure\", ERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * Name longer than the database field.\n\t */\n\tpublic function testNameTooLong() {\n\t\t$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME - 3 ) . '.txt';\n\t\t$this->assertUploadFails( $this->makeFile( array( 'name' => $t_name ) ),\n\t\t\t\"Filename '$t_name' is too long\", ERROR_FILE_NAME_TOO_LONG );\n\n\t\t# Name length is checked before the file type\n\t\t$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.svg';\n\t\t$this->assertUploadFails( $this->makeFile( array( 'name' => $t_name ) ),\n\t\t\t\"Filename '$t_name' is too long\", ERROR_FILE_NAME_TOO_LONG );\n\n\t\t# A name of the maximum length is valid\n\t\t$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME - 4 ) . '.txt';\n\t\tfile_ensure_uploaded( $this->makeFile( array( 'name' => $t_name ) ) );\n\t}\n\n\t/**\n\t * File type not allowed.\n\t */\n\tpublic function testTypeNotAllowed() {\n\t\t$this->setTestConfig( 'disallowed_files', 'svg' );\n\n\t\t$this->assertUploadFails( $this->makeFile( array( 'name' => 'image.svg' ) ),\n\t\t\t\"File 'image.svg' type not allowed\", ERROR_FILE_NOT_ALLOWED );\n\n\t\t# Type is checked before the temporary file\n\t\t$this->assertUploadFails( array( 'name' => 'image.svg', 'tmp_name' => '' ),\n\t\t\t\"File 'image.svg' type not allowed\", ERROR_FILE_NOT_ALLOWED );\n\t}\n\n\t/**\n\t * Missing or empty temporary file path.\n\t */\n\tpublic function testEmptyPath() {\n\t\t$this->assertUploadFails( $this->makeFile( array( 'tmp_name' => '' ) ),\n\t\t\t\"File 'test.txt' path is empty\", ERROR_FILE_NO_UPLOAD_FAILURE );\n\n\t\t$t_file = $this->makeFile();\n\t\tunset( $t_file['tmp_name'] );\n\t\t$this->assertUploadFails( $t_file, \"File 'test.txt' path is empty\", ERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * Temporary file not readable.\n\t */\n\tpublic function testNotReadable() {\n\t\t$t_path = sys_get_temp_dir() . '/mantisbt-test-missing-' . uniqid();\n\t\t$this->assertUploadFails( $this->makeFile( array( 'tmp_name' => $t_path ) ),\n\t\t\t\"File 'test.txt' is not readable\", ERROR_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * Empty file.\n\t */\n\tpublic function testEmptyFile() {\n\t\t$this->assertUploadFails( $this->makeFile( array( 'tmp_name' => $this->makeTmpFile( '' ) ) ),\n\t\t\t\"File 'test.txt' not uploaded\", ERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\t/**\n\t * File bigger than the maximum file size.\n\t */\n\tpublic function testFileTooBig() {\n\t\t$this->setTestConfig( 'max_file_size', 10 );\n\n\t\t$this->assertUploadFails( $this->makeFile( array( 'tmp_name' => $this->makeTmpFile( str_repeat( 'x', 11 ) ) ) ),\n\t\t\t\"File 'test.txt' too big\", ERROR_FILE_TOO_BIG );\n\n\t\t# Exactly the maximum size is valid\n\t\tfile_ensure_uploaded( $this->makeFile( array( 'tmp_name' => $this->makeTmpFile( str_repeat( 'x', 10 ) ) ) ) );\n\t}\n\n\t/**\n\t * Antispam check runs first.\n\t */\n\tpublic function testAntispam() {\n\t\tglobal $g_allow_signup, $g_cache_config_eval;\n\n\t\t$t_old_signup = $g_allow_signup;\n\t\t$g_allow_signup = ON;\n\t\tunset( $g_cache_config_eval['g_allow_signup'] );\n\t\t$this->setTestConfig( 'default_new_account_access_level', ADMINISTRATOR );\n\t\t$this->setTestConfig( 'antispam_max_event_count', 1 );\n\n\t\ttry {\n\t\t\t# Even an invalid file gets the antispam error first\n\t\t\t$this->assertUploadFails( array( 'name' => '' ),\n\t\t\t\t'Hit rate limit threshold', ERROR_SPAM_SUSPECTED );\n\t\t} finally {\n\t\t\t$g_allow_signup = $t_old_signup;\n\t\t\tunset( $g_cache_config_eval['g_allow_signup'] );\n\t\t}\n\t}\n\n\t/**\n\t * Empty slots of web forms are removed, other entries are kept.\n\t */\n\tpublic function testRemoveEmptyUploads() {\n\t\t$t_valid = array( 'name' => 'a.txt', 'tmp_name' => '/tmp/x', 'error' => UPLOAD_ERR_OK );\n\t\t$t_empty = array( 'name' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE, 'size' => 0 );\n\t\t$t_api = array( 'name' => '', 'tmp_name' => '/tmp/y' );\n\t\t$t_named_error = array( 'name' => 'b.txt', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE );\n\n\t\t$this->assertEquals(\n\t\t\tarray( $t_valid, $t_api, $t_named_error ),\n\t\t\tfile_remove_empty_uploads( array( $t_empty, $t_valid, $t_api, $t_empty, $t_named_error ) ) );\n\t}\n\n\t/**\n\t * file_add() uses the checks.\n\t */\n\tpublic function testFileAddChecksFile() {\n\t\ttry {\n\t\t\tfile_add( $this->issueId, $this->makeFile( array( 'tmp_name' => $this->makeTmpFile( '' ) ) ) );\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'test.txt' not uploaded\", $e->getMessage() );\n\t\t}\n\t\t$this->assertCount( 0, bug_get_attachments( $this->issueId ) );\n\n\t\t$t_info = file_add( $this->issueId, $this->makeFile() );\n\t\t$this->assertEquals( 'test.txt', $t_info['name'] );\n\t\t$this->assertCount( 1, bug_get_attachments( $this->issueId ) );\n\t}\n\n\t/**\n\t * IssueFileAddCommand checks all files before it adds any.\n\t */\n\tpublic function testIssueFileAddCommandChecksFiles() {\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $this->issueId ),\n\t\t\t'payload' => array( 'files' => array(\n\t\t\t\t$this->makeFile( array( 'name' => 'good.txt' ) ),\n\t\t\t\t$this->makeFile( array( 'name' => 'bad.txt', 'error' => UPLOAD_ERR_CANT_WRITE ) ),\n\t\t\t) ),\n\t\t);\n\n\t\ttry {\n\t\t\t( new \\IssueFileAddCommand( $t_data ) )->execute();\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'bad.txt' upload failure\", $e->getMessage() );\n\t\t\t$this->assertEquals( ERROR_FILE_NO_UPLOAD_FAILURE, $e->getCode() );\n\t\t}\n\t\t$this->assertCount( 0, bug_get_attachments( $this->issueId ), 'No file must be added' );\n\n\t\t# Valid files, with an empty web form slot\n\t\t$t_data['payload']['files'] = array(\n\t\t\t$this->makeFile( array( 'name' => 'good.txt' ) ),\n\t\t\tarray( 'name' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE ),\n\t\t);\n\t\t( new \\IssueFileAddCommand( $t_data ) )->execute();\n\t\t$this->assertCount( 1, bug_get_attachments( $this->issueId ) );\n\t}\n\n\t/**\n\t * IssueFileAddCommand with only empty web form slots has no files.\n\t */\n\tpublic function testIssueFileAddCommandOnlyEmptySlots() {\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $this->issueId ),\n\t\t\t'payload' => array( 'files' => array(\n\t\t\t\tarray( 'name' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE ),\n\t\t\t) ),\n\t\t);\n\n\t\t$this->expectException( ClientException::class );\n\t\t$this->expectExceptionMessage( 'Files not provided' );\n\t\t( new \\IssueFileAddCommand( $t_data ) )->execute();\n\t}\n\n\t/**\n\t * IssueNoteAddCommand checks the files before it adds the note.\n\t */\n\tpublic function testIssueNoteAddCommandChecksFiles() {\n\t\t$t_name = str_repeat( 'n', DB_FIELD_SIZE_FILENAME ) . '.txt';\n\t\t$t_data = array(\n\t\t\t'query' => array( 'issue_id' => $this->issueId ),\n\t\t\t'payload' => array(\n\t\t\t\t'text' => 'Note with invalid file',\n\t\t\t\t'files' => array( $this->makeFile( array( 'name' => $t_name ) ) ),\n\t\t\t),\n\t\t);\n\n\t\ttry {\n\t\t\t( new \\IssueNoteAddCommand( $t_data ) )->execute();\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"Filename '$t_name' is too long\", $e->getMessage() );\n\t\t\t$this->assertEquals( ERROR_FILE_NAME_TOO_LONG, $e->getCode() );\n\t\t}\n\t\t$this->assertEquals( 0, bugnote_count_attached( $this->issueId ), 'No note must be added' );\n\t\t$this->assertCount( 0, bug_get_attachments( $this->issueId ) );\n\n\t\t# A note with an empty web form slot is a note without files\n\t\t$t_data['payload']['files'] = array(\n\t\t\tarray( 'name' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_NO_FILE ),\n\t\t);\n\t\t$t_result = ( new \\IssueNoteAddCommand( $t_data ) )->execute();\n\t\t$this->assertTrue( bugnote_exists( $t_result['id'] ) );\n\t\t$this->assertCount( 0, bug_get_attachments( $this->issueId ) );\n\t}\n\n\t/**\n\t * IssueAddCommand checks the files before it creates the issue.\n\t */\n\tpublic function testIssueAddCommandChecksFiles() {\n\t\t$this->setTestConfig( 'max_file_size', 5 );\n\n\t\t$t_summary = __CLASS__ . ': issue with invalid file ' . rand( 1, 1000000 );\n\t\t$t_data = array(\n\t\t\t'payload' => array( 'issue' => array(\n\t\t\t\t'project' => array( 'id' => 1 ),\n\t\t\t\t'category' => array( 'id' => 1 ),\n\t\t\t\t'summary' => $t_summary,\n\t\t\t\t'description' => 'Issue with invalid file',\n\t\t\t\t'files' => array( $this->makeFile() ),\n\t\t\t) ),\n\t\t);\n\n\t\ttry {\n\t\t\t( new \\IssueAddCommand( $t_data ) )->execute();\n\t\t\t$this->fail( 'Expected ClientException' );\n\t\t} catch( ClientException $e ) {\n\t\t\t$this->assertEquals( \"File 'test.txt' too big\", $e->getMessage() );\n\t\t\t$this->assertEquals( ERROR_FILE_TOO_BIG, $e->getCode() );\n\t\t}\n\n\t\t$t_count = db_result( db_query(\n\t\t\t'SELECT COUNT(*) FROM {bug} WHERE summary=' . db_param(),\n\t\t\tarray( $t_summary ) ) );\n\t\t$this->assertEquals( 0, $t_count, 'No issue must be created' );\n\t}\n}\n"}}}

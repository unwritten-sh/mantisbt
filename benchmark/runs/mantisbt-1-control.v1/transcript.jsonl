 ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"File '%s' too big\", $t_file_name ),\n\t\t\tERROR_FILE_TOO_BIG );\n\t}\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":614,"cache_read_input_tokens":59596,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":614},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2dedf4c0-c875-4877-8ab6-da77519c352d","uuid":"5a36f59b-7700-4bd4-97b2-4f38b20a25bb","timestamp":"2026-11-01T22:22:21.026Z","request_id":"req_011CgczJVsuTSSvXavMG65KL","wire_tool_inputs":{"toolu_01EbJwdMEv3LGjtd1Xaj2vDL":{"file_path":"/Users/victor/Repos/unwritten/uw-harness-cases/mantisbt/bench/trees/mantisbt-1-control/core/file_api.php","old_string":"/**\n * Ensure a file was uploaded.\n *\n * This function perform various checks for determining if the upload was\n * successful.\n *\n * @param array $p_file The uploaded file info, as retrieved from\n *                      gpc_get_file().\n *\n * @return void\n * @throws ClientException\n */\nfunction file_ensure_uploaded( array $p_file ) {\n\tswitch( $p_file['error'] ) {\n\t\tcase UPLOAD_ERR_INI_SIZE:\n\t\tcase UPLOAD_ERR_FORM_SIZE:\n\t\t\tthrow new ClientException(\n\t\t\t\tsprintf( \"File '%s' too big\", $p_file['name'] ),\n\t\t\t\tERROR_FILE_TOO_BIG );\n\n\t\tcase UPLOAD_ERR_PARTIAL:\n\t\tcase UPLOAD_ERR_NO_FILE:\n\t\t\tthrow new ClientException(\n\t\t\t\tsprintf( \"File '%s' upload failure\", $p_file['name'] ),\n\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\tif( ( '' == $p_file['tmp_name'] ) || ( '' == $p_file['name'] ) ) {\n\t\tthrow new ClientException(\n\t\t\t'File name or path is empty',\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\tif( !is_readable( $p_file['tmp_name'] ) ) {\n\t\tthrow new ClientException( 'File is not readable', ERROR_UPLOAD_FAILURE );\n\t}\n}","new_string":"/**\n * Ensure a file was uploaded and can be stored.\n *\n * This function performs all the checks on one uploaded file: spam, upload\n * errors reported by the web server, file name, file type, temporary file\n * and file size.\n *\n * The `error` key is optional: files added through the API do not have it.\n *\n * @param array $p_file The uploaded file info, as retrieved from\n *                      gpc_get_file() (keys: name, tmp_name, error).\n *\n * @return void\n * @throws ClientException\n */\nfunction file_ensure_uploaded( array $p_file ) {\n\tantispam_check();\n\n\t$t_file_name = isset( $p_file['name'] ) ? (string)$p_file['name'] : '';\n\tif( $t_file_name === '' ) {\n\t\tthrow new ClientException(\n\t\t\t'File name is empty',\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\tif( isset( $p_file['error'] ) ) {\n\t\tswitch( (int)$p_file['error'] ) {\n\t\t\tcase UPLOAD_ERR_OK:\n\t\t\t\tbreak;\n\n\t\t\tcase UPLOAD_ERR_INI_SIZE:\n\t\t\tcase UPLOAD_ERR_FORM_SIZE:\n\t\t\t\tthrow new ClientException(\n\t\t\t\t\tsprintf( \"File '%s' too big\", $t_file_name ),\n\t\t\t\t\tERROR_FILE_TOO_BIG );\n\n\t\t\tdefault:\n\t\t\t\t# UPLOAD_ERR_PARTIAL, UPLOAD_ERR_NO_FILE, UPLOAD_ERR_NO_TMP_DIR,\n\t\t\t\t# UPLOAD_ERR_CANT_WRITE, UPLOAD_ERR_EXTENSION and unknown codes\n\t\t\t\tthrow new ClientException(\n\t\t\t\t\tsprintf( \"File '%s' upload failure\", $t_file_name ),\n\t\t\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t\t}\n\t}\n\n\tif( strlen( $t_file_name ) > DB_FIELD_SIZE_FILENAME ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"Filename '%s' is too long\", $t_file_name ),\n\t\t\tERROR_FILE_NAME_TOO_LONG,\n\t\t\tarray( $t_file_name ) );\n\t}\n\n\tif( !file_type_check( $t_file_name ) ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"File '%s' type not allowed\", $t_file_name ),\n\t\t\tERROR_FILE_NOT_ALLOWED );\n\t}\n\n\t$t_tmp_name = isset( $p_file['tmp_name'] ) ? (string)$p_file['tmp_name'] : '';\n\tif( $t_tmp_name === '' ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"File '%s' path is empty\", $t_file_name ),\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\tif( !is_readable( $t_tmp_name ) ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"File '%s' is not readable\", $t_file_name ),\n\t\t\tERROR_UPLOAD_FAILURE );\n\t}\n\n\t$t_file_size = filesize( $t_tmp_name );\n\tif( !$t_file_size ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"File '%s' not uploaded\", $t_file_name ),\n\t\t\tERROR_FILE_NO_UPLOAD_FAILURE );\n\t}\n\n\tif( $t_file_size > file_get_max_file_size() ) {\n\t\tthrow new ClientException(\n\t\t\tsprintf( \"File '%s' too big\", $t_file_name ),\n\t\t\tERROR_FILE_TOO_BIG );\n\t}\n}"}}}

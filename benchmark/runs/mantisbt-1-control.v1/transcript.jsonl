ad_content_type_overrides[$t_extension];\n\t}\n\n\treturn null;\n}\n\n/**\n * Return the maximum file size that can be uploaded.\n *\n * Checks both Mantis and PHP configured settings.\n *\n * @return int File size in bytes\n */\nfunction file_get_max_file_size() {\n\treturn (int)min(\n\t\tini_get_number( 'upload_max_filesize' ),\n\t\tini_get_number( 'post_max_size' ),\n\t\tconfig_get( 'max_file_size' )\n\t);\n}\n","structuredPatch":[{"oldStart":1215,"oldLines":41,"newStart":1215,"newLines":88,"lines":[" }"," "," /**","- * Ensure a file was uploaded.","+ * Ensure a file was uploaded and can be stored.","  *","- * This function perform various checks for determining if the upload was","- * successful.","+ * This function performs all the checks on one uploaded file: spam, upload","+ * errors reported by the web server, file name, file type, temporary file","+ * and file size.","  *","+ * The `error` key is optional: files added through the API do not have it.","+ *","  * @param array $p_file The uploaded file info, as retrieved from","- *                      gpc_get_file().","+ *                      gpc_get_file() (keys: name, tmp_name, error).","  *","  * @return void","  * @throws ClientException","  */"," function file_ensure_uploaded( array $p_file ) {","-  switch( $p_file['error'] ) {","-    case UPLOAD_ERR_INI_SIZE:","-    case UPLOAD_ERR_FORM_SIZE:","-      throw new ClientException(","-        sprintf( \"File '%s' too big\", $p_file['name'] ),","-        ERROR_FILE_TOO_BIG );","+  antispam_check();"," ","-    case UPLOAD_ERR_PARTIAL:","-    case UPLOAD_ERR_NO_FILE:","-      throw new ClientException(","-        sprintf( \"File '%s' upload failure\", $p_file['name'] ),","-        ERROR_FILE_NO_UPLOAD_FAILURE );","+  $t_file_name = isset( $p_file['name'] ) ? (string)$p_file['name'] : '';","+  if( $t_file_name === '' ) {","+    throw new ClientException(","+      'File name is empty',","+      ERROR_FILE_NO_UPLOAD_FAILURE );","   }"," ","-  if( ( '' == $p_file
+	/**
+	 * Antispam check runs first.
+	 */
+	public function testAntispam() {
+		global $g_allow_signup, $g_cache_config_eval;
+
+		$t_old_signup = $g_allow_signup;
+		$g_allow_signup = ON;
+		unset( $g_cache_config_eval['g_allow_signup'] );
+		$this->setTestConfig( 'default_new_account_access_level', ADMINISTRATOR );
+		$this->setTestConfig( 'antispam_max_event_count', 1 );
+
+		try {
+			# Even an invalid file gets the antispam error first
+			$this->assertUploadFails( array( 'name' => '' ),
+				'Hit rate limit threshold', ERROR_SPAM_SUSPECTED );
+		} finally {
+			$g_allow_signup = $t_old_signup;
+			unset( $g_cache_config_eval['g_allow_signup'] );
+		}
+	}

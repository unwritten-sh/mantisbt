+# along with MantisBT.  If not, see <http://www.gnu.org/licenses/>.
+
+/**
+ * Test cases for the checks on uploaded files (file_ensure_uploaded) and
+ * their use in file_add() and the issue, issue file and issue note commands.
+ *
+ * @package    Tests
+ * @subpackage FileApi
+ * @copyright  Copyright MantisBT Team - mantisbt-dev@lists.sourceforge.net
+ * @link       http://www.mantisbt.org
+ *
+ * @noinspection PhpIllegalPsrClassPathInspection
+ */
+
+namespace Mantis\tests\Mantis;
+
+use Mantis\Exceptions\ClientException;
+
+/**
+ * PHPUnit tests for uploaded file checks
+ */
+class FileUploadCheckTest extends MantisCoreBase {
+	/**
+	 * @var int Test issue id
+	 */
+	private $issueId;
+
+	/**
+	 * @var string[] Temporary files to delete in tearDown
+	 */
+	private $tmpFiles = array();
+
+	/**
+	 * @var array Configs to restore in tearDown (name => old value)
+	 */
+	private $configs = array();
+
+	/**
+	 * Create a test issue.
+	 */
+	protected function setUp(): void {
+		parent::setUp();
+		self::login();
+
+		$t_issue_data = new \BugData();
+		$t_issue_data->project_id = 1;
+		$t_issue_data->summary = __CLASS__ . ': test issue ' . rand( 1, 1000000 );
+		$t_issue_data->description = 'Test issue for uploaded file checks';
+		$t_issue_data->category_id = 1;
+
+		$this->issueId = $t_issue_data->create();
+	}
+
+	/**
+	 * Delete the test issue, temporary files and restore configs.
+	 */
+	protected function tearDown(): void {
+		foreach( $this->configs as $t_config => $t_value ) {
+			$this->restoreConfig( $t_config, $t_value );
+		}
+		bug_delete( $this->issueId );
+		foreach( $this->tmpFiles as $t_file ) {
+			if( file_exists( $t_file ) ) {
+				unlink( $t_file );
+			}
+		}
+	}
+
+	/**
+	 * Set a config for the duration of the test.
+	 *
+	 * @param string $p_config Config name.
+	 * @param mixed  $p_value  Config value.
+	 */
+	private function setTestConfig( $p_config, $p_value ) {
+		if( !array_key_exists( $p_config, $this->configs ) ) {
+			$this->configs[$p_config] = $this->setConfig( $p_config, $p_value );
+		} else {
+			config_set( $p_config, $p_value );
+		}
+	}
+
+	/**
+	 * Create a temporary file.
+	 *
+	 * @param string $p_content File content.
+	 * @return string The file path.
+	 */
+	private function makeTmpFile( $p_content = 'some content' ) {
+		$t_path = tempnam( sys_get_temp_dir(), 'mantisbt-test' );
+		file_put_contents( $t_path, $p_content );
+		$this->tmpFiles[] = $t_path;
+		return $t_path;
+	}
+
+	/**
+	 * Build a valid file info array, as sent by the API (no error key).
+	 *
+	 * @param array $p_override Keys to override.
+	 * @return array
+	 */
+	private function makeFile( array $p_override = array() ) {
+		$t_file = array(
+			'name' => 'test.txt',
+			'tmp_name' => $this->makeTmpFile(),
+			'browser_upload' => false,
+		);
+		return array_merge( $t_file, $p_override );
+	}
+
+	/**
+	 * Count the rows of a table that belong to the test issue.
+	 *
+	 * @param string $p_table Table name (bug_file or bugnote).
+	 * @return int
+	 */
+	private function countRows( $p_table ) {
+		return (int)db_result( db_query(
+			'SELECT COUNT(*) FROM {' . $p_table . '} WHERE bug_id=' . db_param(),
+			array( $this->issueId ) ) );
+	}
+
+	/**
+	 * Assert that file_ensure_uploaded() throws the given error.
+	 *
+	 * @param array  $p_file    File info.
+	 * @param string $p_message Expected message.
+	 * @param int    $p_code    Expected error code.
+	 */
+	private function assertUploadFails( array $p_file, $p_message, $p_code ) {
+		try {
+			file_ensure_uploaded( $p_file );
+			$this->fail( "Expected ClientException '$p_message'" );
+		} catch( ClientException $e ) {
+			$this->assertEquals( $p_message, $e->getMessage() );
+			$this->assertEquals( $p_code, $e->getCode() );
+		}
+	}
+
+	/**
+	 * A valid file without error key passes (API case).
+	 */
+	public function testValidFileWithoutErrorKey() {
+		file_ensure_uploaded( $this->makeFile() );
+		$this->addToAssertionCount( 1 );
+	}
+
+	/**
+	 * A valid file with UPLOAD_ERR_OK passes (web case).
+	 */
+	public function testValidFileWithErrorOk() {
+		file_ensure_uploaded( $this->makeFile( array( 'error' => UPLOAD_ERR_OK ) ) );
+		$this->addToAssertionCount( 1 );
+	}
+
+	/**
+	 * Missing or empty name.
+	 */
+	public function testEmptyName() {
+		$this->assertUploadFails( $this->makeFile( array( 'name' => '' ) ),
+			'File name is empty', ERROR_FILE_NO_UPLOAD_FAILURE );
+
+		$t_file = $this->makeFile();
+		unset( $t_file['name'] );
+		$this->assertUploadFails( $t_file, 'File name is empty', ERROR_FILE_NO_UPLOAD_FAILURE );
+
+		# Name is checked before the upload error
+		$this->assertUploadFails(
+			array( 'name' => '', 'tmp_name' => '', 'error' => UPLOAD_ERR_INI_SIZE ),
+			'File name is empty', ERROR_FILE_NO_UPLOAD_FAILURE );
+	}
+
+	/**
+	 * Upload errors reported by the web server.
+	 */
+	public function testUploadErrors() {
+		foreach( array( UPLOAD_ERR_INI_SIZE, UPLOAD_ERR_FORM_SIZE ) as $t_error ) {
+			$this->assertUploadFails(
+				array( 'name' => 'big.txt', 'tmp_name' => '', 'error' => $t_error ),
+				"File 'big.txt' too big", ERROR_FILE_TOO_BIG );
+		}
+
+		$t_failures = array(
+			UPLOAD_ERR_PARTIAL,
+			UPLOAD_ERR_NO_FILE,
+			UPLOAD_ERR_NO_TMP_DIR,
+			UPLOAD_ERR_CANT_WRITE,
+			UPLOAD_ERR_EXTENSION,
+			999,
+		);
+		foreach( $t_failures as $t_error ) {
+			$this->assertUploadFails(
+				array( 'name' => 'x.txt', 'tmp_name' => '', 'error' => $t_error ),
+				"File 'x.txt' upload failure", ERROR_FILE_NO_UPLOAD_FAILURE );
+		}
+
+		# Upload error is checked before the name length and type
+		$t_long_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.svg';
+		$this->assertUploadFails(
+			array( 'name' => $t_long_name, 'tmp_name' => '', 'error' => UPLOAD_ERR_PARTIAL ),
+			"File '$t_long_name' upload failure", ERROR_FILE_NO_UPLOAD_FAILURE );
+	}
+
+	/**
+	 * Name longer than the database field.
+	 */
+	public function testNameTooLong() {
+		$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME - 3 ) . '.txt';
+		$this->assertUploadFails( $this->makeFile( array( 'name' => $t_name ) ),
+			"Filename '$t_name' is too long", ERROR_FILE_NAME_TOO_LONG );
+
+		# Name length is checked before the file type
+		$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME ) . '.svg';
+		$this->assertUploadFails( $this->makeFile( array( 'name' => $t_name ) ),
+			"Filename '$t_name' is too long", ERROR_FILE_NAME_TOO_LONG );
+
+		# A name of the maximum length is valid
+		$t_name = str_repeat( 'a', DB_FIELD_SIZE_FILENAME - 4 ) . '.txt';
+		file_ensure_uploaded( $this->makeFile( array( 'name' => $t_name ) ) );
+	}
+
+	/**
+	 * File type not allowed.
+	 */
+	public function testTypeNotAllowed() {
+		$this->setTestConfig( 'disallowed_files', 'svg' );
+
+		$this->assertUploadFails( $this->makeFile( array( 'name' => 'image.svg' ) ),

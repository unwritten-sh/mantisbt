+/**
+ * Resolve a category handler reference to a user id.
+ *
+ * The reference uses the same shape as other user references in the API:
+ * an array (or object) with an 'id' or a 'name' key. Null means no handler.
+ * Existence of a user given by id is not checked here, see
+ * category_validate_assigned_to().
+ *
+ * @param array|object|null $p_handler Handler reference.
+ *
+ * @return int User identifier, or NO_USER.
+ * @throws ClientException If the reference is invalid, or the user name is not found.
+ */
+function category_resolve_handler( $p_handler ) {
+	if( $p_handler === null ) {
+		return NO_USER;
+	}
+
+	if( is_object( $p_handler ) ) {
+		$p_handler = get_object_vars( $p_handler );
+	}
+
+	if( !is_array( $p_handler ) ) {
+		throw new ClientException( "'handler' must be an object with 'id' or 'name'",
+			ERROR_INVALID_FIELD_VALUE,
+			[ 'handler' ]
+		);
+	}
+
+	if( isset( $p_handler['id'] ) ) {
+		if( !is_numeric( $p_handler['id'] ) || (int)$p_handler['id'] < NO_USER ) {
+			throw new ClientException( "'handler' id must be a valid user identifier",
+				ERROR_INVALID_FIELD_VALUE,
+				[ 'handler' ]
+			);
+		}
+		return (int)$p_handler['id'];
+	}
+
+	if( isset( $p_handler['name'] ) && is_string( $p_handler['name'] ) && !is_blank( $p_handler['name'] ) ) {
+		return (int)user_get_id_by_name( $p_handler['name'], /* throw */ true );
+	}
+
+	throw new ClientException( "'handler' must be an object with 'id' or 'name'",
+		ERROR_INVALID_FIELD_VALUE,
+		[ 'handler' ]
+	);
+}

\n          type: array\n          items:\n            $ref: '#/components/schemas/File'\n        time_tracking:\n          type: object\n          properties:\n            duration:\n              type: string\n        files:\n          type: array\n          items:\n            type: object\n            properties:\n              name:\n                type: string\n              content:\n                type: string\n    IssueNotesAdd:\n      type: object\n      properties:\n        text:\n          type: string\n        view_state:\n          $ref: '#/components/schemas/ViewStateEnum'\n        time_tracking:\n          type: object\n          properties:\n            duration:\n              type: string\n        files:\n          type: array\n          items:\n            type: object\n            properties:\n              name:\n                type: string\n              content:\n                type: string\n      description: Fields accepted when creating an issue note, including attachments and time tracking.\n    IssueCollection:\n      type: object\n      required: [issues]\n      properties:\n        issues:\n          type: array\n          items:\n            $ref: '#/components/schemas/Issue'\n    IssueResponse:\n      type: object\n      required: [issue]\n      properties:\n        issue:\n          $ref: '#/components/schemas/Issue'\n    IssueNoteCollection:\n      type: object\n      required: [notes]\n      properties:\n        notes:\n          type: array\n          items:\n            $ref: '#/components/schemas/IssueNote'\n    IssueNoteResponse:\n      type: object\n      properties:\n        note:\n          $ref: '#/components/schemas/IssueNote'\n        issue:\n          $ref: '#/components/schemas/Issue'\n    File:\n      type: object\n      properties:\n        id:\n          type: integer\n        reporter:\n          $ref: '#/components/schemas/UserRef'\n        created_at:\n          type: string\n          format: date-time\n    
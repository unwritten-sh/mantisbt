ientException( \"'handler' id must be a valid user identifier\",\n\t\t\t\tERROR_INVALID_FIELD_VALUE,\n\t\t\t\t[ 'handler' ]\n\t\t\t);\n\t\t}\n\t\treturn (int)$p_handler['id'];\n\t}\n\n\tif( isset( $p_handler['name'] ) && is_string( $p_handler['name'] ) && !is_blank( $p_handler['name'] ) ) {\n\t\treturn (int)user_get_id_by_name( $p_handler['name'], /* throw */ true );\n\t}\n\n\tthrow new ClientException( \"'handler' must be an object with 'id' or 'name'\",\n\t\tERROR_INVALID_FIELD_VALUE,\n\t\t[ 'handler' ]\n\t);\n}\n\n/**\n * Validate a category's assigned user."}}}

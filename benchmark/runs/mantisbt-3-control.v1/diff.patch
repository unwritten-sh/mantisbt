@@ -146,6 +146,123 @@ class CategoryCommandTest extends MantisCoreBase {
 		}
 	}
 
+	/**
+	 * Test that a global category (ALL_PROJECTS) can be added, updated and deleted.
+	 *
+	 * @return void
+	 */
+	public function testGlobalCategoryCrud() {
+		self::login();
+		$t_name = 'global command category ' . rand( 1, 1000000 );
+
+		$t_data = [
+			'query' => [ 'project_id' => ALL_PROJECTS ],
+			'payload' => [ 'name' => $t_name ],
+		];
+		$t_command = new \CategoryAddCommand( $t_data );
+		$t_result = $t_command->execute();
+		$t_category_id = $t_result['category']['id'];
+
+		try {
+			$this->assertEquals( ALL_PROJECTS, $t_result['category']['project']['id'] );
+			$this->assertEquals( ALL_PROJECTS, (int)category_get_field( $t_category_id, 'project_id' ) );
+			$this->assertTrue( $t_result['category']['enabled'] );
+
+			$t_data = [
+				'query' => [ 'project_id' => '0', 'category_id' => $t_category_id ],
+				'payload' => [ 'name' => $t_name . ' updated', 'enabled' => false ],
+			];
+			$t_command = new \CategoryUpdateCommand( $t_data );
+			$t_result = $t_command->execute();
+			$this->assertEquals( $t_name . ' updated', $t_result['category']['name'] );
+			$this->assertFalse( $t_result['category']['enabled'] );
+
+			$t_data = [ 'query' => [ 'project_id' => ALL_PROJECTS, 'category_id' => $t_category_id ] ];
+			$t_command = new \CategoryDeleteCommand( $t_data );
+			$t_command->execute();
+			$this->assertFalse( category_exists( $t_category_id ) );
+		} finally {
+			if( category_exists( $t_category_id ) ) {
+				category_remove( $t_category_id );
+			}
+		}
+	}
+
+	/**
+	 * Test that a global category is not found through a project id.
+	 *
+	 * @return void
+	 */
+	public function testGlobalCategoryNotFoundInProject() {
+		self::login();
+		$t_category_id = category_add( ALL_PROJECTS, 'global scoped category ' . rand( 1, 1000000 ) );
+
+		try {
+			$t_data = [
+				'query' => [ 'project_id' => 1, 'category_id' => $t_category_id ],
+				'payload' => [ 'name' => 'should not change' ],
+			];
+			$t_command = new \CategoryUpdateCommand( $t_data );
+			try {
+				$t_command->execute();
+				$this->fail( 'A global category must not be updated through a project.' );
+			} catch( ClientException $e ) {
+				$this->assertEquals( ERROR_CATEGORY_NOT_FOUND, $e->getCode() );
+			}
+		} finally {
+			category_remove( $t_category_id );
+		}
+	}
+
+	/**
+	 * Test that an unknown project id is still rejected.
+	 *
+	 * @return void
+	 */
+	public function testUnknownProjectRejected() {
+		self::login();
+		$t_data = [
+			'query' => [ 'project_id' => 1000000 ],
+			'payload' => [ 'name' => 'unknown project category' ],
+		];
+		$t_command = new \CategoryAddCommand( $t_data );
+		$this->expectException( ClientException::class );
+		$this->expectExceptionCode( ERROR_PROJECT_NOT_FOUND );
+		$t_command->execute();
+	}
+
+	/**
+	 * Test that the commands ignore the SOAP-only status field.
+	 *
+	 * @return void
+	 */
+	public function testStatusPayloadIgnored() {
+		self::login();
+		$t_data = [
+			'query' => [ 'project_id' => 1 ],
+			'payload' => [ 'name' => 'status ignored category ' . rand( 1, 1000000 ), 'status' => CATEGORY_STATUS_DISABLED ],
+		];
+		$t_command = new \CategoryAddCommand( $t_data );
+		$t_result = $t_command->execute();
+		$t_category_id = $t_result['category']['id'];
+
+		try {
+			$this->assertTrue( $t_result['category']['enabled'] );
+			$this->assertTrue( category_is_enabled( $t_category_id ) );
+
+			$t_data = [
+				'query' => [ 'project_id' => 1, 'category_id' => $t_category_id ],
+				'payload' => [ 'status' => CATEGORY_STATUS_DISABLED ],
+			];
+			$t_command = new \CategoryUpdateCommand( $t_data );
+			$t_result = $t_command->execute();
+			$this->assertTrue( $t_result['category']['enabled'] );
+			$this->assertArrayNotHasKey( 'status', $t_result['category'] );
+		} finally {
+			category_remove( $t_category_id );
+		}
+	}

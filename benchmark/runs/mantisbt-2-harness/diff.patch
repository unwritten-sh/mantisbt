+	/**
+	 * Test add, get and update of the category handler with user references.
+	 *
+	 * @return void
+	 */
+	public function testHandlerAsUserReference() {
+		self::login();
+		$t_handle_bug_threshold = config_get( 'handle_bug_threshold', null, null, 1 );
+		$t_username = 'category_ref_handler_' . rand( 1, 1000000 );
+		user_create( $t_username, 'password', $t_username . '@localhost.localdomain', $t_handle_bug_threshold, false, true );
+		$t_user_id = user_get_id_by_name( $t_username );
+		$t_category_id = null;
+
+		try {
+			$t_command = new \CategoryAddCommand( [
+				'query' => [ 'project_id' => 1 ],
+				'payload' => [
+					'name' => 'command ref handler ' . rand( 1, 1000000 ),
+					'handler' => [ 'name' => $t_username ],
+				],
+			] );
+			$t_category = $t_command->execute()['category'];
+			$t_category_id = $t_category['id'];
+			$this->assertEquals( $t_user_id, $t_category['handler']['id'] );
+			$this->assertEquals( $t_username, $t_category['handler']['name'] );
+			$this->assertArrayNotHasKey( 'default_handler', $t_category );
+			$this->assertEquals( $t_user_id, (int)category_get_field( $t_category_id, 'user_id' ) );
+
+			# Get returns the handler under 'handler'
+			$t_command = new \CategoryGetCommand( [ 'query' => [ 'project_id' => 1, 'category_id' => $t_category_id ] ] );
+			$t_category = $t_command->execute()['categories'][0];
+			$this->assertEquals( $t_user_id, $t_category['handler']['id'] );
+
+			# Missing handler on update keeps the current one
+			$t_command = new \CategoryUpdateCommand( [
+				'query' => [ 'project_id' => 1, 'category_id' => $t_category_id ],
+				'payload' => [ 'enabled' => false ],
+			] );
+			$t_category = $t_command->execute()['category'];
+			$this->assertEquals( $t_user_id, $t_category['handler']['id'] );
+
+			# Null handler on update clears it
+			$t_command = new \CategoryUpdateCommand( [
+				'query' => [ 'project_id' => 1, 'category_id' => $t_category_id ],
+				'payload' => [ 'handler' => null ],
+			] );
+			$t_category = $t_command->execute()['category'];
+			$this->assertArrayNotHasKey( 'handler', $t_category );
+			$this->assertEquals( NO_USER, (int)category_get_field( $t_category_id, 'user_id' ) );
+
+			# Set by id
+			$t_command = new \CategoryUpdateCommand( [
+				'query' => [ 'project_id' => 1, 'category_id' => $t_category_id ],
+				'payload' => [ 'handler' => [ 'id' => $t_user_id ] ],
+			] );
+			$t_category = $t_command->execute()['category'];
+			$this->assertEquals( $t_user_id, $t_category['handler']['id'] );
+		} finally {
+			if( $t_category_id !== null ) {
+				category_remove( $t_category_id );
+			}
+			user_delete( $t_user_id );
+		}
+	}

 }
 
+/**
+ * Resolve the category handler of a command payload to a user id.
+ *
+ * The handler is a user reference: an array with 'id' or 'name', for
+ * example [ 'id' => 5 ] or [ 'name' => 'john' ]. Null (or id 0) means no
+ * handler. The user is not checked here: call category_validate_assigned_to()
+ * on the result. A user name that does not exist throws a not found error.
+ *
+ * @param mixed $p_handler User reference, or null.
+ *
+ * @return int User identifier, or NO_USER.
+ * @throws ClientException If the reference is invalid or the user name is not found.
+ */
+function category_handler_to_user_id( $p_handler ) {
+	if( $p_handler === null ) {
+		return NO_USER;
+	}
+
+	if( !is_array( $p_handler ) ) {
+		throw new ClientException( "'handler' must be an object with 'id' or 'name'",
+			ERROR_INVALID_FIELD_VALUE,
+			[ 'handler' ]
+		);
+	}
+
+	if( isset( $p_handler['id'] ) && !is_numeric( $p_handler['id'] ) ) {
+		throw new ClientException( "'handler' id must be a valid user identifier",
+			ERROR_INVALID_FIELD_VALUE,
+			[ 'handler' ]
+		);
+	}
+
+	if( !isset( $p_handler['id'] ) && ( !isset( $p_handler['name'] ) || !is_string( $p_handler['name'] ) ) ) {
+		throw new ClientException( "'handler' must be an object with 'id' or 'name'",
+			ERROR_INVALID_FIELD_VALUE,
+			[ 'handler' ]
+		);
+	}
+
+	return (int)user_get_id_by_user_info( $p_handler, /* throw if id not found */ false, /* allow all users */ true );
+}

ectVersionsUpdate:\n      content:\n        application/json:\n          schema:\n            $ref: '#/components/schemas/ProjectVersionsUpdate'\n      description: ''\n      required: true\n    ProjectCategoriesAdd:\n      content:\n        application/json:\n          schema:\n            $ref: '#/components/schemas/ProjectCategoriesAdd'\n      required: true\n    ProjectCategoriesUpdate:\n      content:\n        application/json:\n          schema:\n            $ref: '#/components/schemas/ProjectCategoriesUpdate'\n      required: true\n    ProjectSubprojectsAdd:\n      content:\n        application/json:\n          schema:\n            $ref: '#/components/schemas/ProjectSubprojectsAdd'\n      description: ''\n      required: true\n    ProjectSubprojectsUpdate:\n      content:\n        application/json:\n          schema:\n            $ref: '#/components/schemas/ProjectSubprojectsUpdate'\n      description: ''\n      required: true\n    ProjectUsersUpsert:\n      content:\n        application/json:\n          schema:\n            $ref: '#/components/schemas/ProjectUsersUpsert'\n      description: ''\n      required: true\n    UserAdd:\n      content:\n        application/json:\n          schema:\n            $ref: '#/components/schemas/UserWithPassword'\n      description: ''\n      required: true\n    UserUpdate:\n      content:\n        application/json:\n          schema:\n            $ref: '#/components/schemas/User'\n      description: ''\n      required: true\n  parameters:\n    If-Match:\n      name: If-Match\n      in: header\n      required: false\n      schema:\n        type: string\n      description: ETag returned by a prior issue read. The operation fails with 412 if it no longer matches.\n    If-None-Match:\n      name: If-None-Match\n      in: header\n      required: false\n      schema:\n        type: string\n      description: ETag returned by a prior issue read. A matching value returns 304 without a response body.\n    X-Mantis-Username:\n      
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017KMitQdrKGcqDaxCR8gh4S","type":"tool_result","content":"1\t<?php\n2\t# MantisBT - A PHP based bugtracking system\n3\t\n4\t# MantisBT is free software: you can redistribute it and/or modify\n5\t# it under the terms of the GNU General Public License as published by\n6\t# the Free Software Foundation, either version 2 or later.\n7\t#\n8\t# MantisBT is distributed in the hope that it will be useful,\n9\t# but WITHOUT ANY WARRANTY; without even the implied warranty of\n10\t# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n11\t# GNU General Public License for more details.\n12\t#\n13\t# You should have received a copy of the GNU General Public License\n14\t# along with MantisBT.  If not, see <http://www.gnu.org/licenses/>.\n15\t\n16\t/**\n17\t * Tests for project category commands.\n18\t *\n19\t * @package Tests\n20\t * @subpackage MantisCoreTests\n21\t * @copyright Copyright MantisBT Team - mantisbt-dev@lists.sourceforge.net\n22\t * @link http://www.mantisbt.org\n23\t */\n24\t\n25\tnamespace Mantis\\tests\\Mantis;\n26\t\n27\tuse Mantis\\Exceptions\\ClientException;\n28\t\n29\t/**\n30\t * Test fixture for category command validation.\n31\t */\n32\tclass CategoryCommandTest extends MantisCoreBase {\n33\t\t/**\n34\t\t * Test that a disabled category handler is not auto-assigned to new issues.\n35\t\t *\n36\t\t * @return void\n37\t\t */\n38\t\tpublic function testDisabledCategoryHandlerIsNotAutoAssigned() {\n39\t\t\tself::login();\n40\t\t\t$t_handle_bug_threshold = config_get( 'handle_bug_threshold', null, null, 1 );\n41\t\t\t$t_username = 'category_disabled_handler_' . rand( 1, 1000000 );\n42\t\t\tuser_create( $t_username, 'password', $t_username . '@localhost.localdomain', $t_handle_bug_threshold, false, true );\n43\t\t\t$t_user_id = user_get_id_by_name( $t_username );\n44\t\t\t$t_category_id = category_add( 1, 'disabled handler category ' . rand( 1, 1000000 ) );\n45\t\t\tcategory_update( $t_category_id, category_get_name( $t_category_id ), $t_user_id );\n46\t\t\tuser_set_field( $t_user_id, 'enabled', false );\n47\t\n48\t\t\ttry {\n49\t\t\t\t$t_issue_id = $this->createIssueWithCategory( $t_category_id );\n50\t\t\t\t$this->assertEquals( NO_USER, bug_get_field( $t_issue_id, 'handler_id' ) );\n51\t\t\t} finally {\n52\t\t\t\tif( isset( $t_issue_id ) ) {\n53\t\t\t\t\tbug_delete( $t_issue_id );\n54\t\t\t\t}\n55\t\t\t\tcategory_remove( $t_category_id );\n56\t\t\t\tuser_delete( $t_user_id );\n57\t\t\t}\n58\t\t}\n59\t\n60\t\t/**\n61\t\t * Test that a category handler without project access is not auto-assigned.\n62\t\t *\n63\t\t * @return void\n64\t\t */\n65\t\tpublic function testCategoryHandlerWithoutAccessIsNotAutoAssigned() {\n66\t\t\tself::login();\n67\t\t\t$t_handle_bug_threshold = config_get( 'handle_bug_threshold', null, null, 1 );\n68\t\t\tif( $t_handle_bug_threshold <= ANYBODY ) {\n69\t\t\t\t$this->markTestSkipped( 'The handler threshold cannot be lowered in this test configuration.' );\n70\t\t\t}\n71\t\n72\t\t\t$t_username = 'category_inaccessible_handler_' . rand( 1, 1000000 );\n73\t\t\tuser_create( $t_username, 'password', $t_username . '@localhost.localdomain', $t_handle_bug_threshold, false, true );\n74\t\t\t$t_user_id = user_get_id_by_name( $t_username );\n75\t\t\t$t_category_id = category_add( 1, 'inaccessible handler category ' . rand( 1, 1000000 ) );\n76\t\t\tcategory_update( $t_category_id, category_get_name( $t_category_id ), $t_user_id );\n77\t\t\tuser_set_field( $t_user_id, 'access_level', $t_handle_bug_threshold - 1 );\n78\t\n79\t\t\ttry {\n80\t\t\t\t$t_issue_id = $this->createIssueWithCategory( $t_category_id );\n81\t\t\t\t$this->assertEquals( NO_USER, bug_get_field( $t_issue_id, 'handler_id' ) );\n82\t\t\t} finally {\n83\t\t\t\tif( isset( $t_issue_id ) ) {\n84\t\t\t\t\tbug_delete( $t_issue_id );\n85\t\t\t\t}\n86\t\t\t\tcategory_remove( $t_category_id );\n87\t\t\t\tuser_delete( $t_user_id );\n88\t\t\t}\n89\t\t}\n90\t\n91\t\t/**\n92\t\t * Test that updating other fields does not revalidate an unchanged handler.\n93\t\t *\n94\t\t * @return void\n95\t\t */\n96\t\tpublic function testUpdateAllowsUnchangedInvalidHandler() {\n97\t\t\tself::login();\n98\t\t\t$t_handle_bug_threshold = config_get( 'handle_bug_threshold', null, null, 1 );\n99\t\t\t$t_username = 'category_stale_handler_' . rand( 1, 1000000 );\n100\t\t\tuser_create( $t_username, 'password', $t_username . '@localhost.localdomain', $t_handle_bug_threshold, false, true );\n101\t\t\t$t_user_id = user_get_id_by_name( $t_username );\n102\t\t\t$t_disabled_category_id = category_add( 1, 'disabled stale category ' . rand( 1, 1000000 ) );\n103\t\t\tcategory_update( $t_disabled_category_id, category_get_name( $t_disabled_category_id ), $t_user_id );\n104\t\t\tcategory_cache_flush( 1 );\n105\t\t\tuser_set_field( $t_user_id, 'enabled', false );\n106\t\n107\t\t\ttry {\n108\t\t\t\t$t_data = [\n109\t\t\t\t\t'query' => [ 'project_id' => 1, 'category_id' => $t_disabled_category_id ],\n110\t\t\t\t\t'payload' => [\n111\t\t\t\t\t\t'name' => 'disabled stale category updated',\n112\t\t\t\t\t\t'assigned_to' => $t_user_id,\n113\t\t\t\t\t],\n114\t\t\t\t];\n115\t\t\t\t$t_command = new \\CategoryUpdateCommand( $t_data );\n116\t\t\t\t$t_result = $t_command->execute();\n117\t\t\t\t$this->assertEquals( 'disabled stale category updated', $t_result['category']['name'] );\n118\t\t\t} finally {\n119\t\t\t\tcategory_remove( $t_disabled_category_id );\n120\t\t\t\tuser_delete( $t_user_id );\n121\t\t\t}\n122\t\n123\t\t\t$t_deleted_username = 'category_deleted_handler_' . rand( 1, 1000000 );\n124\t\t\tuser_create( $t_deleted_username, 'password', $t_deleted_username . '@localhost.localdomain', $t_handle_bug_threshold, false, true );\n125\t\t\t$t_deleted_user_id = user_get_id_by_name( $t_deleted_username );\n126\t\t\t$t_deleted_category_id = category_add( 1, 'deleted stale category ' . rand( 1, 1000000 ) );\n127\t\t\tcategory_update( $t_deleted_category_id, category_get_name(
> [ 'enabled' => false ],\n\t\t\t] );\n\t\t\t$t_category = $t_command->execute()['category'];\n\t\t\t$this->assertEquals( $t_user_id, $t_category['handler']['id'] );\n\n\t\t\t# Null handler on update clears it\n\t\t\t$t_command = new \\\\CategoryUpdateCommand( [\n\t\t\t\t'query' => [ 'project_id' => 1, 'category_id' => $t_category_id ],\n\t\t\t\t'payload' => [ 'handler' => null ],\n\t\t\t] );\n\t\t\t$t_category = $t_command->execute()['category'];\n\t\t\t$this->assertArrayNotHasKey( 'handler', $t_category );\n\t\t\t$this->assertEquals( NO_USER, (int)category_get_field( $t_category_id, 'user_id' ) );\n\n\t\t\t# Set by id\n\t\t\t$t_command = new \\\\CategoryUpdateCommand( [\n\t\t\t\t'query' => [ 'project_id' => 1, 'category_id' => $t_category_id ],\n\t\t\t\t'payload' => [ 'handler' => [ 'id' => $t_user_id ] ],\n\t\t\t] );\n\t\t\t$t_category = $t_command->execute()['category'];\n\t\t\t$this->assertEquals( $t_user_id, $t_category['handler']['id'] );\n\t\t} finally {\n\t\t\tif( $t_category_id !== null ) {\n\t\t\t\tcategory_remove( $t_category_id );\n\t\t\t}\n\t\t\tuser_delete( $t_user_id );\n\t\t}\n\t}\n\n\t/**\n\t * Test that unknown handlers give a not found error and invalid ones a bad request.\n\t *\n\t * @return void\n\t */\n\tpublic function testHandlerNotFoundOrInvalid() {\n\t\tself::login();\n\t\t$t_category_id = category_add( 1, 'command unknown handler ' . rand( 1, 1000000 ) );\n\t\t$t_unknown_name = 'category_no_such_user_' . rand( 1, 1000000 );\n\n\t\t$t_cases = [\n\t\t\t[ [ 'id' => 1000000 ], ERROR_USER_BY_ID_NOT_FOUND ],\n\t\t\t[ [ 'name' => $t_unknown_name ], ERROR_USER_BY_NAME_NOT_FOUND ],\n\t\t\t[ 1, ERROR_INVALID_FIELD_VALUE ],\n\t\t\t[ [ 'id' => 'abc' ], ERROR_INVALID_FIELD_VALUE ],\n\t\t\t[ [], ERROR_INVALID_FIELD_VALUE ],\n\t\t];\n\n\t\ttry {\n\t\t\tforeach( $t_cases as $t_case ) {\n\t\t\t\tlist( $t_handler, $t_expected_code ) = $t_case;\n\t\t\t\t$t_commands = [\n\t\t\t\t\tnew \\\\CategoryAddCommand( [\n\t\t\t\t\t\t'query' => [ 'project_id' => 1 ],\n\t\t\t\t\t\t'payload' => [ 'name' => 'command unknown add ' . rand( 1, 1000000 ), 'handler' => $t_handler ],\n\t\t\t\t\t] ),\n\t\t\t\t\tnew \\\\CategoryUpdateCommand( [\n\t\t\t\t\t\t'query' => [ 'project_id' => 1, 'category_id' => $t_category_id ],\n\t\t\t\t\t\t'payload' => [ 'handler' => $t_handler ],\n\t\t\t\t\t] ),\n\t\t\t\t];\n\t\t\t\tforeach( $t_commands as $t_command ) {\n\t\t\t\t\ttry {\n\t\t\t\t\t\t$t_command->execute();\n\t\t\t\t\t\t$this->fail( 'Handler ' . json_encode( $t_handler ) . ' must be rejected.' );\n\t\t\t\t\t} catch( ClientException $e ) {\n\t\t\t\t\t\t$this->assertEquals( $t_expected_code, $e->getCode(), json_encode( $t_handler ) );\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t} finally {\n\t\t\tcategory_remove( $t_category_id );\n\t\t}\n\t}\n\n\t/**\n\t * Assert that a command rejects an assigned user.\"\"\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"assigned_to\\|default_handler\" tests/Mantis/CategoryCommandTest.php tests/rest/RestProjectCategoryTest.php"}}}

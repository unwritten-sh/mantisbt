ategoryAddCommand( $t_data );\n178\t\t\t$t_result = $t_command->execute();\n179\t\t\t$t_category = $t_result['category'];\n180\t\n181\t\t\ttry {\n182\t\t\t\t$this->assertEquals( ALL_PROJECTS, $t_category['project']['id'] );\n183\t\t\t} finally {\n184\t\t\t\tcategory_remove( $t_category['id'] );\n185\t\t\t}\n186\t\t}\n187\t\n188\t\t/**\n189\t\t * Test that disabled users cannot be assigned when adding or updating.\n190\t\t *\n191\t\t * @return void\n192\t\t */\n193\t\tpublic function testAssignedUserMustBeEnabled() {\n194\t\t\tself::login();\n195\t\t\t$t_username = 'category_disabled_' . rand( 1, 1000000 );\n196\t\t\tuser_create( $t_username, 'password', $t_username . '@localhost.localdomain', REPORTER, false, false );\n197\t\t\t$t_user_id = user_get_id_by_name( $t_username );\n198\t\t\t$t_category_id = category_add( 1, 'command handler category ' . rand( 1, 1000000 ) );\n199\t\n200\t\t\ttry {\n201\t\t\t\t$t_data = [\n202\t\t\t\t\t'query' => [ 'project_id' => 1 ],\n203\t\t\t\t\t'payload' => [\n204\t\t\t\t\t\t'name' => 'command disabled handler ' . rand( 1, 1000000 ),\n205\t\t\t\t\t\t'assigned_to' => $t_user_id,\n206\t\t\t\t\t],\n207\t\t\t\t];\n208\t\t\t\t$t_command = new \\CategoryAddCommand( $t_data );\n209\t\t\t\t$this->assertAssignedUserRejected( $t_command );\n210\t\n211\t\t\t\t$t_data = [\n212\t\t\t\t\t'query' => [ 'project_id' => 1, 'category_id' => $t_category_id ],\n213\t\t\t\t\t'payload' => [ 'assigned_to' => $t_user_id ],\n214\t\t\t\t];\n215\t\t\t\t$t_command = new \\CategoryUpdateCommand( $t_data );\n216\t\t\t\t$this->assertAssignedUserRejected( $t_command );\n217\t\t\t} finally {\n218\t\t\t\tcategory_remove( $t_category_id );\n219\t\t\t\tuser_delete( $t_user_id );\n220\t\t\t}\n221\t\t}\n222\t\n223\t\t/**\n224\t\t * Assert that a command rejects an assigned user.\n225\t\t *\n226\t\t * @param \\Command $p_command Category command to execute.\n227\t\t *\n228\t\t * @return void\n229\t\t */\n230\t\tprivate function assertAssignedUserRejected( \\Command $p_comm
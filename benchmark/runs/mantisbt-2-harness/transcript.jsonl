eters:\n      - $ref: '#/components/parameters/X-Mantis-Username'\n    delete:\n      summary: Project Delete User\n      operationId: ProjectUsersDelete\n      description: ''\n      tags:\n        - 'Project Users'\n      parameters:\n        - $ref: '#/components/parameters/project_id'\n        - $ref: '#/components/parameters/user_id'\n      responses:\n        '204':\n          $ref: '#/components/responses/NoContent'\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '404':\n          $ref: '#/components/responses/NotFound'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '503':\n          $ref: '#/components/responses/ServiceUnavailable'\n  '/api/rest/users':\n    parameters:\n      - $ref: '#/components/parameters/X-Mantis-Username'\n    get:\n      summary: Get users\n      operationId: UserGetAll\n      description: Returns users visible to the effective user.\n      tags:\n        - 'Users'\n      parameters:\n        - name: select\n          in: query\n          schema:\n            type: string\n          description: Comma-separated list of user fields to return.\n          required: false\n          example: id,name,real_name,email,access_level\n      responses:\n        '200':\n          $ref: '#/components/responses/Success'\n        '400':\n          $ref: '#/components/responses/BadRequest'\n        '404':\n          $ref: '#/components/responses/NotFound'\n        '401':\n          $ref: '#/components/responses/Unauthorized'\n        '403':\n          $ref: '#/components/responses/Forbidden'\n        '503':\n          $ref: '#/components/responses/ServiceUnavailable'\n    post:\n      summary: Create a user\n      operationId: UserAdd\n      description: ''\n      tags:\n        - 'Users'\n      requestBody:\n        $ref: '#/components/requestBodies/UserAdd'\n      responses:\n        '201':\n          $ref: '#/component
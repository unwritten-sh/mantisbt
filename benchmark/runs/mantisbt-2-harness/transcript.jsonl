.\n54\t\t * @return void\n55\t\t */\n56\t\tprivate function deleteCategory( int $p_category_id ): void {\n57\t\t\t$t_response = $this->builder()->delete( $this->base_url . $p_category_id )->send();\n58\t\t\t$this->assertEquals( HTTP_STATUS_NO_CONTENT, $t_response->getStatusCode() );\n59\t\t}\n60\t\n61\t\t/**\n62\t\t * Set up the project category endpoint.\n63\t\t *\n64\t\t * @return void\n65\t\t */\n66\t\tpublic function setUp(): void {\n67\t\t\tparent::setUp();\n68\t\t\t$this->base_url = '/projects/' . $this->getProjectId() . '/categories/';\n69\t\t}\n70\t\n71\t\t/**\n72\t\t * Test creating, retrieving, updating, and deleting a project category.\n73\t\t *\n74\t\t * @return void\n75\t\t */\n76\t\tpublic function testProjectCategoryCrud() {\n77\t\t\t$t_name = 'REST category ' . rand( 1, 1000000 );\n78\t\t\t$t_category = $this->createCategory( [ 'name' => $t_name ] );\n79\t\t\t$this->assertEquals( $t_name, $t_category['name'] );\n80\t\t\t$this->assertEquals( $this->getProjectId(), $t_category['project']['id'] );\n81\t\t\t$this->assertTrue( $t_category['enabled'] );\n82\t\t\t$this->assertArrayNotHasKey( 'status', $t_category );\n83\t\n84\t\t\t$t_id = $t_category['id'];\n85\t\t\t$t_response = $this->builder()->get( $this->base_url . $t_id )->send();\n86\t\t\t$this->assertEquals( HTTP_STATUS_SUCCESS, $t_response->getStatusCode() );\n87\t\t\t$t_category = json_decode( $t_response->getBody(), true )['categories'][0];\n88\t\t\t$this->assertEquals( $t_id, $t_category['id'] );\n89\t\t\t$this->assertEquals( $this->getProjectId(), $t_category['project']['id'] );\n90\t\t\t$this->assertTrue( $t_category['enabled'] );\n91\t\t\t$this->assertArrayNotHasKey( 'status', $t_category );\n92\t\n93\t\t\t$t_response = $this->builder()->patch( $this->base_url . $t_id, [ 'name' => $t_name . ' updated' ] )->send();\n94\t\t\t$this->assertEquals( HTTP_STATUS_SUCCESS, $t_response->getStatusCode() );\n95\t\t\t$this->assertEquals( $t_name . ' updated', json_decode( $t_response->getBody(), true )['category']['name'] );\n96\t\n97\t\t\t$this->deleteCategory( $t_id );\n98\t\t\t$this->assertEquals( HTTP_STATUS_NOT_FOUND, $this->builder()->get( $this->base_url . $t_id )->send()->getStatusCode() );\n99\t\t}\n100\t\n101\t\t/**\n102\t\t * Test retrieving the project category collection.\n103\t\t *\n104\t\t * @return void\n105\t\t */\n106\t\tpublic function testProjectCategoryList() {\n107\t\t\t$t_category = $this->createCategory( [ 'name' => 'REST listed category ' . rand( 1, 1000000 ) ] );\n108\t\n109\t\t\t$t_response = $this->builder()->get( $this->base_url )->send();\n110\t\t\t$this->assertEquals( HTTP_STATUS_SUCCESS, $t_response->getStatusCode() );\n111\t\t\t$t_categories = json_decode( $t_response->getBody(), true )['categories'];\n112\t\t\t$this->assertContains( $t_category['id'], array_column( $t_categories, 'id' ) );\n113\t\n114\t\t\t$this->deleteCategory( $t_category['id'] );\n115\t\t}\n116\t\n117\t\t/**\n118\t\t * Test category assigned user and status fields through add and update.\n119\t\t *\n120\t\t * @return void\n121\t\t */\n122\t\tpublic function testProjectCategoryAssignedAndStatusFields() {\n123\t\t\t$t_category = $this->createCategory( [\n124\t\t\t\t'name' => 'REST assigned category ' . rand( 1, 1000000 ),\n125\t\t\t\t'assigned_to' => $this->userId,\n126\t\t\t\t'enabled' => false,\n127\t\t\t] );\n128\t\t\t$this->assertFalse( $t_category['enabled'] );\n129\t\t\t$this->assertArrayNotHasKey( 'status', $t_category );\n130\t\t\t$this->assertEquals( $this->userId, $t_category['default_handler']['id'] );\n131\t\n132\t\t\t$t_response = $this->builder()->patch( $this->base_url . $t_category['id'], [ 'enabled' => true ] )->send();\n133\t\t\t$this->assertEquals( HTTP_STATUS_SUCCESS, $t_response->getStatusCode() );\n134\t\t\t$t_category = json_decode( $t_response->getBody(), true )['category'];\n135\t\t\t$this->assertTrue( $t_category['enabled'] );\n136\t\t\t$this->assertArrayNotHasKey( 'status', $t_category );\n137\t\t\t$this->assertEquals( $this->getProjectId(), $t_category['project']['id'] );\n138\t\t\t$this->assertEquals( $this->userId, $t_category['default_handler']['id'] );\n139\t\n140\t\t\t$this->deleteCategory( $t_category['id'] );\n141\t\t}\n142\t\n143\t\t/**\n144\t\t * Test that the REST API ignores the SOAP-only status field.\n145\t\t *\n146\t\t * @return void\n147\t\t */\n148\t\tpublic function testProjectCategoryStatusFieldIsNotSupported() {\n149\t\t\t$t_response = $this->builder()->post( $this->base_url, [\n150\t\t\t\t'name' => 'REST status category ' . rand( 1, 1000000 ),\n151\t\t\t\t'status' => CATEGORY_STATUS_DISABLED,\n152\t\t\t] )->send();\n153\t\t\t$this->assertEquals( HTTP_STATUS_CREATED, $t_response->getStatusCode() );\n154\t\t\t$t_category = json_decode( $t_response->getBody(), true )['category'];\n155\t\t\t$this->assertTrue( $t_category['enabled'] );\n156\t\t\t$this->assertArrayNotHasKey( 'status', $t_category );\n157\t\t\t$this->deleteCategory( $t_category['id'] );\n158\t\n159\t\t\t$t_category = $this->createCategory( [ 'name' => 'REST status update category ' . rand( 1, 1000000 ) ] );\n160\t\t\t$t_response = $this->builder()->patch( $this->base_url . $t_category['id'], [ 'status' => CATEGORY_STATUS_DISABLED ] )->send();\n161\t\t\t$this->assertEquals( HTTP_STATUS_SUCCESS, $t_response->getStatusCode() );\n162\t\t\t$t_updated_category = json_decode( $t_response->getBody(), true )['category'];\n163\t\t\t$this->assertTrue( $t_updated_category['enabled'] );\n164\t\t\t$this->assertArrayNotHasKey( 'status', $t_updated_category );\n165\t\n166\t\t\t$this->deleteCategory( $t_category['id'] );\n167\t\t}\n168\t\n169\t\t/**\n170\t\t * Test that assigned users must exist when adding or updating categories.\n171\t\t *\n172\t\t * @return void\n173\t\t */\n174\t\tpublic function testProjectCategoryAssignedToMustExist() {\n175\t\t\t$t_response = $this->builder()->post( $this->base_url, [\n176\t\t\t\t'name' => 'REST invalid handler ' . rand( 1, 1000000 ),\n177\t\t\t\t'assigned_to' => 1000000,\n178\t\t\t] )->send();\n179\t\t\t$this->assertEquals( HTTP_STATUS_NOT_FOUND, $t_response->getStatusCode() );\n180\t\n181\t\t\t$t_category = $this->createCategory( [ 'name' => 'REST update handler ' . rand( 1, 1000000 ) ] );\n182\t\t\t$t_response = $this->builder()->patch( $this->base_url . $t_category['id'], [ 'assigned_to' => 1000000 ] )->send();\n183\t\t\t$this->assertEquals( HTTP_STATUS_NOT_FOUND, $t_response->getStatusCode() );\n184\t\n185\t\t\t$this->deleteCategory( $t_category['id'] );\n186\t\t}\n187\t\n188\t\t/**\n189\t\t * Test that duplicate category names are rejected.\n190\t\t *\n191\t\t * @return void\n192\t\t */\n193\t\tpublic function testProjectCategoryDuplicateName() {\n194\t\t\t$t_name = 'REST duplicate category ' . rand( 1, 1000000 );\n195\t\t\t$t_category = $this->createCategory( [ 'name' => $t_name ] );\n196\t\n197\t\t\t$t_response = $this->builder()->post( $this->base_url, [ 'name' => $t_name ] )->send();\n198\t\t\t$this->assertEquals( HTTP_STATUS_BAD_REQUEST, $t_response->getStatusCode() );\n199\t\n200\t\t\t$this->deleteCategory( $t_category['id'] );\n201\t\t}\n202\t\n203\t\t/**\n204\t\t * Test that the configured default category cannot be deleted.\n205\t\t *\n206\t\t * @return void\n207\t\t */\n208\t\tpublic function testProjectCategoryCannotDeleteDefault() {\n209\t\t\t$t_default_category_id = config_get( 'default_category_for_moves' );\n210\t\t\tif( category_exists( $t_default_category_id ) ) {\n211\t\t\t\t$t_default_category_project = (int)category_get_field( $t_default_category_id, 'project_id' );\n212\t\t\t\t$t_skip = $t_default_category_project !== ALL_PROJECTS && $t_default_category_project !== $this->getProjectId();\n213\t\t\t} else {\n214\t\t\t\t$t_skip = true;\n215\t\t\t}\n216\t\t\tif( $t_skip ) {\n217\t\t\t\t$this->markTestSkipped( 'The configured default category does not exist in the test project.' );\n218\t\t\t}\n219\t\n220\t\t\t# Check varies depending on whether category is global or project-specific\n221\t\t\t/** @noinspection PhpUndefinedVariableInspection */\n222\t\t\tif( ALL_PROJECTS == $t_default_category_project ) {\n223\t\t\t\t$t_endpoint = '/projects/0/categories/';\n224\t\t\t\t# category_ensure_can_remove() triggers ERROR_CATEGORY_CANNOT_UPDATE_DEFAULT which maps to 500\n225\t\t\t\t$t_expected = HTTP_STATUS_INTERNAL_SERVER_ERROR;\n226\t\t\t} else {\n227\t\t\t\t$t_endpoint = $this->base_url;\n228\t\t\t\t$t_expected = HTTP_STATUS_BAD_REQUEST;\n229\t\t\t}\n230\t\n231\t\t\t$t_response = $this->builder()->delete( $t_endpoint . $t_default_category_id )->send();\n232\t\t\t$this->assertEquals( $t_expected, $t_response->getStatusCode() );\n233\t\t}\n234\t\n235\t\t/**\n236\t\t * Test that anonymous users cannot update or delete categories.\n237\t\t *\n238\t\t * @return void\n239\t\t */\n240\t\tpublic function testProjectCategoryAnonymousAccess() {\n241\t\t\t$this->skipTestIfAnonymousDisabled();\n242\t\t\t$t_category = $this->createCategory( [ 'name' => 'REST anonymous category ' . rand( 1, 1000000 ) ] );\n243\t\n244\t\t\t$t_response = $this->builder()->patch( $this->base_url . $t_category['id'], [ 'name' => 'should fail' ] )->anonymous()->send();\n245\t\t\t$this->assertEquals( HTTP_STATUS_FORBIDDEN, $t_response->getStatusCode() );\n246\t\t\t$t_response = $this->builder()->delete( $this->base_url . $t_category['id'] )->anonymous()->send();\n247\t\t\t$this->assertEquals( HTTP_STATUS_FORBIDDEN, $t_response->getStatusCode() );\n248\t\n249\t\t\t$this->deleteCategory( $t_category['id'] );\n250\t\t}\n251\t\n252\t\t/**\n253\t\t * Test that category creation requires a name.\n254\t\t *\n255\t\t * @return void\n256\t\t */\n257\t\tpublic function testProjectCategoryRequiresName() {\n258\t\t\t$t_response = $this->builder()->post( $this->base_url, [] )->send();\n259\t\t\t$this->assertEquals( HTTP_STATUS_BAD_REQUEST, $t_response->getStatusCode() );\n260\t\t}\n261\t\n262\t\t/**\n263\t\t * Test that category lookup does not cross the project boundary.\n264\t\t *\n265\t\t * @return void\n266\t\t */\n267\t\tpublic function testPr
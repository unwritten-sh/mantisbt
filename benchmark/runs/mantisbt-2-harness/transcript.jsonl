{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0126hYow8EkcfFD8sTCLjmUw","type":"tool_result","content":"280\t\n281\t/**\n282\t * Add a new category to a project.\n283\t *\n284\t * @param string $p_username      The name of the user trying to access the categories.\n285\t * @param string $p_password      The password of the user.\n286\t * @param int    $p_project_id    The id of the project for which to add the category.\n287\t * @param string $p_category_name The name of the new category to add.\n288\t *\n289\t * @return int|RestFault|SoapFault Id of the new category\n290\t */\n291\tfunction mc_project_add_category( $p_username, $p_password, $p_project_id, $p_category_name ) {\n292\t\tif( mci_check_login( $p_username, $p_password ) === false ) {\n293\t\t\treturn mci_fault_login_failed();\n294\t\t}\n295\t\n296\t\t$t_data = [\n297\t\t\t'query' => [ 'project_id' => $p_project_id ],\n298\t\t\t'payload' => [ 'name' => $p_category_name ],\n299\t\t];\n300\t\t$t_command = new CategoryAddCommand( $t_data );\n301\t\t$t_result = $t_command->execute();\n302\t\n303\t\treturn $t_result['category']['id'];\n304\t}\n305\t\n306\t/**\n307\t * Delete a category of a project.\n308\t *\n309\t * @param string $p_username      The name of the user trying to access the categories.\n310\t * @param string $p_password      The password of the user.\n311\t * @param int    $p_project_id    The id of the project to retrieve the categories for.\n312\t * @param string $p_category_name The name of the category to delete.\n313\t *\n314\t * @return bool|RestFault|SoapFault True or false depending on the success of the delete action.\n315\t */\n316\tfunction mc_project_delete_category( $p_username, $p_password, $p_project_id, $p_category_name ) {\n317\t\tif( mci_check_login( $p_username, $p_password ) === false ) {\n318\t\t\treturn mci_fault_login_failed();\n319\t\t}\n320\t\n321\t\t$t_data = [\n322\t\t\t'query' => [\n323\t\t\t\t'project_id' => $p_project_id,\n324\t\t\t\t'category_name' => $p_category_name,\n325\t\t\t],\n326\t\t\t'options' => [\n327\t\t\t\t'allow_reassign' => true,\n328\t\t\t\t'new_category_id' => config_get( 'default_category_for_moves' ),\n329\t\t\t],\n330\t\t];\n331\t\t$t_command = new CategoryDeleteCommand( $t_data );\n332\t\t$t_command->execute();\n333\t\n334\t\treturn true;\n335\t}\n336\t\n337\t/**\n338\t * Update a category of a project.\n339\t *\n340\t * @param string $p_username          The name of the user trying to access the categories.\n341\t * @param string $p_password          The password of the user.\n342\t * @param int    $p_project_id        The id of the project to retrieve the categories for.\n343\t * @param string $p_category_name     The name of the category to rename.\n344\t * @param string $p_category_name_new The new name of the category to rename.\n345\t * @param int    $p_assigned_to       User ID that category is assigned to.\n346\t *\n347\t * @return bool|RestFault|SoapFault True or false depending on the success of the update action\n348\t */\n349\tfunction mc_project_rename_category_by_name( $p_username, $p_password, $p_project_id, $p_category_name, $p_category_name_new, $p_assigned_to ) {\n350\t\t$t_user_id = mci_check_login( $p_username, $p_password );\n351\t\n352\t\tif( null === $p_assigned_to ) {\n353\t\t\treturn ApiObjectFactory::faultBadRequest( 'assigned_to needed' );\n354\t\t}\n355\t\n356\t\tif( $t_user_id === false ) {\n357\t\t\treturn mci_fault_access_denied();\n358\t\t}\n359\t\n360\t\t$t_category_id = category_get_id_by_name( $p_category_name, $p_project_id );\n361\t\t$t_data = [\n362\t\t\t'query' => [\n363\t\t\t\t'project_id' => $p_project_id,\n364\t\t\t\t'category_id' => $t_category_id,\n365\t\t\t],\n366\t\t\t'payload' => [\n367\t\t\t\t'name' => $p_category_name_new,\n368\t\t\t\t'assigned_to' => (int)$p_assigned_to,\n369\t\t\t],\n370\t\t];\n371\t\t$t_command = new CategoryUpdateCommand( $t_data );\n372\t\t$t_command->execute();\n373\t\n374\t\treturn true;\n375\t}\n376\t\n377\
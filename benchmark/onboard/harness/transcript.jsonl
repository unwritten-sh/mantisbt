{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NZWm95k7BzAfLoxaFvtHhZ","type":"tool_result","content":"#!/usr/bin/env bash\n# -----------------------------------------------------------------------------\n# MantisBT harness - local instance for development and integration tests.\n#\n# Mirrors .github/workflows/mantisbt.yml on a developer machine:\n#   database in Docker (compose.yaml), PHP built-in web server on the host,\n#   web installer (admin/install.php), then build/ci_post_install.sh for\n#   seed data, API token and tests/bootstrap.php.\n#\n# Usage: build/local_instance.sh <command> [args]\n#   up                   Start the database container and wait until healthy\n#   install [--reset]    Install MantisBT if config/config_inc.php is missing\n#                        (--reset: drop the database and reinstall)\n#   serve                Install if needed, then run the web server (foreground)\n#   test [phpunit args]  Reinstall from scratch, start the web server and run\n#                        vendor/bin/phpunit (all suites of phpunit.xml)\n#   reset                Drop the database, delete config/config_inc.php and\n#                        tests/bootstrap.php\n#   down                 Stop containers and delete their volumes\n#\n# Settings come from the environment or from .env (see .env.example).\n# Compatible with bash 3.2 (macOS default).\n# -----------------------------------------------------------------------------\nset -euo pipefail\nROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\ncd \"$ROOT\"\n\nif [ -f .env ]; then\n\tset -a\n\t# shellcheck disable=SC1091\n\t. ./.env\n\tset +a\nfi\n\nMANTIS_HOST=\"${MANTIS_HOST:-127.0.0.1}\"\nPORT=\"${PORT:-8989}\"\nDB_TYPE=\"${DB_TYPE:-mysqli}\"\nDB_NAME=\"${DB_NAME:-bugtracker}\"\nDB_USER=\"${DB_USER:-root}\"\nDB_PASSWORD=\"${DB_PASSWORD:-root}\"\n\nMANTIS_CONFIG=config/config_inc.php\nMANTIS_BOOTSTRAP=tests/bootstrap.php\nSERVER_LOG=\"${TMPDIR:-/tmp}/mantisbt-php-server.log\"\nPHP_INI_ARGS=( -d \"sendmail_path=$ROOT/tests/fakesendmail.sh\" -d opcache.jit=disable )\n\ncase \"$DB_TYPE\" in\n\tmysqli)\n\t\tCOMPOSE=( docker compose )\n\t\tSERVICE=mysql\n\t\t;;\n\tpgsql)\n\t\tCOMPOSE=( docker compose --profile pgsql )\n\t\tSERVICE=pgsql\n\t\t;;\n\t*)\n\t\techo \"Unsupported DB_TYPE '$DB_TYPE' (use mysqli or pgsql)\" >&2\n\t\texit 1\n\t\t;;\nesac\n\n# Run one SQL statement on the MantisBT database (same contract as DB_CMD in CI)\ndb_cmd_string() {\n\tif [ \"$DB_TYPE\" = mysqli ]; then\n\t\techo \"${COMPOSE[*]} exec -T $SERVICE mysql -u$DB_USER -p$DB_PASSWORD $DB_NAME -e\"\n\telse\n\t\techo \"${COMPOSE[*]} exec -T $SERVICE psql -q -U $DB_USER $DB_NAME -c\"\n\tfi\n}\n\ncmd_up() {\n\t\"${COMPOSE[@]}\" up -d --wait \"$SERVICE\"\n}\n\ncmd_reset() {\n\tcmd_up\n\techo \"Dropping and recreating database '$DB_NAME'\"\n\tif [ \"$DB_TYPE\" = mysqli ]; then\n\t\t\"${COMPOSE[@]}\" exec -T \"$SERVICE\" mysql -u\"$DB_USER\" -p\"$DB_PASSWORD\" \\\n\t\t\t-e \"DROP DATABASE IF EXISTS $DB_NAME; CREATE DATABASE $DB_NAME;\" 2>/dev/null\n\telse\n\t\t\"${COMPOSE[@]}\" exec -T \"$SERVICE\" psql -q -U \"$DB_USER\" -d postgres \\\n\t\t\t-c \"DROP DATABASE IF EXISTS $DB_NAME WITH (FORCE);\" -c \"CREATE DATABASE $DB_NAME;\"\n\tfi\n\trm -f \"$MANTIS_CONFIG\" \"$MANTIS_BOOTSTRAP\"\n}\n\nSERVER_PID=\"\"\nstart_server() {\n\tif curl -s -o /dev/null \"http://$MANTIS_HOST:$PORT/\"; then\n\t\techo \"Port $PORT on $MANTIS_HOST is already in use. Stop that server or set PORT.\" >&2\n\t\texit 1\n\tfi\n\tphp \"${PHP_INI_ARGS[@]}\" -S \"$MANTIS_HOST:$PORT\" -t \"$ROOT\" >\"$SERVER_LOG\" 2>&1 &\n\tSERVER_PID=$!\n\ttrap stop_server EXIT\n\tfor _ in $(seq 1 50); do\n\t\tif curl -s -o /dev/null \"http://$MANTIS_HOST:$PORT/\"; then\n\t\t\techo \"PHP web server on http://$MANTIS_HOST:$PORT/ (PID $SERVER_PID, log $SERVER_LOG)\"\n\t\t\treturn 0\n\t\tfi\n\t\tsleep 0.2\n\tdone\n\techo \"PHP web server did not start, see $SERVER_LOG\" >&2\n\texit 1\n}\n\nstop_server() {\n\tif [ -n \"$SERVER_PID\" ]; then\n\t\tkill \"$SERVER_PID\" 2>/dev/null || true\n\t\twait \"$SERVER_PID\" 2>/dev/null || true\n\t\tSERVER_PID=\"\"\n\tfi\n}\n\nrun_installer() {\n\t# Same parameters as build/ci_install_mantis.sh (which needs bash 4)\n\techo \"Running admin/install.php\"\n\tcurl -s --fail-with-body -o /dev/null \\\n\t\t--data \"install=2&db_type=$DB_TYPE&hostname=$MANTIS_HOST&database_name=$DB_NAME\" \\\n\t\t--data \"db_username=$DB_USER&db_password=$DB_PASSWORD\" \\\n\t\t--data \"admin_username=$DB_USER&admin_password=$DB_PASSWORD&timezone=UTC&path=\" \\\n\t\t\"http://$MANTIS_HOST:$PORT/admin/install.php\"\n\tif [ ! -f \"$MANTIS_CONFIG\" ]; then\n\t\techo \"Installer did not write $MANTIS_CONFIG, see $SERVER_LOG\" >&2\n\t\texit 1\n\tfi\n\n\t# ci_post_install.sh calls sudo to chmod the config file; not needed locally\n\tsudo() { \"$@\"; }\n\texport -f sudo\n\tHOSTNAME=\"$MANTIS_HOST\" PORT=\"$PORT\" DB_CMD=\"$(db_cmd_string)\" \\\n\t\tbash build/ci_post_install.sh 2> >(grep -v 'Using a password on the command line' >&2)\n\tunset -f sudo\n}\n\ncmd_install() {\n\tif [ \"${1:-}\" = \"--reset\" ] || [ ! -f \"$MANTIS_CONFIG\" ]; then\n\t\tcmd_reset\n\t\tstart_server\n\t\trun_installer\n\t\tstop_server\n\t\techo \"MantisBT installed. Log in as $DB_USER / $DB_PASSWORD.\"\n\telse\n\t\tcmd_up\n\t\techo \"MantisBT already installed ($MANTIS_CONFIG exists). Use --reset to reinstall.\"\n\tfi\n}\n\ncmd_serve() {\n\tcmd_install\n\techo \"Serving http://$MANTIS_HOST:$PORT/ (Ctrl+C to stop)\"\n\texec php \"${PHP_INI_ARGS[@]}\" -S \"$MANTIS_HOST:$PORT\" -t \"$ROOT\"\n}\n\ncmd_test() {\n\tcmd_install --reset\n\tstart_server\n\tphp \"${PHP_INI_ARGS[@]}\" vendor/bin/phpunit \"$@\"\n}\n\nt_command=\"${1:-}\"\n[ $# -gt 0 ] && shift\ncase \"$t_command\" in\n\tup) cmd_up ;;\n\tinstall) cmd_install \"$@\" ;;\n\tserve) cmd_serve ;;\n\ttest) cmd_test \"$@\" ;;\n\treset) cmd_reset ;;\n\tdown) \"${COMPOSE[@]}\" down -v ;;\n\t*)\n\t\tsed -n '2,24p' \"$0\"\n\t\texit 1\n\t\t;;\nesac\n# Local data stores for MantisBT development and the integration test gate.\n#\n# The application itself runs on the host with PHP's built-in web server\n# (see build/local_instance.sh and docs/local-dev.md).\n# Credentials match .github/workflows/mantisbt.yml: user root, password root,\n# database bugtracker. They are for local use only.\n#\n# MantisBT connects to MySQL on port 3306 (the mysqli driver default), so the\n# host port must stay 3306.\n\nname: mantisbt\n\nservices:\n  mysql:\n    image: mysql:8.0\n    environment:\n      MYSQL_ROOT_PASSWORD: root\n      MYSQL_DATABASE: bugtracker\n    ports:\n      - \"127.0.0.1:3306:3306\"\n    volumes:\n      - mysql-data:/var/lib/mysql\n    healthcheck:\n      test: [\"CMD\", \"mysqladmin\", \"ping\", \"-h\", \"127.0.0.1\", \"-uroot\", \"-proot\"]\n      interval: 2s\n      timeout: 5s\n      retries: 60\n\n  # Optional: start with DB_TYPE=pgsql (see .env.example).\n  pgsql:\n    image: postgres:16\n    profiles: [\"pgsql\"]\n    environment:\n      POSTGRES_USER: root\n      POSTGRES_PASSWORD: root\n      POSTGRES_DB: bugtracker\n    ports:\n      - \"127.0.0.1:5432:5432\"\n    volumes:\n      - pgsql-data:/var/lib/postgresql/data\n    healthcheck:\n      test: [\"CMD\", \"pg_isready\", \"-U\", \"root\", \"-d\", \"bugtracker\"]\n      interval: 2s\n      timeout: 5s\n      retries: 60\n\nvolumes:\n  mysql-data:\n  pgsql-data:\n# Settings for the local development scripts (build/local_instance.sh,\n# compose.yaml). Copy to .env to override the defaults below.\n#\n# MantisBT itself does not read environment variables for its settings:\n# application settings live in config/config_inc.php (written by the\n# installer, gitignored). See config/config_inc.php.sample for the list\n# (database, crypto_master_salt, SMTP, email addresses).\n#\n# The only environment variable read by the application code is\n# MANTIS_CONFIG_FOLDER (config_defaults_inc.php): an optional path to an\n# alternative config folder, with a trailing slash.\n# MANTIS_CONFIG_FOLDER=\n\n# Host for the PHP built-in web server. Also used as the database host by the\n# installer, so keep it 127.0.0.1 when the database runs in compose.yaml.\nMANTIS_HOST=127.0.0.1\n\n# Port for the PHP built-in web server (CI uses 8080).\nPORT=8989\n\n# ADOdb driver: mysqli (default, compose service \"mysql\")\n# or pgsql (compose service \"pgsql\", profile \"pgsql\").\nDB_TYPE=mysqli\n\n# Database credentials. They match compose.yaml and the CI workflow.\n# Local use only. The installer also creates the MantisBT administrator\n# account with this user name and password.\nDB_NAME=bugtracker\nDB_USER=root\nDB_PASSWORD=root\nphp 8.1.34\nnodejs 22.12.0\nphp\nphp@8.5\n[PHP Modules] bcmath bz2 calendar Core ctype curl date dba dom exif FFI fileinfo filter ftp gd gettext gmp hash iconv intl json ldap lexbor libxml mbstring mysqli mysqlnd odbc openssl pcntl pcre PDO pdo_dblib pdo_mysql PDO_ODBC pdo_pgsql pdo_sqlite pgsql Phar posix random readline Reflection session shmop SimpleXML snmp soap sockets sodium SPL sqlite3 standard sysvmsg sysvsem sysvshm tidy tokenizer uri xml xmlreader xmlwriter xsl Zend OPcache zip zlib  [Zend Modules] Zend OPcache  CONTAINER ID   IMAGE                                        COMMAND                  CREATED        STATUS                          PORTS                                                                                                                  NAMES\nc99cf4796cc6   backbison-runner                             \"python -m backbison…\"   28 hours ago   Up 2 hours                                                                                                                                             backbison-runner-1\n9ff393e428e7   backbison-backbison-worker                   \"sh -c 'exec uv run …\"   28 hours ago   Up 28 hours                     8005/tcp                                                                                                               backbison-backbison-worker-1\n3e7d5f1ac372   backbiso
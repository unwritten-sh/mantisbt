\n#\n# MantisBT connects to MySQL on port 3306 (the mysqli driver default), so the\n# host port must stay 3306.\n\nname: mantisbt\n\nservices:\n  mysql:\n    image: mysql:8.0\n    environment:\n      MYSQL_ROOT_PASSWORD: root\n      MYSQL_DATABASE: bugtracker\n    ports:\n      - \"127.0.0.1:3306:3306\"\n    volumes:\n      - mysql-data:/var/lib/mysql\n    healthcheck:\n      test: [\"CMD\", \"mysqladmin\", \"ping\", \"-h\", \"127.0.0.1\", \"-uroot\", \"-proot\"]\n      interval: 2s\n      timeout: 5s\n      retries: 60\n\n  # Optional: start with DB_TYPE=pgsql (see .env.example).\n  pgsql:\n    image: postgres:16\n    profiles: [\"pgsql\"]\n    environment:\n      POSTGRES_USER: root\n      POSTGRES_PASSWORD: root\n      POSTGRES_DB: bugtracker\n    ports:\n      - \"127.0.0.1:5432:5432\"\n    volumes:\n      - pgsql-data:/var/lib/postgresql/data\n    healthcheck:\n      test: [\"CMD\", \"pg_isready\", \"-U\", \"root\", \"-d\", \"bugtracker\"]\n      interval: 2s\n      timeout: 5s\n      retries: 60\n\nvolumes:\n  mysql-data:\n  pgsql-data:\n# Settings for the local development scripts (build/local_instance.sh,\n# compose.yaml). Copy to .env to override the defaults below.\n#\n# MantisBT itself does not read environment variables for its settings:\n# application settings live in config/config_inc.php (written by the\n# installer, gitignored). See config/config_inc.php.sample for the list\n# (database, crypto_master_salt, SMTP, email addresses).\n#\n# The only environment variable read by the application code is\n# MANTIS_CONFIG_FOLDER (config_defaults_inc.php): an optional path to an\n# alternative config folder, with a trailing slash.\n# MANTIS_CONFIG_FOLDER=\n\n# Host for the PHP built-in web server. Also used as the database host by the\n# installer, so keep it 127.0.0.1 when the database runs in compose.yaml.\nMANTIS_HOST=127.0.0.1\n\n# Port for the PHP built-in web server (CI uses 8080).\nPORT=8989\n\n# ADOdb driver: mysqli (default, compose service \"mysql\")\n# or pgsql (compose service \"pgsql\", profile \"pgsql\").\nDB_TYPE=mysqli\n\n# Database credentials. They match compose.yaml and the CI workflow.\n# Local use only. The installer also creates the MantisBT administrator\n# account with this user name and password.\nDB_NAME=bugtracker\nDB_USER=root\nDB_PASSWORD=root\nphp 8.1.34\nnodejs 22.12.0\nphp\nphp@8.5\n[PHP Modules] bcmath bz2 calendar Core ctype curl date dba dom exif FFI fileinfo filter ftp gd gettext gmp hash iconv intl json ldap lexbor libxml mbstring mysqli mysqlnd odbc openssl pcntl pcre PDO pdo_dblib pdo_mysql PDO_ODBC pdo_pgsql pdo_sqlite pgsql Phar posix random readline Reflection session shmop SimpleXML snmp soap sockets sodium SPL sqlite3 standard sysvmsg sysvsem sysvshm tidy tokenizer uri xml xmlreader xmlwriter xsl Zend OPcache zip zlib  [Zend Modules] Zend OPcache  CONTAINER ID   IMAGE                                        COMMAND                  CREATED        STATUS                          PORTS                                                                                                                  NAMES\nc99cf4796cc6   backbison-runner                             \"python -m backbison…\"   28 hours ago   Up 2 hours                                                                                                                                             backbison-runner-1\n9ff393e428e7   backbison-backbison-worker                   \"sh -c 'exec uv run …\"   28 hours ago   Up 28 hours                     8005/tcp                                                                                                               backbison-backbison-worker-1\n3e7d5f1ac372   backbison-keycloak                           \"/opt/keycloak/bin/k…\"   28 hours ago   Up 28 hours (healthy)           8443/tcp, 9000/tcp, 0.0.0.0:8180->8080/tcp, [::]:8180->8080/tcp                                                        backbison-keycloak-1\n2369b6a8421d   backbison-backbison                          \"
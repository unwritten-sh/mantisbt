<!--
    MantisBT PHPUnit configuration for database-free unit tests.

    Used by the fast gate (composer run check-fast). These tests do not boot
    core.php, so they need no config/config_inc.php, database or web server.
    The integration suites live in phpunit.xml.
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"

    bootstrap="vendor/autoload.php"
    colors="true"
    cacheDirectory=".phpunit.cache"
    displayDetailsOnAllIssues="true"
    failOnAllIssues="true"
    >

    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

</phpunit>

{
    "name": "mantisbt/mantisbt",
    "description": "Mantis Bug Tracker",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-tokenizer": "*",
        "slim/slim": "^3.0",
        "guzzlehttp/guzzle": "^7.5",
        "vboctor/disposable_email_checker": "^3.0",
        "adodb/adodb-php": "^5.22",
        "phpmailer/phpmailer": "~7.0",
        "parsedown/parsedown": "^1.7.5",
        "ezyang/htmlpurifier": "^4.14",
        "dapphp/securimage": "dev-mantis"
    },
    "require-dev": {
        "ext-zip": "*",
        "phpunit/phpunit": "^10.5.63 || ^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "Mantis\\": [""]
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/mantisbt/securimage",
            "no-api": true
        }
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "MantisBT Team",
            "email": "mantisbt-dev@lists.sourceforge.net",
            "homepage": "https://www.mantisbt.org"
        }
    ],
    "config": {
        "platform": {
            "php": "8.1.34"
        }
    },
    "scripts": {
        "setup": [
            "@composer install --no-interaction",
            "npm ci",
            "git config core.hooksPath .githooks || echo 'Could not set core.hooksPath; run: git config core.hooksPath .githooks'"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "build/local_instance.sh serve"
        ],
        "lint": [
            "build/lint_php.sh",
            "REDOCLY_TELEMETRY=off npm run api:validate"
        ],
        "test": "vendor/bin/phpunit -c phpunit.unit.xml",
        "test-integration": [
            "Composer\\Config::disableProcessTimeout",
            "build/local_instance.sh test"
        ],
        "check-fast": [
            "@lint",
            "@test"
        ],
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "@check-fast",
            "npm run api:generate -- --output \"$(mktemp -d)/rest-api-generated\"",
            "@test-integration"
        ]
    },
    "scripts-descriptions": {
        "setup": "Install Composer and npm dependencies and the git hooks",
        "dev": "Start the database, install MantisBT if needed and serve it on http://127.0.0.1:8989/",
        "lint": "PHP syntax check of tracked files and OpenAPI lint",
        "test": "Database-free unit tests (tests/Unit, phpunit.unit.xml)",
        "test-integration": "Reinstall the local instance and run all phpunit.xml suites (needs Docker)",
        "check-fast": "Fast gate: lint and unit tests, no database or network",
        "check": "Full gate: fast gate, REST API generation and integration tests (needs Docker)"
    }
}

ser( '-1.5' ) )->parse() );\n46\t\t\t$this->assertNull( ( new ConfigParser( 'null' ) )->parse() );\n47\t\t}\n48\t\n49\t\tpublic function testConstantsAreReplacedByTheirValue() {\n50\t\t\t$this->assertSame( DEVELOPER, ( new ConfigParser( 'DEVELOPER' ) )->parse() );\n51\t\t\t$this->assertSame( ON, ( new ConfigParser( 'ON' ) )->parse() );\n52\t\t}\n53\t\n54\t\tpublic function testUnknownConstantIsRejected() {\n55\t\t\t$this->expectException( Exception::class );\n56\t\t\t( new ConfigParser( 'NOT_A_MANTIS_CONSTANT' ) )->parse();\n57\t\t}\n58\t\n59\t\tpublic function testThresholdArrayWithConstantKeys() {\n60\t\t\t$t_parser = new ConfigParser( 'array( NEW_ => REPORTER, RESOLVED => DEVELOPER )' );\n61\t\t\t$this->assertSame( array( NEW_ => REPORTER, RESOLVED => DEVELOPER ), $t_parser->parse() );\n62\t\t}\n63\t\n64\t\tpublic function testNestedArrays() {\n65\t\t\t$t_parser = new ConfigParser( \"array( 'a' => array( 1, 2 ), 'b' => 'c' )\" );\n66\t\t\t$this->assertSame( array( 'a' => array( 1, 2 ), 'b' => 'c' ), $t_parser->parse() );\n67\t\t}\n68\t\n69\t\tpublic function testExtraTokensThrowByDefault() {\n70\t\t\t$this->expectException( Exception::class );\n71\t\t\t( new ConfigParser( '1 + 2' ) )->parse();\n72\t\t}\n73\t\n74\t\tpublic function testExtraTokensCanBeIgnored() {\n75\t\t\t$t_parser = new ConfigParser( '1 + 2' );\n76\t\t\t$this->assertSame( 1, $t_parser->parse( ConfigParser::EXTRA_TOKENS_IGNORE ) );\n77\t\t}\n78\t\n79\t\tpublic function testInvalidPhpIsRejected() {\n80\t\t\t$this->expectException( Exception::class );\n81\t\t\tnew Tokenizer( 'array( 1, ' );\n82\t\t}\n83\t\n84\t\tpublic function testTokenizerDropsWhitespaceAndTrailingSemicolons() {\n85\t\t\t$t_tokens = new Tokenizer( ' 1 ;; ' );\n86\t\t\t$this->assertSame( T_LNUMBER, $t_tokens->type() );\n87\t\t\t$this->assertSame( '1', $t_tokens->value() );\n88\t\t\t$t_tokens->pop();\n89\t\t\t$this->assertTrue( $t_tokens->is_empty() );\n90\t\t}\n91\t}\n92\t"}]},"parent_tool_use_id":null,"session_id":"664bf491-d717-4
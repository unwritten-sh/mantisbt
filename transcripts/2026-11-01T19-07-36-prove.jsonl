\t}\n98\t\t\treturn $t_code;\n99\t\t}\n100\t\n101\t\t/**\n102\t\t * Retrieves the next token without consuming it.\n103\t\t * @return mixed token\n104\t\t * @throws Exception if there are no more tokens to process\n105\t\t */\n106\t\tpublic function get() {\n107\t\t\tif( $this->is_empty() ) {\n108\t\t\t\tthrow new Exception( 'No more tokens' );\n109\t\t\t}\n110\t\t\treturn $this->tokens[0];\n111\t\t}\n112\t\n113\t\t/**\n114\t\t * Consume the next token and return it.\n115\t\t * @return mixed token\n116\t\t * @throws Exception\n117\t\t */\n118\t\tpublic function pop() {\n119\t\t\t$t_token = $this->get();\n120\t\t\tarray_shift( $this->tokens );\n121\t\t\treturn $t_token;\n122\t\t}\n123\t\n124\t\t/**\n125\t\t * Get the current token's type.\n126\t\t * @link http://php.net/manual/en/tokens.php\n127\t\t * @return int|string Token number or character\n128\t\t */\n129\t\tpublic function type() {\n130\t\t\t$t_token = $this->get();\n131\t\t\treturn is_array( $t_token ) ? $t_token[0] : $t_token;\n132\t\t}\n133\t\n134\t\t/**\n135\t\t * Get the current token's value.\n136\t\t * @return int|string Token number or character\n137\t\t */\n138\t\tpublic function value() {\n139\t\t\t$t_token = $this->get();\n140\t\t\treturn is_array( $t_token ) ? $t_token[1] : $t_token;\n141\t\t}\n142\t\n143\t\t/**\n144\t\t * Return true if the next token matches the given value.\n145\t\t * @param int|string $p_value value to check\n146\t\t * @return bool\n147\t\t */\n148\t\tpublic function matches( $p_value ) {\n149\t\t\t$t_type = $this->type();\n150\t\t\treturn $t_type === $p_value;\n151\t\t}\n152\t\n153\t\t/**\n154\t\t * Ensures the next token matches the value and consumes it.\n155\t\t * @param int|string $p_value value to check\n156\t\t * @throws Exception if token does not match\n157\t\t */\n158\t\tpublic function ensure_matches( $p_value ) {\n159\t\t\tif( !$this->matches( $p_value ) ) {\n160\t\t\t\tif( is_int( $p_value ) ) {\n161\t\t\t\t\t$p_value = token_name( $p_value );\n162\t\t\t\t}\n163\t
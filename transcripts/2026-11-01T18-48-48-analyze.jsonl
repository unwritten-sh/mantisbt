{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BpWLvShbuXU7noHJfTpZY3","type":"tool_result","content":"# -----------------------------------------------------------------------------\n# MantisBT GitHub Actions Worflow to run PHPUnit tests\n#\n# Tests will be triggered on\n# - direct pushes to branches (except dependabot)\n# - pull requests\n# -----------------------------------------------------------------------------\n\nname: MantisBT unit tests\non:\n  push:\n    branches-ignore:\n      - dependabot/**   # Only build dependabot branches on PRs\n    paths-ignore:\n      - docbook/**\n  pull_request:\n    paths-ignore:\n      - docbook/**\n\nconcurrency:\n  group: ci-${{ github.ref }}\n  cancel-in-progress: true\n\njobs:\n  Tests:\n    name: PHP ${{ matrix.php }} on ${{ matrix.DB }}\n    runs-on: ubuntu-latest\n    if: \"!contains(github.event.head_commit.message, '[skip ci]')\"\n\n    continue-on-error: ${{ matrix.experimental }}\n    strategy:\n      fail-fast: false\n      matrix:\n        DB:\n          # Database to test with (= name of the ADOdb driver)\n          - mysqli\n          - pgsql\n        php:\n          - 8.5\n          - 8.4\n          - 8.3\n          - 8.2\n          - 8.1\n        experimental: [false]\n        include:\n          - php: 8.6\n            DB: mysqli\n            experimental: true\n          - php: 8.6\n            DB: pgsql\n            experimental: true\n\n    env:\n      HOSTNAME: localhost\n      PORT: 8080\n      DB_NAME: bugtracker\n      DB_USER: root\n      DB_PASSWORD: root\n      DB_HOST: localhost\n      DB_TYPE: ${{ matrix.DB }}\n\n    steps:\n    - name: Setup PHP\n      # https://setup-php.com/\n      uses: shivammathur/setup-php@v2\n      with:\n        php-version: \"${{ matrix.php }}\"\n        extensions: mysqli, pgsql, mbstring, json, tokenizer, curl, gd, fileinfo, ldap, soap, zlib\n        tools: phpunit\n        ini-values: |\n          opcache.jit=disable,\n          sendmail_path=${{ github.workspace }}/tests/fakesendmail.sh\n\n    - name: Checkout MantisBT Repository\n      uses: actions/checkout@v7\n\n    - run: composer install\n\n    - name: Initialize MySQL\n      if: ${{ matrix.DB == 'mysqli' }}\n      run: |\n        sudo systemctl start mysql.service\n        # Using -p for password triggers warnings, but these can be ignored \n        DB_CMD=\"mysql -u$DB_USER -p$DB_PASSWORD\"\n        $DB_CMD -e \"CREATE DATABASE $DB_NAME\"\n        # Make the DB execution command available to subsequent steps\n        echo \"DB_CMD=$DB_CMD $DB_NAME -e \" >> \"$GITHUB_ENV\"\n\n    - name: Initialize PostgreSQL\n      if: ${{ matrix.DB == 'pgsql' }}\n      run: |\n        sudo systemctl start postgresql.service\n        pg_isready\n        DB_CMD=\"sudo -u postgres psql\"\n        sudo -u postgres createdb $DB_NAME\n        $DB_CMD -c \"CREATE USER $DB_USER WITH SUPERUSER CREATEDB CREATEROLE INHERIT LOGIN PASSWORD '$DB_PASSWORD'\"\n        $DB_CMD -c \"GRANT ALL PRIVILEGES ON DATABASE $DB_NAME TO $DB_USER\"\n        # Make the DB execution command available to subsequent steps\n        echo \"DB_CMD=$DB_CMD $DB_NAME -c \" >> \"$GITHUB_ENV\"\n\n    - name: Start webserver\n      run: |\n        nohup php -S ${{env.HOSTNAME}}:${{env.PORT}} &\n        sleep 1\n        echo \"PHP built-in webserver started with PID $!\"\n        # Write access to config dir needed for installer to create config_inc.php\n        chmod 777 config/\n\n    - name: Install MantisBT\n      run: ./build/ci_install_mantis.sh\n\n    - name: Post-installation steps\n      run: ./build/ci_post_install.sh\n\n    - name: Run test suite\n      run: vendor/bin/phpunit\n# -----------------------------------------------------------------------------\n# MantisBT GitHub Actions Worflow to build Documentation\n#\n# Runs when documentation or its OpenAPI source changes.\n# -----------------------------------------------------------------------------\n\nname: MantisBT Documentation\non:\n  push:\n    paths:\n      - .github/workflows/documentation.yml\n      - api/rest/mantisbt_openapi.yaml\n      - tools/openapi/**\n      - tools/scalar/**\n      - redocly.yaml\n      - package.json\n      - package-lock.json\n      - api/soap/mantisconnect.wsdl\n      - api/soap/wsdl-viewer.xsl\n      - \"docbook/*/en-US/**\"\n      - \"docbook/*/publican.cfg\"\n  pull_request:\n    paths:\n      - .github/workflows/documentation.yml\n      - api/rest/mantisbt_openapi.yaml\n      - tools/openapi/**\n      - tools/scalar/**\n      - redocly.yaml\n      - package.json\n      - package-lock.json\n      - api/soap/mantisconnect.wsdl\n      - api/soap/wsdl-viewer.xsl\n      - \"docbook/*/en-US/**\"\n      - \"docbook/*/publican.cfg\"\n\nconcurrency:\n  group: doc-${{ github.ref }}\n  cancel-in-progress: true\n\njobs:\n  Documentation:\n    runs-on: ubuntu-latest\n    if: \"!contains(github.event.head_commit.message, '[skip ci]')\"\n\n    env:\n      DOCBOOKS: Admin_Guide Developers_Guide\n\n    steps:\n      - name: Checkout MantisBT Repository\n        uses: actions/checkout@v7\n\n      - name: Install Publican toolchain\n        run: |\n          sudo apt-get update\n          sudo apt-get install --no-install-recommends publican xsltproc\n\n      - name: Install OpenAPI toolchain\n        run: npm ci\n\n      - name: Validate OpenAPI definition\n<!--\n    MantisBT PHPUnit configuration\n-->\n<phpunit\n    xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n    xsi:noNamespaceSchemaLocation=\"https://schema.phpunit.de/10.5/phpunit.xsd\"\n\n    bootstrap=\"tests/bootstrap.php\"\n    colors=\"true\"\n    displayDetailsOnAllIssues=\"true\"\n    failOnAllIssues=\"true\"\n    >\n\n    <testsuites>\n        <testsuite name=\"mantis\">\n            <directory>tests/Mantis</directory>\n        </testsuite>\n\n        <testsuite name=\"soap\">\n            <directory>tests/soap</directory>\n        </testsuite>\n\n        <testsuite name=\"rest\">\n            <directory>tests/rest</directory>\n        </testsuite>\n\n        <testsuite name=\"mantis core formatting\">\n            <directory>plugins/MantisCoreFormatting/tests</directory>\n        </testsuite>\n    </testsuites>\n\n</phpunit>\ntests/bootstrap.php.sample\ntests/ci_create_api_token.php\ntests/fakesendmail.sh\ntests/test_config_get_set.php\ntests/TestConfig.php\n\ntests:\nbootstrap.php.sample\nci_create_api_token.php\ncore\nfakesendmail.sh\nMantis\nrest\nsoap\ntest_config_get_set.php\nTestConfig.php\n\ntests/core:\nFaker.php\nMantisTestCase.php\nRequestBuilder.php\n\ntests/Mantis:\nAntispamApiTest.php\nApiObjectFactoryTest.php\nApiTokenApiTest.php\nCategoryCommandTest.php\nCategoryDeleteCommandTest.php\nConfigParserTest.php\nFileApiTest.php\nFilterApiTest.php\nHelper\nHtmlApiTest.php\nIssueMoveCommandTest.php\nIssueNoteAddCommandTest.php\nMantisCoreBase.php\nMantisEnumTest.php\nMentionParsingCustomTest.php\nMentionParsingTest.php\nPluginTest.php\nPrepareTest.php\nProjectApiTest.php\nStringTest.php\nTagApiTest.php\nTokensApiTest.php\nUserApiTest.php\nVersionApiTest.php\n\ntests/rest:\nRestAuthHeaderTest.php\nRestBase.php\nRestFiltersTest.php\nRestImpersonateUserTest.php\nRestIssueEtagTest.php\nRestIssueFilesTest.php\nRestIssueMoveTest.php\nRestIssueNotesTest.php\nRestIssueRelationshipsTest.php\nRestIssueTest.php\nRestIssueUpdateCategory.php\nRestIssueUpdateVersion.php\nRestProjectCategoryTest.php\nRestProjectCustomFieldTest.php\nRestProjectTest.php\nRestProjectVersionTest.php\nRestUserTest.php\n\ntests/soap:\nAttachmentTest.php\nCategoryTest.php\nCompressionTest.php\nEnumTest.php\nFilterTest.php\nIssueAddTest.php\nIssueHistoryTest.php\nIssueMonitorTest.php\nIssueNoteTest.php\nIssueUpdateTest.php\nLoginTest.php\nMentionTest.php\nProjectTest.php\nRelationshipTest.php\nSoapBase.php\nTagTest.php\nUserTest.php\nVersionTest.php\napi:\nrest\nsoap\n\napi/rest:\nenv.postman_environment.json\nindex.php\nmantisbt_openapi.yaml\nrestcore\nweb.config\n\napi/soap:\nmantisconnect.ph
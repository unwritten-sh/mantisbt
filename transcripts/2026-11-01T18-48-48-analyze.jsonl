{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgci5omDL4uDBPk2QVzrV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Lez7HZ3LmAmUEfbpniT6oy","name":"StructuredOutput","input":{"project":{"name":"MantisBT (Mantis Bug Tracker)","one_liner":"A self-hosted, open-source web bug tracker written in PHP, with a web UI, a REST API, a legacy SOAP API and a plugin system.","value_proposition":"MantisBT lets software teams report, triage, assign and follow issues across many projects from a browser, with configurable workflows, access levels, custom fields and email notifications. Organisations install it on their own web server and database, so they keep control of their data. Integrators automate it through a REST API (OpenAPI-described) and a SOAP API, and extend it with plugins.","users":["Reporter (end user or customer who files issues)","Developer (works on, updates and resolves issues)","Manager (manages projects, versions, categories and users within a project)","Administrator (installs, upgrades and configures the instance, manages users, plugins and workflow)","Anonymous viewer (read-only access when anonymous login is enabled)","API integrator (scripts and tools using the REST or SOAP API with API tokens)","Plugin developer (extends MantisBT through events and the plugin API)"],"use_cases":[{"name":"Report an issue","description":"A user fills the report form (project, category, severity, description, attachments, custom fields) and the issue is created, with notifications sent.","entry_points":["bug_report_page.php","bug_report.php","core/commands/IssueAddCommand.php","api/rest/restcore/issues_rest.php"]},{"name":"View, filter and search issues","description":"Users list issues with saved or ad-hoc filters, view issue details, history and relationships, and export them.","entry_points":["view_all_bug_page.php","view_all_set.php","bug_view_page.php","core/filter_api.php","core/classes/BugFilterQuery.class.php","csv_export.php","excel_xml_export.php","api/rest/restcore/filters_rest.php"]},{"name":"Update and resolve issues","description":"Developers change status, assignee, fields and versions, add notes (bugnotes), monitor, tag, relate and move issues; bulk actions are available.","entry_points":["bug_update_page.php","bug_update.php","bug_change_status_page.php","bugnote_add.php","bug_actiongroup.php","core/commands/IssueNoteAddCommand.php","core/commands/IssueMoveCommand.php","core/workflow_api.php"]},{"name":"Manage projects, versions, categories and custom fields","description":"Managers create projects and subprojects, versions, categories, custom fields and project membership.","entry_points":["manage_proj_page.php","manage_proj_create.php","manage_proj_ver_add.php","manage_proj_cat_add.php","manage_custom_field_page.php","core/project_api.php","api/rest/restcore/projects_rest.php"]},{"name":"Manage users, accounts and API tokens","description":"Administrators create, edit, impersonate and prune users; users manage their own account, preferences and API tokens.","entry_points":["manage_user_page.php","manage_user_create.php","account_page.php","account_prefs_page.php","api_tokens_page.php","core/user_api.php","core/api_token_api.php","api/rest/restcore/users_rest.php"]},{"name":"Configure workflow, thresholds and email notifications","description":"Administrators set status workflow, access thresholds, email notification rules and other configuration stored in the database or config files.","entry_points":["manage_config_workflow_page.php","manage_config_work_threshold_page.php","manage_config_email_page.php","adm_config_page.php","config_defaults_inc.php","core/config_api.php","api/rest/restcore/config_rest.php"]},{"name":"Install and upgrade the instance","description":"The web installer checks the environment, creates or upgrades the database schema and writes config_inc.php.","entry_points":["admin/check/index.php","admin/install.php","admin/schema.php","admin/upgrade_unattended.php"]},{"name":"Integrate through the REST and SOAP APIs","description":"External tools create and read issues, projects, users, filters and config through a Slim-based REST API or the SOAP MantisConnect API.","entry_points":["api/rest/index.php","api/rest/mantisbt_openapi.yaml","api/soap/mantisconnect.php","api/soap/mantisconnect.wsdl"]},{"name":"Roadmap, changelog, summary and news","description":"Users see per-version roadmap and changelog, statistics summary, timeline, news and RSS feeds.","entry_points":["roadmap_page.php","changelog_page.php","summary_page.php","my_view_page.php","news_list_page.php","issues_rss.php","news_rss.php"]},{"name":"Extend with plugins and scheduled tasks","description":"Plugins hook into events (formatting, graphs, avatars, XML import/export); a CLI cron script signals EVENT_CRONJOB and another sends queued emails.","entry_points":["plugins/","core/plugin_api.php","core/events_inc.php","manage_plugin_page.php","scripts/cronjob.php","scripts/send_emails.php"]}],"glossary":[{"term":"Bug / Issue","meaning":"The tracked work item. Code and tables use 'bug' (bug_api.php, mantis_bug_table); the UI says 'issue'."},{"term":"Bugnote","meaning":"A note or comment on an issue (bugnote_api.php, mantis_bugnote_table)."},{"term":"Access level / threshold","meaning":"Numeric role (VIEWER, REPORTER, UPDATER, DEVELOPER, MANAGER, ADMINISTRATOR); thresholds are config values giving the minimum level for an action."},{"term":"Workflow","meaning":"Allowed status transitions for issues, configured in manage_config_workflow_page.php and core/workflow_api.php."},{"term":"Filter","meaning":"A saved or ad-hoc query over issues (filter_api.php, BugFilterQuery, mantis_filters_table)."},{"term":"Monitor","meaning":"A user who follows an issue and receives notifications (bug_monitor_add.php)."},{"term":"Sponsorship","meaning":"Optional feature where users pledge money on an issue (sponsorship_api.php)."},{"term":"Command","meaning":"Class in core/commands/ that implements one business action, shared by the web UI and the REST API."},{"term":"MantisConnect (mc_)","meaning":"The SOAP API; files in api/soap prefixed mc_. Its ApiObjectFactory is also reused by the REST API."},{"term":"Event / plugin","meaning":"Plugin extension points declared in core/events_inc.php and signalled with event_signal()."},{"term":"g_ / p_ / f_ / c_ / t_ prefixes","meaning":"Variable naming convention from README.md: g_ global config, p_ function parameter, f_ form input, c_ cleaned for DB, t_ temporary."},{"term":"config_inc.php","meaning":"Per-installation configuration file in config/ (gitignored) that overrides config_defaults_inc.php."},{"term":"_page.php / _inc.php","meaning":"Root file naming: *_page.php renders a page, *_inc.php is an include fragment, other root .php files are form action scripts."},{"term":"ADOdb","meaning":"Database abstraction library (adodb/adodb-php) used by core/database_api.php to support MySQL, PostgreSQL and others."},{"term":"Publican / DocBook","meaning":"Toolchain and XML format used to build the Admin Guide and Developers Guide in docbook/."},{"term":"translatewiki.net","meaning":"External site that provides localisation updates to lang/ through automated commits."}]},"stack":{"languages":["PHP (>= 8.1, composer platform 8.1.34)","JavaScript (front-end in js/, Node tooling in tools/)","SQL (via ADOdb)","Shell (CI scripts in build/)","Python (release build scripts in build/)","DocBook XML (docbook/)"],"frameworks":["Slim 3 (REST API)","ADOdb (database abstraction)","PHPMailer (email)","HTMLPurifier and Parsedown (formatting)","Guzzle (HTTP client)","PHPUnit 10.5/11.5 (tests)","Redocly CLI and openapi-to-postmanv2 (OpenAPI tooling)","Bruno and Scalar (API docs tooling in tools/)"],"datastores":["MySQL/MariaDB (mysqli driver, default)","PostgreSQL (pgsql driver, tested in CI)","Other ADOdb-supported databases (README: 'or other supported database')","Local disk for attachments when file_upload_method = DISK"],"external_services":["SMTP / sendmail mail transport (PHPMailer)","LDAP directory (core/ldap_api.php, optional)","Gravatar (plugins/Gravatar)","translatewiki.net (localisation commits)","mantisbt.org issue tracker (where issues are filed, per CONTRIBUTING.md)"]},"architecture":{"components":[{"name":"Web UI pages and actions","kind":"web app","path":"/ (root *.php files), core.php","tech":"PHP server-rendered pages, js/, css/","description":"One PHP file per page (*_page.php) or form action. Each bootstraps core.php, which loads config and connects to the database."},{"name":"Core APIs","kind":"library","path":"core/","tech":"PHP procedural *_api.php modules, core/classes, core/commands, core/exceptions","description":"Business logic: bugs, projects, users, filters, workflow, email, auth, plugins, logging. Commands in core/commands are shared by the UI and the REST API."},{"name":"REST API","kind":"API","path":"api/rest/","tech":"Slim 3, OpenAPI spec in api/rest/mantisbt_openapi.yaml","description":"JSON API with middlewares for auth, cache, offline and version; route files in api/rest/restcore/*_rest.php. Reuses SOAP mc_ code and core commands."},{"name":"SOAP API (MantisConnect)","kind":"API","path":"api/soap/","tech":"PHP SoapServer, WSDL","description":"Legacy SOAP API (mantisconnect.php, mc_*_api.php)."},{"name":"Admin and installer","kind":"web app","path":"admin/","tech":"PHP","description":"Environment checks, install/upgrade (install.php, schema.php, upgrade_unattended.php), email queue and DB stats. Meant to be removed on live sites."},{"name":"Plugins","kind":"extension","path":"plugins/","tech":"PHP, MantisPlugin class, events","description":"Bundled plugins: MantisCoreFormatting, MantisGraph, XmlImportExport, Gravatar. Other plugin folders are gitignored."},{"name":"CLI scripts","kind":"scheduler / worker","path":"scripts/","tech":"PHP CLI","description":"cronjob.php signals EVENT_CRONJOB; send_emails.php sends queued emails when email_send_using_cronjob is on. The cron schedule itself is outside the repository."},{"name":"Database","kind":"database","path":"admin/schema.php","tech":"MySQL or PostgreSQL via ADOdb","description":"Tables prefixed mantis_ (bug, bug_text, bugnote, bug_history, project, project_version, category, user, user_pref, config, filters, tag, plugin, email, api_token, custom_field and more)."},{"name":"Configuration","kind":"config","path":"config_defaults_inc.php, config/config_inc.php.sample","tech":"PHP global $g_ variables","description":"Defaults in config_defaults_inc.php; per-install overrides in config/config_inc.php (gitignored); some settings stored in mantis_config_table."},{"name":"Localisation","kind":"resources","path":"lang/","tech":"PHP string files","description":"66 language files, updated from translatewiki.net."},{"name":"Documentation and API tooling","kind":"build tooling","path":"docbook/, tools/openapi, tools/bruno, tools/scalar, package.json","tech":"DocBook/Publican (Dockerfile in docbook/), Node scripts","description":"Builds the Admin and Developers guides and validates/generates REST API collections and docs."},{"name":"Release build","kind":"build tooling","path":"build/","tech":"Python and shell","description":"buildrelease*.py produce release tarballs; ci_install_mantis.sh and ci_post_install.sh install and seed MantisBT in CI."},{"name":"Mail server","kind":"external service","path":"core/email_api.php, core/classes/EmailSenderPhpMailer.class.php","tech":"PHPMailer (mail, SMTP, sendmail)","description":"Sends notifications; target server is configured per installation."},{"name":"LDAP directory","kind":"external service","path":"core/ldap_api.php","tech":"PHP ldap extension","description":"Optional authentication backend."}],"mermaid":"flowchart LR\n  browser[\"Browser user\"] --> web[\"Web UI pages (root *.php)\"]\n  client[\"API client\"] --> rest[\"REST API (api/rest, Slim)\"]\n  client --> soap[\"SOAP API (api/soap)\"]\n  admin[\"Admin / inst
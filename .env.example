# Settings for the local development scripts (build/local_instance.sh,
# compose.yaml). Copy to .env to override the defaults below.
#
# MantisBT itself does not read environment variables for its settings:
# application settings live in config/config_inc.php (written by the
# installer, gitignored). See config/config_inc.php.sample for the list
# (database, crypto_master_salt, SMTP, email addresses).
#
# The only environment variable read by the application code is
# MANTIS_CONFIG_FOLDER (config_defaults_inc.php): an optional path to an
# alternative config folder, with a trailing slash.
# MANTIS_CONFIG_FOLDER=

# Host for the PHP built-in web server. Also used as the database host by the
# installer, so keep it 127.0.0.1 when the database runs in compose.yaml.
MANTIS_HOST=127.0.0.1

# Port for the PHP built-in web server (CI uses 8080).
PORT=8989

# ADOdb driver: mysqli (default, compose service "mysql")
# or pgsql (compose service "pgsql", profile "pgsql").
DB_TYPE=mysqli

# Database credentials. They match compose.yaml and the CI workflow.
# Local use only. The installer also creates the MantisBT administrator
# account with this user name and password.
DB_NAME=bugtracker
DB_USER=root
DB_PASSWORD=root
